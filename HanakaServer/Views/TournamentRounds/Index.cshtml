@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Vòng đấu";
    var tid = (long)(ViewBag.TournamentId ?? 0L);
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var bracketUrl = Url.Action("Index", "TournamentAdminBracket", new { tournamentId = tid, returnUrl = currentUrl })
        ?? $"/TournamentAdminBracket/Index?tournamentId={tid}";
}

<style>
    .round-page-title-bar {
        gap: 12px;
    }

    .round-page-toolbar {
        gap: 8px;
    }

    .round-list-card .card-body {
        padding: 1.5rem;
    }

    .round-list-table {
        min-width: 980px;
        margin-bottom: 0;
        table-layout: fixed;
    }

        .round-list-table thead th {
            padding: 1rem .9rem;
            background: #fff;
            color: #7f8599;
            font-weight: 700;
            vertical-align: middle;
        }

        .round-list-table tbody td {
            padding: .95rem .9rem;
            color: #778096;
            vertical-align: middle;
        }

    .round-key {
        color: #7b8398;
        font-weight: 700;
    }

    .round-name {
        color: #758096;
        font-weight: 500;
    }

    .round-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 46px;
        height: 32px;
        padding: 0 .75rem;
        border: 1px solid #bfe9f2;
        border-radius: 6px;
        background: #eefbfe;
        color: #1aa9bd;
        font-weight: 800;
        line-height: 1;
    }

    button.round-count-badge {
        cursor: pointer;
    }

        button.round-count-badge:hover {
            border-color: #36b9cc;
            color: #138496;
        }

    .round-actions {
        display: flex;
        flex-wrap: nowrap;
        gap: 6px;
    }

    .round-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 4px;
    }

    .round-delete-modal .modal-header {
        border-bottom: 0;
        padding-bottom: .5rem;
    }

    .round-delete-summary {
        display: grid;
        gap: .65rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 1rem 0;
    }

    .round-delete-stat {
        border: 1px solid #e3e6f0;
        border-radius: .45rem;
        padding: .75rem;
        text-align: center;
    }

        .round-delete-stat strong,
        .round-delete-stat span {
            display: block;
        }

        .round-delete-stat strong {
            color: #be2617;
            font-size: 1.15rem;
        }

        .round-delete-stat span {
            color: #858796;
            font-size: .72rem;
            margin-top: .15rem;
        }

    .round-delete-confirmation {
        border: 1px solid #f3c2bd;
        border-radius: .45rem;
        background: #fff8f7;
        padding: .9rem;
    }

    .round-delete-confirmation code {
        color: #be2617;
        font-weight: 800;
    }

    .match-schedule-modal .modal-dialog {
        max-width: 1180px;
    }

    .match-schedule-modal .modal-content {
        min-height: min(760px, calc(100vh - 3.5rem));
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(28, 35, 55, .28);
    }

    .match-schedule-modal .modal-header {
        align-items: flex-start;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid #e3e6f0;
        background: #fff;
    }

    .match-schedule-modal .modal-title {
        color: #3a3b45;
        font-weight: 800;
    }

    .match-schedule-subtitle {
        margin-top: .2rem;
        color: #6e7891;
        font-size: .82rem;
        line-height: 1.45;
    }

    .match-schedule-mode-switch {
        display: inline-flex;
        gap: .25rem;
        margin-top: .75rem;
        padding: .22rem;
        border: 1px solid #dfe3ec;
        border-radius: 10px;
        background: #f8f9fc;
    }

    .match-schedule-mode-switch .btn {
        min-height: 44px;
        padding: .45rem .8rem;
        border: 0;
        border-radius: 8px;
        color: #6e7891;
        font-size: .76rem;
        font-weight: 800;
        box-shadow: none;
    }

    .match-schedule-mode-switch .btn.is-active {
        background: #4e73df;
        color: #fff;
        box-shadow: 0 3px 9px rgba(78, 115, 223, .2);
    }

    .match-schedule-loading,
    .match-schedule-empty {
        display: flex;
        min-height: 520px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .65rem;
        padding: 2rem;
        color: #6e7891;
        text-align: center;
    }

    .match-schedule-loading i,
    .match-schedule-empty i {
        font-size: 1.8rem;
        color: #36b9cc;
    }

    .match-schedule-workspace {
        display: grid;
        grid-template-columns: minmax(310px, 360px) minmax(0, 1fr);
        min-height: 620px;
    }

    .match-schedule-sidebar {
        min-width: 0;
        border-right: 1px solid #e3e6f0;
        background: #f8f9fc;
    }

    .match-schedule-sidebar-head {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 1rem;
        border-bottom: 1px solid #e3e6f0;
        background: #f8f9fc;
    }

    .match-schedule-search {
        position: relative;
    }

    .match-schedule-search i {
        position: absolute;
        top: 50%;
        left: .85rem;
        color: #858796;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .match-schedule-search .form-control {
        min-height: 44px;
        padding-left: 2.4rem;
        border-radius: 10px;
        font-size: .9rem;
    }

    .match-schedule-list-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-top: .65rem;
        color: #6e7891;
        font-size: .75rem;
        font-weight: 700;
    }

    .match-schedule-bulk-selection {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: center;
        gap: .4rem;
        margin-top: .7rem;
        padding-top: .7rem;
        border-top: 1px solid #e3e6f0;
    }

    .match-schedule-bulk-selection strong {
        color: #4e73df;
        font-size: .75rem;
    }

    .match-schedule-bulk-selection .btn {
        min-height: 44px;
        padding: .35rem .55rem;
        border-radius: 8px;
        font-size: .7rem;
        font-weight: 800;
    }

    .match-schedule-list {
        display: grid;
        gap: .6rem;
        max-height: 548px;
        padding: .8rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .match-schedule-item {
        width: 100%;
        padding: .8rem;
        border: 1px solid #dfe3ec;
        border-radius: 12px;
        background: #fff;
        color: #5a5c69;
        text-align: left;
        transition: border-color .16s ease, box-shadow .16s ease, background-color .16s ease;
    }

    .match-schedule-item:hover,
    .match-schedule-item:focus {
        border-color: #8ed9e4;
        outline: 0;
        box-shadow: 0 0 0 3px rgba(54, 185, 204, .13);
    }

    .match-schedule-item.is-active {
        border-color: #36b9cc;
        background: #f0fcfe;
        box-shadow: 0 0 0 3px rgba(54, 185, 204, .12);
    }

    .match-schedule-item.is-bulk-selected {
        border-color: #4e73df;
        background: #f3f6ff;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, .11);
    }

    .match-schedule-bulk-check {
        display: inline-flex;
        width: 22px;
        height: 22px;
        flex: 0 0 22px;
        align-items: center;
        justify-content: center;
        margin-right: .4rem;
        border: 2px solid #b7b9cc;
        border-radius: 6px;
        background: #fff;
        color: transparent;
        font-size: .68rem;
    }

    .match-schedule-item.is-bulk-selected .match-schedule-bulk-check {
        border-color: #4e73df;
        background: #4e73df;
        color: #fff;
    }

    .match-schedule-list-empty {
        display: flex;
        min-height: 180px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: 1rem;
        color: #858796;
        text-align: center;
    }

    .match-schedule-list-empty i {
        margin-bottom: .2rem;
        color: #b7b9cc;
        font-size: 1.35rem;
    }

    .match-schedule-list-empty span {
        font-size: .76rem;
        line-height: 1.45;
    }

    .match-schedule-item-top,
    .match-schedule-item-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .65rem;
    }

    .match-schedule-item-id {
        color: #4e73df;
        font-size: .76rem;
        font-weight: 900;
    }

    .match-schedule-item-round {
        color: #858796;
        font-size: .7rem;
        font-weight: 700;
    }

    .match-schedule-item-teams {
        margin: .45rem 0;
        color: #3a3b45;
        font-size: .82rem;
        font-weight: 800;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .match-schedule-item-line {
        align-items: flex-start;
        justify-content: flex-start;
        color: #6e7891;
        font-size: .72rem;
        line-height: 1.4;
    }

    .match-schedule-item-line + .match-schedule-item-line {
        margin-top: .22rem;
    }

    .match-schedule-item-line i {
        width: 14px;
        margin-top: .15rem;
        color: #36b9cc;
        text-align: center;
    }

    .match-schedule-editor {
        min-width: 0;
        padding: 1.25rem;
        background: #fff;
    }

    .match-schedule-no-selection {
        display: flex;
        min-height: 520px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .55rem;
        color: #858796;
        text-align: center;
    }

    .match-schedule-no-selection i {
        font-size: 2rem;
        color: #b7b9cc;
    }

    .match-schedule-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1rem;
        margin-bottom: 1rem;
        padding: 1rem;
        border: 1px solid #d9eaf0;
        border-radius: 12px;
        background: #f5fcfd;
    }

    .match-schedule-summary-kicker {
        color: #138496;
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .match-schedule-summary h6 {
        margin: .3rem 0 .2rem;
        color: #3a3b45;
        font-weight: 900;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .match-schedule-summary small {
        color: #6e7891;
        line-height: 1.45;
    }

    .match-schedule-score {
        align-self: center;
        min-width: 84px;
        padding: .55rem .7rem;
        border-radius: 10px;
        background: #3a3b45;
        color: #fff;
        font-size: 1.3rem;
        font-weight: 900;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .match-schedule-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .match-schedule-form .form-group {
        margin-bottom: 1rem;
    }

    .match-schedule-form label {
        color: #4d5568;
        font-size: .78rem;
        font-weight: 800;
    }

    .match-schedule-form .form-control {
        min-height: 46px;
        border-color: #d6dae4;
        border-radius: 9px;
        color: #3a3b45;
        font-size: .92rem;
    }

    .match-schedule-form textarea.form-control {
        min-height: 86px;
        resize: vertical;
    }

    .match-schedule-referee-note {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        margin-top: .5rem;
        color: #6e7891;
        font-size: .75rem;
        line-height: 1.45;
    }

    .match-schedule-referee-note i {
        margin-top: .15rem;
        color: #36b9cc;
    }

    .match-schedule-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .65rem;
        margin-top: .25rem;
        padding-top: 1rem;
        border-top: 1px solid #eaecf4;
    }

    .match-schedule-form-actions .btn {
        min-height: 44px;
        min-width: 112px;
        border-radius: 9px;
        font-weight: 800;
    }

    .match-schedule-status {
        flex: 1 1 auto;
        min-width: 0;
        color: #1c7c54;
        font-size: .78rem;
        font-weight: 800;
        line-height: 1.4;
    }

    .match-schedule-bulk-form {
        max-width: 760px;
        margin: 0 auto;
    }

    .match-schedule-bulk-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        padding: 1rem;
        border: 1px solid #d9e4ff;
        border-radius: 12px;
        background: #f5f7ff;
    }

    .match-schedule-bulk-summary strong {
        display: block;
        color: #3a3b45;
        font-size: .95rem;
    }

    .match-schedule-bulk-summary span {
        display: block;
        margin-top: .25rem;
        color: #6e7891;
        font-size: .75rem;
        line-height: 1.4;
    }

    .match-schedule-bulk-summary .btn {
        min-height: 44px;
        flex: 0 0 auto;
        border-radius: 9px;
        font-size: .75rem;
        font-weight: 800;
    }

    .match-schedule-bulk-all {
        margin-bottom: .75rem;
        padding: .75rem .85rem;
        border: 1px dashed #9db3f2;
        border-radius: 10px;
        background: #f8faff;
    }

    .match-schedule-bulk-field {
        margin-bottom: .65rem;
        padding: .8rem;
        border: 1px solid #e1e4ec;
        border-radius: 11px;
        background: #fafbfe;
        transition: border-color .16s ease, background-color .16s ease;
    }

    .match-schedule-bulk-field.is-enabled {
        border-color: #a9baed;
        background: #fff;
    }

    .match-schedule-bulk-field-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .65rem;
    }

    .match-schedule-bulk-field-head strong {
        color: #4d5568;
        font-size: .8rem;
    }

    .match-schedule-bulk-field .form-control {
        min-height: 44px;
        border-radius: 8px;
    }

    .match-schedule-bulk-field textarea.form-control {
        min-height: 72px;
        resize: vertical;
    }

    .match-schedule-bulk-field-help {
        display: block;
        margin-top: .4rem;
        color: #858796;
        font-size: .7rem;
        line-height: 1.4;
    }

    .match-schedule-bulk-confirm {
        margin: 1rem 0;
        padding: .8rem .9rem .8rem 2.35rem;
        border: 1px solid #f0d89b;
        border-radius: 10px;
        background: #fffaf0;
    }

    .match-schedule-bulk-confirm label {
        color: #66501d;
        font-size: .76rem;
        font-weight: 800;
        line-height: 1.45;
    }

    .match-schedule-bulk-field-head .custom-control,
    .match-schedule-bulk-all.custom-control,
    .match-schedule-bulk-confirm.custom-control {
        display: flex;
        min-height: 44px;
        align-items: center;
    }

    .match-schedule-bulk-field-head .custom-control-label::before,
    .match-schedule-bulk-field-head .custom-control-label::after,
    .match-schedule-bulk-all .custom-control-label::before,
    .match-schedule-bulk-all .custom-control-label::after,
    .match-schedule-bulk-confirm .custom-control-label::before,
    .match-schedule-bulk-confirm .custom-control-label::after {
        top: 50%;
        transform: translateY(-50%);
    }

    .match-schedule-modal :focus-visible {
        outline: 3px solid rgba(54, 185, 204, .28);
        outline-offset: 2px;
    }

    @@media (max-width: 991.98px) {
        .match-schedule-modal .modal-dialog {
            max-width: calc(100% - 1.5rem);
        }

        .match-schedule-workspace {
            grid-template-columns: minmax(0, 1fr);
        }

        .match-schedule-sidebar {
            border-right: 0;
            border-bottom: 1px solid #e3e6f0;
        }

        .match-schedule-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            max-height: 280px;
        }

        .match-schedule-no-selection {
            min-height: 320px;
        }
    }

    @@media (max-width: 575.98px) {
        .match-schedule-modal .modal-dialog {
            width: 100%;
            max-width: none;
            min-height: 100dvh;
            margin: 0;
        }

        .match-schedule-modal .modal-content {
            min-height: 100dvh;
            border-radius: 0;
        }

        .match-schedule-modal .modal-header,
        .match-schedule-editor {
            padding: 1rem;
        }

        .match-schedule-loading,
        .match-schedule-empty {
            min-height: 70dvh;
        }

        .match-schedule-list {
            grid-template-columns: minmax(0, 1fr);
            max-height: 250px;
        }

        .match-schedule-form-grid,
        .match-schedule-summary {
            grid-template-columns: minmax(0, 1fr);
        }

        .match-schedule-score {
            justify-self: start;
        }

        .match-schedule-form-actions {
            flex-wrap: wrap;
        }

        .match-schedule-status {
            flex-basis: 100%;
        }

        .match-schedule-form-actions .btn {
            flex: 1 1 calc(50% - .4rem);
        }

        .match-schedule-mode-switch {
            display: flex;
            width: 100%;
        }

        .match-schedule-mode-switch .btn {
            min-height: 44px;
            flex: 1 1 0;
        }

        .match-schedule-bulk-selection {
            grid-template-columns: 1fr 1fr;
        }

        .match-schedule-bulk-selection strong {
            grid-column: 1 / -1;
        }

        .match-schedule-bulk-summary {
            align-items: stretch;
            flex-direction: column;
        }

        .match-schedule-bulk-summary .btn {
            width: 100%;
        }

        .round-delete-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .round-page-title-bar > div:last-child {
            width: 100%;
        }

        .round-page-toolbar {
            display: flex;
            flex-wrap: wrap;
            width: 100%;
        }

            .round-page-toolbar > * {
                flex: 1 1 calc(50% - 4px);
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .match-schedule-modal *,
        .match-schedule-modal *::before,
        .match-schedule-modal *::after {
            transition-duration: .01ms !important;
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>

<div class="container-fluid" id="pageRoot" data-tournament-id="@tid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3 round-page-title-bar">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Vòng đấu</h1>
            <div class="small text-muted">
                @ViewBag.TournamentTitle • @ViewBag.TournamentStatus • Loại thi đấu: @ViewBag.TournamentGameType • #@tid
            </div>
        </div>

        <div class="d-flex flex-wrap round-page-toolbar">
            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "TournamentCoordinators", new { tournamentId = tid })">Phân công điều phối</a>
            <button class="btn btn-sm btn-primary shadow-sm" type="button" id="btnOpenCreate">
                <i class="fas fa-plus fa-sm text-white-50"></i> Tạo vòng đấu
            </button>
            <button class="btn btn-sm btn-outline-primary" type="button" id="btnOpenMatchSchedule">
                <i class="fas fa-calendar-alt"></i> Lịch đấu &amp; trọng tài
            </button>
            <a class="btn btn-sm btn-outline-info" href="@bracketUrl">
                <i class="fas fa-sitemap"></i> Xem sơ đồ
            </a>
            <a class="btn btn-sm btn-outline-secondary" href="/Home/Tournaments">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card shadow mb-4 round-list-card">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách vòng đấu</h6>
        </div>

        <div class="card-body">
            <div id="errBox" class="alert alert-danger d-none"></div>
            <div id="okBox" class="alert alert-success d-none"></div>

            <div class="table-responsive">
                <table class="table table-bordered round-list-table" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:120px">Mã vòng</th>
                            <th>Tên vòng</th>
                            <th style="width:130px">Số lượng bảng</th>
                            <th style="width:110px">Thứ tự sắp xếp</th>
                            <th style="width:160px">Ngày tạo</th>
                            <th style="width:140px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="body">
                        <tr><td colspan="6" class="text-center text-muted">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo/Sửa -->
<div class="modal fade" id="modalRound" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="formRound">
                <input type="hidden" id="mode" value="create" />
                <input type="hidden" id="editingId" value="" />

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Tạo vòng đấu</h5>
                    <button class="close" type="button" data-dismiss="modal"><span aria-hidden="true">×</span></button>
                </div>

                <div class="modal-body">
                    <div id="formErr" class="alert alert-danger d-none"></div>

                    <div class="form-group">
                        <label>Mã vòng *</label>
                        <input id="roundKey" class="form-control" placeholder="R1" required />
