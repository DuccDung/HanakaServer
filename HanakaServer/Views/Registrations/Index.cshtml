              </div>
            `;
          }

          function normalizePaymentCode(value){
            return String(value || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
          }

          function sendPaymentRealtime(payload){
            if(!PAYMENT_RT.ws || PAYMENT_RT.ws.readyState !== WebSocket.OPEN){
              connectPaymentRealtime();
              return false;
            }

            try{
              PAYMENT_RT.ws.send(JSON.stringify(payload));
              return true;
            } catch(_error){
              return false;
            }
          }

          function flushPaymentSubscriptions(){
            Object.keys(PAYMENT_RT.payments).forEach(function(code){
              if(!PAYMENT_RT.payments[code]) return;
              sendPaymentRealtime({ type: "payment.subscribe", transactionCode: code });
            });
          }

          function connectPaymentRealtime(){
            if(!("WebSocket" in window)) return false;
            if(PAYMENT_RT.ws && (
              PAYMENT_RT.ws.readyState === WebSocket.OPEN ||
              PAYMENT_RT.ws.readyState === WebSocket.CONNECTING
            )){
              return true;
            }

            const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
            PAYMENT_RT.manualClose = false;

            try{
              PAYMENT_RT.ws = new WebSocket(`${protocol}//${window.location.host}/ws-public`);
            } catch(_error){
              return false;
            }

            PAYMENT_RT.ws.addEventListener("open", function(){
              flushPaymentSubscriptions();
              window.clearInterval(PAYMENT_RT.pingTimer);
              PAYMENT_RT.pingTimer = window.setInterval(function(){
                sendPaymentRealtime({ type: "ping" });
              }, 25000);
            });

            PAYMENT_RT.ws.addEventListener("message", function(event){
              try{
                const message = JSON.parse(event.data);
                if(String(message?.type || "") === "tournament.payment.status.updated"){
                  handlePaymentStatusUpdated(message.payload || {}, "realtime");
                }
              } catch(_error){
              }
            });

            PAYMENT_RT.ws.addEventListener("close", function(){
              window.clearInterval(PAYMENT_RT.pingTimer);
              PAYMENT_RT.ws = null;

              if(!PAYMENT_RT.manualClose && Object.keys(PAYMENT_RT.payments).length){
                window.clearTimeout(PAYMENT_RT.reconnectTimer);
                PAYMENT_RT.reconnectTimer = window.setTimeout(connectPaymentRealtime, 2500);
              }
            });

            return true;
          }

          function subscribePaymentRealtime(transactionCode){
            const code = normalizePaymentCode(transactionCode);
            if(!code) return false;

            PAYMENT_RT.payments[code] = true;
            connectPaymentRealtime();
            return sendPaymentRealtime({ type: "payment.subscribe", transactionCode: code });
          }

          function unsubscribePaymentRealtime(transactionCode){
            const code = normalizePaymentCode(transactionCode);
            if(!code) return false;

            delete PAYMENT_RT.payments[code];
            return sendPaymentRealtime({ type: "payment.unsubscribe", transactionCode: code });
          }

          function cleanupActivePayment(){
            if(ACTIVE_PAYMENT.pollTimer){
              window.clearInterval(ACTIVE_PAYMENT.pollTimer);
              ACTIVE_PAYMENT.pollTimer = null;
            }

            if(ACTIVE_PAYMENT.transactionCode){
              unsubscribePaymentRealtime(ACTIVE_PAYMENT.transactionCode);
            }

            ACTIVE_PAYMENT = {
              registrationId: 0,
              regCode: "",
              teamName: "",
              amountText: "",
              transactionCode: "",
              pollUrl: "",
              paid: false,
              pollTimer: null
            };
          }

          function setPaymentModalLoading(){
            const body = $id("paymentInfoBody");
            if(body){
              body.innerHTML = `
                <div class="text-center text-muted py-4">
                  <i class="fas fa-spinner fa-spin"></i> Đang tải...
                </div>
              `;
            }
          }

          function renderPaymentInfo(data){
            const payment = data?.payment || {};
            const record = data?.paymentRecord || {};
            const manual = data?.manualPayment || {};
            const tournament = data?.tournament || {};
            const team = data?.team || {};
            const isPaid = !!data?.isPaid;

            const transactionCode = payment.transactionCode || record.transactionCode || "";
            const isCashPayment = !!data?.isCashPayment || !!record.isCashPayment || normalizePaymentCode(transactionCode).startsWith("MANUAL");
            const transferContent = payment.transferContent || record.transferContent || transactionCode;
            const amountText = isPaid
              ? (record.paidAmountText || manual.paidAmountText || payment.amountText || record.amountText || tournament.feeText)
              : (payment.amountText || record.amountText || tournament.feeText);
            const statusTitle = isCashPayment ? "Đã thanh toán tiền mặt" : (payment.statusTitle || manual.statusTitle || record.status || (isPaid ? "Đã thanh toán" : "Chưa thanh toán"));
            const statusDesc = isCashPayment ? "Admin đã xác nhận khách thanh toán trực tiếp bằng tiền mặt." : (payment.statusDescription || (isPaid ? "Thông tin thanh toán của khách." : "Chuyển khoản đúng số tiền và nội dung để hệ thống tự xác nhận."));
            const alertClass = isPaid ? "alert-success" : "alert-warning";

            const qrUrl = payment.qrImageUrl || record.qrImageUrl || "";
            const paidAtText = payment.paidAtText || record.paidAtText || manual.paidAtText;
            const teamDetailRows = team.isRelay
              ? (team.members || []).map(member =>
                  paymentInfoRow(`Cặp ${member.pairNumber} · VĐV ${member.position}`, member.displayName, false)
                ).join("")
              : [
                  paymentInfoRow("Điểm đội", team.points !== undefined ? Number(team.points || 0).toFixed(2) : "", false),
                  paymentInfoRow("VĐV 1", team.player1Name, false),
                  paymentInfoRow("VĐV 2", team.player2Name, false)
                ].join("");

            const paymentRows = isPaid
              ? (isCashPayment ? [
                  paymentInfoRow("Phương thức", "Tiền mặt", true),
                  paymentInfoRow("Số tiền khách thanh toán", amountText, true),
                  paymentInfoRow("Thời gian xác nhận", paidAtText, false),
                  paymentInfoRow("Mã xác nhận", transactionCode, false)
                ] : [
                  paymentInfoRow("Số tiền khách thanh toán", amountText, true),
                  paymentInfoRow("Thời gian thanh toán", paidAtText, false),
                  paymentInfoRow("Mã Sepay", transactionCode, true),
                  paymentInfoRow("Mã giao dịch ngân hàng", record.providerTransactionId, false),
                  paymentInfoRow("Ngân hàng", payment.receiverBankShortName || record.bankCode, false),
                  paymentInfoRow("Tài khoản nhận", payment.receiverAccountNumber || record.bankAccountNo, false)
                ]).join("")
              : [
                  paymentInfoRow("Số tiền cần thanh toán", amountText, true),
                  paymentInfoRow("Mã Sepay", transactionCode, true),
                  paymentInfoRow("Nội dung chuyển khoản", transferContent, true),
                  paymentInfoRow("Ngân hàng", payment.receiverBankShortName || record.bankCode, false),
                  paymentInfoRow("Số tài khoản", payment.receiverAccountNumber || record.bankAccountNo, true),
                  paymentInfoRow("Chủ tài khoản", payment.receiverAccountName || record.bankAccountName, false),
                  paymentInfoRow("Hết hạn", payment.expiresAt ? new Date(payment.expiresAt).toLocaleString("vi-VN") : record.expiredAtText, false)
                ].join("");

            return `
              <div class="alert ${alertClass}">
                <div class="font-weight-bold">${esc(statusTitle)}</div>
                <div>${esc(statusDesc)}</div>
              </div>

              <div class="payment-info-grid mb-3">
                ${paymentInfoRow("Giải đấu", tournament.title, false)}
                ${paymentInfoRow("Mã đăng ký", data?.regCode, true)}
                ${paymentInfoRow("Đội đấu", team.name, true)}
                ${teamDetailRows}
              </div>

              ${!isPaid ? paymentQrHtml(qrUrl) : ""}

              <div class="payment-info-grid">
                ${paymentRows}
              </div>

              ${cashConfirmHtml(data)}
              ${cancelPaymentConfirmationHtml(data)}
            `;
          }

          function updateActivePaymentFromData(data){
            const payment = data?.payment || {};
            const record = data?.paymentRecord || {};
            const tournament = data?.tournament || {};
            const transactionCode = payment.transactionCode || record.transactionCode || "";
            const pollUrl = payment.pollStatusUrl || (transactionCode ? `/api/tournament-registration-payments/${encodeURIComponent(transactionCode)}/status` : "");

            ACTIVE_PAYMENT.registrationId = Number(data?.registrationId || ACTIVE_PAYMENT.registrationId || 0);
            ACTIVE_PAYMENT.regCode = String(data?.regCode || ACTIVE_PAYMENT.regCode || "");
            ACTIVE_PAYMENT.teamName = String(data?.team?.name || ACTIVE_PAYMENT.teamName || "");
            ACTIVE_PAYMENT.amountText = String(payment.amountText || record.amountText || tournament.feeText || ACTIVE_PAYMENT.amountText || "");
            ACTIVE_PAYMENT.transactionCode = normalizePaymentCode(transactionCode);
            ACTIVE_PAYMENT.pollUrl = pollUrl;
            ACTIVE_PAYMENT.paid = !!data?.isPaid || !!payment.isPaid;
          }

          function startActivePaymentWatch(data){
            cleanupActivePayment();
            updateActivePaymentFromData(data);

            if(!ACTIVE_PAYMENT.transactionCode || ACTIVE_PAYMENT.paid){
              return;
            }

            subscribePaymentRealtime(ACTIVE_PAYMENT.transactionCode);

            if(ACTIVE_PAYMENT.pollUrl){
              ACTIVE_PAYMENT.pollTimer = window.setInterval(function(){
                pollActivePaymentStatus("poll");
              }, 3000);

              window.setTimeout(function(){
                pollActivePaymentStatus("initial");
              }, 900);
            }
          }

          async function pollActivePaymentStatus(source){
            if(!ACTIVE_PAYMENT.pollUrl || ACTIVE_PAYMENT.paid){
              return;
            }

            try{
              const res = await axios.get(ACTIVE_PAYMENT.pollUrl, {
                hanakaLoading: "silent"
              });
              handlePaymentStatusUpdated(res.data || {}, source || "poll");
            } catch(_error){
            }
          }

          async function refreshPaymentModalAsPaid(status){
            ACTIVE_PAYMENT.paid = true;
            if(ACTIVE_PAYMENT.pollTimer){
              window.clearInterval(ACTIVE_PAYMENT.pollTimer);
              ACTIVE_PAYMENT.pollTimer = null;
            }

            const id = ACTIVE_PAYMENT.registrationId;
            if(!id){
              return;
            }

            try{
              const res = await axios.post(`/api/admin/registrations/${id}/payment-info`, undefined, {
                hanakaLoading: "silent"
              });
              const data = res.data || {};
              updateActivePaymentFromData(data);

              const title = $id("paymentInfoTitle");
              const body = $id("paymentInfoBody");
              if(title){
                title.textContent = `Thanh toán thành công - ${data.regCode || ""}`;
              }
              if(body){
                body.innerHTML = `
                  <div class="alert alert-success">
                    <div class="font-weight-bold">Đã ghi nhận thanh toán thành công</div>
                    <div>Webhook Sepay đã xác nhận giao dịch cho đội này.</div>
                  </div>
                  ${renderPaymentInfo(data)}
                `;
              }

              await load(CURRENT_TAB);
            } catch(_error){
              const body = $id("paymentInfoBody");
              if(body){
                body.insertAdjacentHTML("afterbegin", `
                  <div class="alert alert-success">
                    <div class="font-weight-bold">Đã ghi nhận thanh toán thành công</div>
                    <div>${esc(status?.paidAtText || "")}</div>
                  </div>
                `);
              }
              await load(CURRENT_TAB);
            }
          }

          function handlePaymentStatusUpdated(status, source){
            const activeCode = normalizePaymentCode(ACTIVE_PAYMENT.transactionCode);
            const nextCode = normalizePaymentCode(status?.transactionCode);
            if(activeCode && nextCode && activeCode !== nextCode){
              return;
            }

            if(!status?.isPaid || ACTIVE_PAYMENT.paid){
              return;
            }

            refreshPaymentModalAsPaid(status);
          }

          function setCashPaymentConfirmationSubmitting(submitting){
            CASH_PAYMENT_CONFIRMATION.submitting = !!submitting;

            document.querySelectorAll("[data-cash-payment-modal-close]").forEach(function(button){
              button.disabled = !!submitting;
            });

            const confirmButton = $id("btnConfirmCashPayment");
            if(confirmButton){
              confirmButton.disabled = !!submitting;
              confirmButton.innerHTML = submitting
                ? `<i class="fas fa-spinner fa-spin mr-1" aria-hidden="true"></i>Đang xác nhận...`
                : `<i class="fas fa-check mr-1" aria-hidden="true"></i>Xác nhận đã thu tiền`;
            }
          }

          function resetCashPaymentConfirmation(){
            CASH_PAYMENT_CONFIRMATION = { registrationId: 0, submitting: false };
            setCashPaymentConfirmationSubmitting(false);

            const errorBox = $id("cashPaymentConfirmationError");
            if(errorBox){
              errorBox.textContent = "";
              errorBox.classList.add("d-none");
            }
          }

          function openCashPaymentConfirmation(id){
            const registrationId = Number(id || ACTIVE_PAYMENT.registrationId || 0);
            if(!registrationId){
              showRegistrationNotice("danger", "Không thể mở xác nhận", "Không xác định được đăng ký cần xác nhận thanh toán.");
              return;
            }

            CASH_PAYMENT_CONFIRMATION = { registrationId, submitting: false };

            const regCode = $id("cashPaymentRegCode");
            const teamName = $id("cashPaymentTeamName");
            const amount = $id("cashPaymentAmount");
            const errorBox = $id("cashPaymentConfirmationError");
            if(regCode) regCode.textContent = ACTIVE_PAYMENT.regCode || `#${registrationId}`;
            if(teamName) teamName.textContent = ACTIVE_PAYMENT.teamName || "—";
            if(amount) amount.textContent = ACTIVE_PAYMENT.amountText || "—";
            if(errorBox){
              errorBox.textContent = "";
              errorBox.classList.add("d-none");
            }
            setCashPaymentConfirmationSubmitting(false);

            $("#modalCashPaymentConfirmation").modal("show");
          }

          async function confirmCashPayment(){
            const registrationId = Number(CASH_PAYMENT_CONFIRMATION.registrationId || 0);
            const errorBox = $id("cashPaymentConfirmationError");
            if(!registrationId || CASH_PAYMENT_CONFIRMATION.submitting){
              if(!registrationId && errorBox){
                errorBox.textContent = "Không xác định được đăng ký cần xác nhận thanh toán.";
                errorBox.classList.remove("d-none");
              }
              return;
            }

            if(errorBox){
              errorBox.textContent = "";
              errorBox.classList.add("d-none");
            }
            setCashPaymentConfirmationSubmitting(true);

            try{
              await axios.post(`/api/admin/registrations/${registrationId}/confirm-cash-payment`);

              setCashPaymentConfirmationSubmitting(false);
              $("#modalCashPaymentConfirmation").modal("hide");
              cleanupActivePayment();
              ACTIVE_PAYMENT.registrationId = registrationId;
              await refreshPaymentModalAsPaid({ isPaid: true });
            } catch(err){
              const msg = err?.response?.data?.detail || err?.response?.data?.message || err?.message || "Không thể xác nhận thanh toán tiền mặt.";
              if(errorBox){
                errorBox.textContent = msg;
                errorBox.classList.remove("d-none");
              }
              setCashPaymentConfirmationSubmitting(false);
            }
          }

          function openCancelPaymentConfirmation(id){
            const registrationId = Number(id || ACTIVE_PAYMENT.registrationId || 0);
            if(!registrationId){
              alert("Không xác định được đăng ký cần hủy xác nhận thanh toán.");
              return;
            }

            ACTIVE_PAYMENT.registrationId = registrationId;

            const regCode = $id("cancelPaymentRegCode");
            const teamName = $id("cancelPaymentTeamName");
            const errorBox = $id("cancelPaymentError");
            const button = $id("btnConfirmCancelPayment");

            if(regCode) regCode.textContent = ACTIVE_PAYMENT.regCode || "—";
            if(teamName) teamName.textContent = ACTIVE_PAYMENT.teamName || "—";
            if(errorBox){
              errorBox.textContent = "";
              errorBox.classList.add("d-none");
            }
            if(button){
              button.disabled = false;
              button.innerHTML = `<i class="fas fa-undo-alt mr-1"></i>Xác nhận hủy`;
            }

            $("#modalCancelPaymentConfirmation").modal("show");
          }

          async function confirmCancelPayment(){
            const registrationId = Number(ACTIVE_PAYMENT.registrationId || 0);
            const errorBox = $id("cancelPaymentError");
            const button = $id("btnConfirmCancelPayment");

            if(!registrationId){
              if(errorBox){
                errorBox.textContent = "Không xác định được đăng ký cần hủy xác nhận thanh toán.";
                errorBox.classList.remove("d-none");
              }
              return;
            }

            if(button){
              button.disabled = true;
              button.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i>Đang hủy...`;
            }

            let cancelResult;
            try{
              const response = await axios.post(`/api/admin/registrations/${registrationId}/cancel-payment-confirmation`);
              cancelResult = response.data || {};
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể hủy xác nhận thanh toán.";
              if(errorBox){
                errorBox.textContent = msg;
                errorBox.classList.remove("d-none");
              }
              if(button){
                button.disabled = false;
                button.innerHTML = `<i class="fas fa-undo-alt mr-1"></i>Xác nhận hủy`;
              }
              return;
            }

            $("#modalCancelPaymentConfirmation").modal("hide");
            cleanupActivePayment();

            const title = $id("paymentInfoTitle");
            const body = $id("paymentInfoBody");
            try{
              const response = await axios.post(`/api/admin/registrations/${registrationId}/payment-info`);
              const data = response.data || {};

              if(title) title.textContent = `Mã Sepay - ${data.regCode || ""}`;
              if(body){
                body.innerHTML = `
                  <div class="alert alert-success">
                    <div class="font-weight-bold">${esc(cancelResult?.message || "Đã hủy xác nhận thanh toán.")}</div>
                    <div>Đăng ký đã được chuyển về trạng thái chưa thanh toán.</div>
                  </div>
                  ${renderPaymentInfo(data)}
                `;
              }
              startActivePaymentWatch(data);
            } catch(_error){
              if(title) title.textContent = "Đã hủy xác nhận thanh toán";
              if(body){
                body.innerHTML = `
                  <div class="alert alert-success mb-0">
                    <div class="font-weight-bold">Đã hủy xác nhận thanh toán.</div>
                    <div>Đăng ký đã được chuyển về trạng thái chưa thanh toán.</div>
                  </div>
                `;
              }
            }

            await load(CURRENT_TAB);

            if(button){
              button.disabled = false;
              button.innerHTML = `<i class="fas fa-undo-alt mr-1"></i>Xác nhận hủy`;
            }
          }

          async function openPaymentInfo(id){
            const title = $id("paymentInfoTitle");
            const body = $id("paymentInfoBody");

            cleanupActivePayment();

            if(title) title.textContent = "Thông tin thanh toán";
            setPaymentModalLoading();

            $("#modalPaymentInfo").modal("show");

            try{
              const res = await axios.post(`/api/admin/registrations/${id}/payment-info`);
              const data = res.data || {};
              if(title){
                title.textContent = data.isPaid
                  ? `Thông tin đã thanh toán - ${data.regCode || ""}`
                  : `Mã Sepay - ${data.regCode || ""}`;
              }
              if(body) body.innerHTML = renderPaymentInfo(data);
              startActivePaymentWatch(data);
              if(data.isPaid){
                await load(CURRENT_TAB);
              }
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể tải thông tin thanh toán.";
              if(body){
                body.innerHTML = `<div class="alert alert-danger mb-0">${esc(msg)}</div>`;
              }
            }
          }

          function paidHtml(reg){
            const paid = !!reg.paid;
            const cls = paid ? "btn-success" : "btn-outline-danger";
            const icon = paid ? "fa-check" : "fa-times";
            const title = paid ? "Đã thanh toán - xem thông tin" : "Chưa thanh toán - tạo/xem mã Sepay";
            return `
              <button class="btn btn-sm ${cls} payment-status-btn" type="button" onclick="openPaymentInfo(${reg.registrationId})" title="${title}">
                <i class="fas ${icon}"></i>
              </button>
            `;
          }

          function relayPaymentHtml(reg){
            const paid = !!reg.paid;
            const cls = paid ? "btn-success" : "btn-outline-danger";
            const icon = paid ? "fa-check-circle" : "fa-wallet";
            const label = paid ? "Đã thanh toán" : "Chưa thanh toán";
            const title = paid ? "Xem thông tin thanh toán" : "Tạo hoặc xem mã thanh toán";
            return `
              <button class="btn btn-sm ${cls}" type="button" onclick="openPaymentInfo(${Number(reg.registrationId || 0)})" title="${title}">
                <i class="fas ${icon} mr-1" aria-hidden="true"></i>${label}
              </button>`;
          }

          function relayMemberHtml(member, position){
            const displayName = String(member?.displayName || "").trim();
            const userId = Number(member?.userId || 0);
            const avatarUrl = String(member?.avatarUrl || "").trim();
            const initial = (displayName || "?").charAt(0).toUpperCase();
            const avatarImage = avatarUrl
              ? `<img src="${escAttr(avatarUrl)}" alt="Ảnh đại diện ${escAttr(displayName || "vận động viên")}" loading="lazy" onerror="this.remove()" />`
              : "";
            const memberDetails = userId
              ? `<span><i class="fas fa-chart-line mr-1" aria-hidden="true"></i>Trình đôi: ${formatLevel(member?.ratingDouble)}</span>
                 <span><i class="fas fa-id-badge mr-1" aria-hidden="true"></i>User ID: ${userId}</span>`
              : `<span>${displayName ? "Vận động viên khách" : "Chưa nhập thông tin"}</span>`;
            return `
              <div class="relay-pair-member">
                <span class="relay-pair-member__avatar" aria-hidden="true">
                  ${esc(initial)}
                  ${avatarImage}
                  <span class="relay-pair-member__position">${position}</span>
                </span>
                <span class="relay-pair-member__copy">
                  <span class="relay-pair-member__name" title="${escAttr(displayName || "Chưa có thành viên")}">${esc(displayName || "Chưa có thành viên")}</span>
                  <span class="relay-pair-member__type">${memberDetails}</span>
                </span>
              </div>`;
          }

          function relayActionsHtml(reg){
            const registrationId = Number(reg.registrationId || 0);
            return `
              <div class="relay-team-card__actions">
                <button class="btn btn-sm btn-outline-primary" type="button" onclick="openEditTeam(${registrationId})">
                  <i class="fas fa-user-edit mr-1" aria-hidden="true"></i>Sửa đội hình
                </button>
                <button class="btn btn-sm btn-outline-danger" type="button" onclick="delReg(${registrationId})" title="Xóa đăng ký đội">
                  <i class="fas fa-trash-alt mr-1" aria-hidden="true"></i>Xóa
                </button>
              </div>`;
          }

          function relayTeamCardHtml(reg){
            const members = (reg.relayMembers || []).slice().sort((a,b) => Number(a.position) - Number(b.position));
            const memberByPosition = new Map(members.map(member => [Number(member.position), member]));
            const complete = !!reg.relayRosterComplete;
            const stateClass = complete ? "is-ready" : "is-incomplete";
            const stateIcon = complete ? "fa-check-circle" : "fa-exclamation-triangle";
            const missingCount = Math.max(0, RELAY_TEAM_SIZE - Number(reg.relayMemberCount || members.length));
            const stateLabel = complete ? "Sẵn sàng" : `Thiếu ${missingCount} VĐV`;
            const pairCards = Array.from({ length: RELAY_PAIR_COUNT }, (_, index) => {
              const pairNumber = index + 1;
              const firstPosition = (pairNumber * 2) - 1;
              const secondPosition = pairNumber * 2;
              return `
                <section class="relay-pair-card">
                  <div class="relay-pair-card__head">
                    <span>Cặp ${pairNumber}</span>
                    <span>Vị trí ${firstPosition}–${secondPosition}</span>
                  </div>
                  ${relayMemberHtml(memberByPosition.get(firstPosition), firstPosition)}
                  ${relayMemberHtml(memberByPosition.get(secondPosition), secondPosition)}
                </section>`;
            }).join("");
            const transferCode = String(reg.btCode || "").trim();
            const captainId = Number(reg.relayCaptainUserId || 0);

            return `
              <article class="relay-team-card ${stateClass}">
                <header class="relay-team-card__head">
                  <div class="relay-team-card__identity">
                    <span class="relay-team-card__number">${Number(reg.regIndex || 0) || "#"}</span>
                    <div>
                      <h3 class="relay-team-card__title">${esc(reg.relayTeamName || "Chưa đặt tên đội")}</h3>
                      <div class="relay-team-card__meta">
                        <span><i class="fas fa-tag mr-1" aria-hidden="true"></i>${esc(reg.regCode || "—")}</span>
                        <span><i class="far fa-clock mr-1" aria-hidden="true"></i>${fmt(reg.regTime)}</span>
                        ${captainId ? `<span><i class="fas fa-user-shield mr-1" aria-hidden="true"></i>Đội trưởng #${captainId}</span>` : ""}
                        ${transferCode ? `<span><i class="fas fa-receipt mr-1" aria-hidden="true"></i>${esc(transferCode)}</span>` : ""}
                      </div>
                    </div>
                  </div>
                  <span class="relay-team-card__status ${stateClass}">
                    <i class="fas ${stateIcon} mr-1" aria-hidden="true"></i>${stateLabel}
                  </span>
                </header>
                <div class="relay-team-card__body">
                  <div class="relay-team-card__roster-head">
                    <span><i class="fas fa-users mr-1 text-primary" aria-hidden="true"></i>Đội hình thi đấu</span>
                    <span>${Number(reg.relayMemberCount || members.length)}/${RELAY_TEAM_SIZE} VĐV · ${RELAY_PAIR_COUNT} cặp</span>
                  </div>
                  <div class="relay-pair-grid">${pairCards}</div>
                  <div class="relay-reserve-list">
                    <div class="relay-team-card__roster-head"><span>Thành viên dự bị</span><span>${(reg.relayReserveMembers || []).length}/4 người</span></div>
                    ${(reg.relayReserveMembers || []).length ? '<div class="relay-pair-grid">' + reg.relayReserveMembers.map(member => '<div class="relay-pair-card">' + relayMemberHtml(member, 'DB ' + member.position) + '</div>').join('') + '</div>' : '<p class="small text-muted mb-0">Không có thành viên dự bị.</p>'}
                  </div>
                </div>
                <footer class="relay-team-card__footer">
                  <div class="relay-team-card__payment">${relayPaymentHtml(reg)}</div>
                  ${relayActionsHtml(reg)}
                </footer>
              </article>`;
          }

          function actionsHtml(reg){
            if(IS_RELAY){
              return `
                <div class="d-flex flex-wrap" style="gap:6px">
                  <button class="btn btn-sm btn-outline-primary" type="button" onclick="openEditTeam(${reg.registrationId})" title="Sửa đội hình tiếp sức">
                    <i class="fas fa-user-edit"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-danger" type="button" onclick="delReg(${reg.registrationId})" title="Xóa đội tiếp sức">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>`;
            }

            const isDouble = (TOURNAMENT_GAME_TYPE === "DOUBLE");
            const pairBtn = (isDouble && reg.waitingPair)
              ? `<button class="btn btn-sm btn-outline-warning" type="button" onclick="openPair(${reg.registrationId})" title="Ghép">
                   <i class="fas fa-link"></i>
                 </button>`
              : `<button class="btn btn-sm btn-outline-secondary" type="button" disabled title="Không cần ghép">
                   <i class="fas fa-link"></i>
                 </button>`;

            return `
              <div class="d-flex flex-wrap" style="gap:6px">
                ${pairBtn}
                <button class="btn btn-sm btn-outline-info" type="button" onclick="syncLevels(${reg.registrationId})" title="Đồng bộ trình">
                  <i class="fas fa-sync-alt"></i>
                </button>
                <button class="btn btn-sm btn-outline-primary" type="button" onclick="openEditTeam(${reg.registrationId})" title="Sửa đội">
                  <i class="fas fa-user-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" type="button" onclick="delReg(${reg.registrationId})" title="Xoá">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            `;
          }

          function rowHtml(reg){
            if(IS_RELAY){
              const members = (reg.relayMembers || []).slice().sort((a,b) => Number(a.position) - Number(b.position));
              const pairs = [];
              for(let pair = 1; pair <= RELAY_PAIR_COUNT; pair++){
                const pairMembers = members.filter(x => Number(x.pairNumber) === pair);
                const names = pairMembers.map(x => esc(x.displayName || "—")).join(" / ") || "Chưa đủ thành viên";
                pairs.push(`<div><strong>Cặp ${pair}:</strong> ${names}</div>`);
              }
              const complete = !!reg.relayRosterComplete;
              const missingCount = Math.max(0, RELAY_TEAM_SIZE - Number(reg.relayMemberCount || members.length));
              const statusHtml = complete
                ? `<span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i>Sẵn sàng</span>`
                : `<span class="badge badge-danger">Thiếu ${missingCount} VĐV</span>`;
              return `
                <tr>
                  <td>${reg.regIndex ?? ""}</td>
                  <td><div class="font-weight-bold">${esc(reg.regCode)}</div></td>
                  <td>${fmt(reg.regTime)}</td>
                  <td>
                    <div class="font-weight-bold text-gray-900">${esc(reg.relayTeamName || "Chưa đặt tên đội")}</div>
                    <div class="small text-muted">${Number(reg.relayMemberCount || 0)}/${RELAY_TEAM_SIZE} VĐV · ${RELAY_PAIR_COUNT} cặp</div>
                  </td>
                  <td><div class="relay-lineup-list small">${pairs.join("")}</div></td>
                  <td class="text-center">${statusHtml}</td>
                  <td>${esc(reg.btCode||"")}</td>
                  <td class="text-center">${paidHtml(reg)}</td>
                  <td>${actionsHtml(reg)}</td>
                </tr>`;
            }

            const teamPoints = getTeamPoints(reg);

            return `
              <tr>
                <td>${reg.regIndex ?? ""}</td>
                <td><div class="font-weight-bold">${esc(reg.regCode)}</div></td>
                <td>${fmt(reg.regTime)}</td>
                <td>${playerCell(
                  reg.player1Name,
                  reg.player1LevelSingle,
                  reg.player1LevelDouble,
                  reg.player1Level,
                  reg.player1Avatar,
                  reg.player1Verified
                )}</td>

                <td>${playerCell(
                  reg.player2Name,
                  reg.player2LevelSingle,
                  reg.player2LevelDouble,
                  reg.player2Level,
                  reg.player2Avatar,
                  reg.player2Verified
                )}</td>
                <td class="text-right">${teamPoints.toFixed(2)}</td>
                <td>${esc(reg.btCode||"")}</td>
                <td class="text-center">${paidHtml(reg)}</td>
                <td>${actionsHtml(reg)}</td>
              </tr>
            `;
          }

          function setTabButtons(counts){
            const tabSuccess = $id("tabSuccess");
            const tabWaiting = $id("tabWaiting");
            const tabCapacity = $id("tabCapacity");

            if(tabSuccess){
              tabSuccess.className = `btn btn-sm pill ${CURRENT_TAB==="SUCCESS"?"btn-success":"btn-outline-success"}`;
              tabSuccess.textContent = IS_RELAY ? `Sẵn sàng (${counts.success})` : `Thành công (${counts.success})`;
              tabSuccess.setAttribute("aria-selected", String(CURRENT_TAB === "SUCCESS"));
            }
            if(tabWaiting){
              tabWaiting.className = `btn btn-sm pill ${CURRENT_TAB==="WAITING"?"btn-warning":"btn-outline-warning"}`;
              tabWaiting.textContent = IS_RELAY ? `Chưa đủ đội hình (${counts.waiting})` : `Chờ ghép (${counts.waiting})`;
              tabWaiting.setAttribute("aria-selected", String(CURRENT_TAB === "WAITING"));
            }
            if(tabCapacity){
              tabCapacity.className = `btn btn-sm pill btn-outline-secondary`;
              tabCapacity.textContent = `Còn chỗ (${counts.capacityLeft})`;
            }
          }

          function updateSummary(tournament, counts){
            const success = Number(counts?.success || 0);
            const waiting = Number(counts?.waiting || 0);
            const capacity = Number(counts?.capacityLeft || 0);
            const expected = Number(tournament?.expectedTeams || (success + waiting + capacity));
            const total = success + waiting;

            if($id("summaryTotal")) $id("summaryTotal").textContent = String(total);
            if($id("summarySuccess")) $id("summarySuccess").textContent = String(success);
            if($id("summaryWaiting")) $id("summaryWaiting").textContent = String(waiting);
            if($id("summaryCapacity")) $id("summaryCapacity").textContent = String(capacity);
            if($id("summaryTotalHint")) $id("summaryTotalHint").textContent = `trên ${expected} đội dự kiến`;
            if($id("summarySuccessLabel")) $id("summarySuccessLabel").textContent = IS_RELAY ? "Sẵn sàng" : "Thành công";
            if($id("summarySuccessHint")) $id("summarySuccessHint").textContent = IS_RELAY ? "đội sẵn sàng thi đấu" : "đăng ký hợp lệ";
            if($id("summaryWaitingLabel")) $id("summaryWaitingLabel").textContent = IS_RELAY ? "Chưa đủ đội hình" : "Chờ ghép";
            if($id("summaryWaitingHint")) $id("summaryWaitingHint").textContent = IS_RELAY ? "đội cần admin xử lý" : "đăng ký cần ghép đôi";
            if($id("summaryCapacityHint")) $id("summaryCapacityHint").textContent = IS_RELAY ? "đội tiếp sức có thể thêm" : "đội có thể đăng ký thêm";
            $id("registrationSummary")?.classList.remove("d-none");
          }

          function emptyStateHtml(title, message, icon = "fa-users"){
            return `
              <div class="registration-empty">
                <i class="fas ${icon}" aria-hidden="true"></i>
                <strong>${esc(title)}</strong>
                <span>${esc(message)}</span>
              </div>`;
          }

          function renderRegistrationItems(items, emptyTitle, emptyMessage){
            const data = Array.isArray(items) ? items : [];
            const body = $id("body");
            const relayList = $id("relayList");
            const resultSummary = $id("resultSummary");
            const query = String($id("q")?.value || "").trim();
            const unit = IS_RELAY ? "đội tiếp sức" : "đăng ký";

            if(resultSummary){
              resultSummary.textContent = query
                ? `${data.length} kết quả phù hợp với “${query}”`
                : `${data.length} ${unit} trong trạng thái đang chọn`;
            }

            if(IS_RELAY){
              if(!relayList) return;
              relayList.innerHTML = data.length
                ? data.map(relayTeamCardHtml).join("")
                : emptyStateHtml(emptyTitle || "Chưa có đội trong mục này", emptyMessage || "Hãy chọn trạng thái khác hoặc thêm đăng ký mới.");
              return;
            }

            if(!body) return;
            body.innerHTML = data.length
              ? data.map(rowHtml).join("")
              : `<tr><td colspan="9" class="p-0 border-0">${emptyStateHtml(emptyTitle || "Chưa có đăng ký", emptyMessage || "Hãy chọn trạng thái khác hoặc thêm đăng ký mới.")}</td></tr>`;
          }

          function matchesRegistration(registration, key){
            if(!key) return true;
            return [
              registration.player1Name,
              registration.player2Name,
              registration.relayTeamName,
              registration.regCode,
              registration.btCode,
              ...(registration.relayMembers || []).flatMap(member => [member.displayName, member.userId]),
              ...(registration.relayReserveMembers || []).flatMap(member => [member.displayName, member.userId])
            ].some(value => String(value || "").toLowerCase().includes(key));
          }

          function applySearchFilter(){
            const key = String($id("q")?.value || "").trim().toLowerCase();
            $id("btnClearSearch")?.classList.toggle("d-none", !key);
            const filtered = (CACHE.items || []).filter(item => matchesRegistration(item, key));
            renderRegistrationItems(
              filtered,
              key ? "Không tìm thấy kết quả" : undefined,
              key ? "Thử tên đội, tên vận động viên, User ID hoặc mã đăng ký khác." : undefined);
          }

          function renderListLoading(){
            const body = $id("body");
            const relayList = $id("relayList");
            if($id("resultSummary")) $id("resultSummary").textContent = "Đang tải dữ liệu...";
            if(IS_RELAY && relayList){
              relayList.innerHTML = emptyStateHtml("Đang tải danh sách đội", "Vui lòng chờ trong giây lát.", "fa-spinner fa-spin");
            } else if(body){
              body.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin mr-2" aria-hidden="true"></i>Đang tải dữ liệu...</td></tr>`;
            }
          }

          function renderListError(message){
            const html = emptyStateHtml("Không tải được danh sách", message || "Vui lòng thử tải lại trang.", "fa-exclamation-circle");
            if($id("resultSummary")) $id("resultSummary").textContent = "Có lỗi khi tải dữ liệu";
            if(IS_RELAY && $id("relayList")){
              $id("relayList").innerHTML = html;
            } else if($id("body")){
              $id("body").innerHTML = `<tr><td colspan="9" class="p-0 border-0">${html}</td></tr>`;
            }
          }

          function applyTournamentModeUI(){
            $id("standardGameTypeField")?.classList.toggle("d-none", IS_RELAY);
            $id("standardDoubleModeField")?.classList.toggle("d-none", IS_RELAY);
            $id("standardCreatePlayers")?.classList.toggle("d-none", IS_RELAY);
            $id("relayCreateBlock")?.classList.toggle("d-none", !IS_RELAY);
            $id("registrationTableWrap")?.classList.toggle("d-none", IS_RELAY);
            $id("relayList")?.classList.toggle("d-none", !IS_RELAY);

            const createLabel = $id("createButtonLabel");
            if(createLabel) createLabel.textContent = IS_RELAY ? "Đăng ký đội tiếp sức" : "Đăng ký cho vận động viên";
            const player1Header = $id("player1Header");
            const player2Header = $id("player2Header");
            const pointsHeader = $id("pointsHeader");
            if(player1Header) player1Header.textContent = IS_RELAY ? "Đội tiếp sức" : "VĐV 1";
            if(player2Header) player2Header.textContent = IS_RELAY ? "Đội hình và cặp" : "VĐV 2";
            if(pointsHeader) pointsHeader.textContent = IS_RELAY ? "Trạng thái" : "Điểm";
          }

          async function load(tab){
            const loadSequence = ++LOAD_SEQUENCE;
            CURRENT_TAB = tab;
            renderListLoading();

            try{
              const res = await axios.get(API_LIST, { params: { tab } });
              if(loadSequence !== LOAD_SEQUENCE) return;
              const { tournament, counts, items } = res.data;

              IS_RELAY = !!tournament.isRelay;
              RELAY_TEAM_SIZE = IS_RELAY ? Number(tournament.relayTeamSize || 0) : 0;
              RELAY_PAIR_COUNT = IS_RELAY ? Number(tournament.relayPairCount || 0) : 0;
              applyTournamentModeUI();

              const typeCode = String(tournament.tournamentTypeCode || "").toUpperCase();
              const rawGameType = String(tournament.gameType || "").toUpperCase();
              TOURNAMENT_GAME_TYPE = typeCode.startsWith("SINGLE")
                ? "SINGLE"
                : (typeCode.startsWith("DOUBLE") ? "DOUBLE" : (rawGameType === "SINGLE" ? "SINGLE" : "DOUBLE"));

              const meta = $id("tournamentMeta");
              if(meta){
                meta.textContent = IS_RELAY
                  ? `${tournament.title} • ${tournament.status} • Tiếp sức ${RELAY_TEAM_SIZE} người/${RELAY_PAIR_COUNT} cặp • Đích ${tournament.relayTargetScore} điểm`
                  : `${tournament.title} • ${tournament.status} • Loại thi đấu: ${tournament.gameType}`;
              }
              setTabButtons(counts);
              updateSummary(tournament, counts);

              if(IS_RELAY && !HAS_AUTO_SELECTED_RELAY_TAB && tab === "SUCCESS" && Number(counts.success || 0) === 0 && Number(counts.waiting || 0) > 0){
                HAS_AUTO_SELECTED_RELAY_TAB = true;
                return load("WAITING");
              }
              if(IS_RELAY) HAS_AUTO_SELECTED_RELAY_TAB = true;

              CACHE.items = items || [];
              if(IS_RELAY){
                CACHE.waiting = [];
              } else {
                const waitingRes = await axios.get(API_LIST, { params: { tab: "WAITING" } });
                if(loadSequence !== LOAD_SEQUENCE) return;
                CACHE.waiting = waitingRes.data.items || [];
              }

              applySearchFilter();
            } catch(err){
              if(loadSequence !== LOAD_SEQUENCE) return;
              const message = err?.response?.data?.message || err?.message || "Không thể tải danh sách đăng ký.";
              renderListError(message);
            }
          }

          window.togglePaid = togglePaid;
          window.delReg = delReg;
          window.syncLevels = syncLevels;
          window.openPaymentInfo = openPaymentInfo;
          window.openCashPaymentConfirmation = openCashPaymentConfirmation;
          window.openCancelPaymentConfirmation = openCancelPaymentConfirmation;
          window.confirmCancelPayment = confirmCancelPayment;

          function openPair(baseId){
            if(TOURNAMENT_GAME_TYPE !== "DOUBLE"){
              alert("Giải đơn không cần ghép đôi.");
              return;
            }

            $id("pairBaseId").value = String(baseId);
            $id("pairErr")?.classList.add("d-none");

            const waiting = (CACHE.waiting || [])
              .filter(x => x.registrationId !== baseId)
              .sort((a,b) => (b.regIndex||0) - (a.regIndex||0));

            const sel = $id("pairWith");
            const options = waiting.map(x => {
              const s = (x.player1LevelSingle ?? x.player1Level ?? 0).toFixed(2);
              const d = (x.player1LevelDouble ?? x.player1Level ?? 0).toFixed(2);
              return `<option value="${x.registrationId}">${x.regCode} — ${esc(x.player1Name)} (Đơn: ${s}, Đôi: ${d})</option>`;
            });
            sel.innerHTML = options.join("");

            if(sel.options.length > 0) sel.selectedIndex = 0;

            $("#modalPair").modal("show");
          }
          window.openPair = openPair;

          function findRegById(id){
            return (CACHE.items || []).concat(CACHE.waiting || [])
              .find(x => Number(x.registrationId) === Number(id)) || null;
          }

          function showEditErr(msg){
            const box = $id("editErr");
            if(!box) return;
            box.textContent = msg || "Error";
            box.classList.remove("d-none");
          }

          function clearEditErr(){
            const box = $id("editErr");
            if(!box) return;
            box.textContent = "";
            box.classList.add("d-none");
          }

          function setEditAvatarBox(pn, url){
            const box = $id(`e${pn}AvatarBox`);
            if(!box) return;
            box.innerHTML = url ? `<img class="avatar-preview" src="${esc(url)}" />` : `<div class="avatar-placeholder">?</div>`;
          }

          function applyEditPlayerTypeUI(pn){
            const type = $id(`e${pn}Type`)?.value || "USER";
            const userBlock = $id(`e${pn}UserBlock`);
            const guestBlock = $id(`e${pn}GuestBlock`);
            const info = $id(`e${pn}UserInfo`);

            if(type === "USER"){
              if(userBlock) userBlock.style.display = "block";
              if(guestBlock) guestBlock.style.display = "none";
              if(info && !String(info.textContent || "").trim()) info.textContent = "Chưa kiểm tra";

              const gn = $id(`e${pn}GuestName`); if(gn) gn.value = "";
              const gl = $id(`e${pn}GuestLevel`); if(gl) gl.value = "2.50";
              const gf = $id(`e${pn}GuestAvatarFile`); if(gf) gf.value = "";
            } else {
              if(userBlock) userBlock.style.display = "none";
              if(guestBlock) guestBlock.style.display = "block";

              const ui = $id(`e${pn}UserId`); if(ui) ui.value = "";
              if(info) info.textContent = "Chế độ khách";
            }
          }

          function fillEditPlayer(pn, reg, isPlayer2){
            const userId = isPlayer2 ? reg.player2UserId : reg.player1UserId;
            const name = isPlayer2 ? reg.player2Name : reg.player1Name;
            const avatar = isPlayer2 ? reg.player2Avatar : reg.player1Avatar;
            const pickedLevel = isPlayer2 ? reg.player2Level : reg.player1Level;
            const singleLevel = isPlayer2 ? reg.player2LevelSingle : reg.player1LevelSingle;
            const doubleLevel = isPlayer2 ? reg.player2LevelDouble : reg.player1LevelDouble;

            const type = userId ? "USER" : "GUEST";
            const typeEl = $id(`e${pn}Type`);
            if(typeEl) typeEl.value = type;

            if(type === "USER"){
              const idEl = $id(`e${pn}UserId`);
              if(idEl) idEl.value = userId || "";
              const info = $id(`e${pn}UserInfo`);
              if(info){
                info.textContent = `${name || ""} • Trình đơn: ${formatLevel(singleLevel)} • Trình đôi: ${formatLevel(doubleLevel)} • ID người dùng: ${userId}`;
              }
            } else {
              const nameEl = $id(`e${pn}GuestName`);
              const levelEl = $id(`e${pn}GuestLevel`);
              if(nameEl) nameEl.value = name || "";
              if(levelEl) levelEl.value = Number(pickedLevel || 0).toFixed(2);
            }

            const fileEl = $id(`e${pn}GuestAvatarFile`);
            if(fileEl) fileEl.value = "";
            setEditAvatarBox(pn, avatar || null);
            applyEditPlayerTypeUI(pn);
            setEditAvatarBox(pn, avatar || null);
          }

          function openEditTeam(id){
            const reg = findRegById(id);
            if(!reg){
              alert("Không tìm thấy đăng ký trong dữ liệu hiện tại.");
              return;
            }

            EDITING_REG = reg;
            clearEditErr();
            $id("formEditTeam")?.reset();
            $id("editRegistrationId").value = String(reg.registrationId);

            const title = $id("editTeamTitle");
            if(title) title.textContent = `Sửa đội ${reg.regCode || ""}`;

            const standardEdit = $id("standardEditPlayers");
            const relayEdit = $id("relayEditBlock");
            const saveButton = $id("btnEditSubmit");
            if(IS_RELAY){
              standardEdit?.classList.add("d-none");
              relayEdit?.classList.remove("d-none");
              if($id("relayEditTeamName")){
                $id("relayEditTeamName").value = reg.relayTeamName || "";
                $id("relayEditTeamName").disabled = false;
              }
              if($id("relayEditCaptainId")){
                $id("relayEditCaptainId").value = reg.relayCaptainUserId || "";
                $id("relayEditCaptainId").disabled = false;
              }
              renderRelayMemberEditors("relayEditMembers", "edit", reg.relayMembers || [], false);
              renderRelayReserveEditors("Edit", reg.relayReserveMembers || []);
              saveButton?.classList.remove("d-none");
              if(title) title.textContent = `Sửa đội tiếp sức ${reg.regCode || ""}`;
              const note = $id("editTeamNote");
              if(note) note.textContent = `Phải có đúng ${RELAY_TEAM_SIZE} VĐV. Thay đổi chỉ áp dụng cho các trận chưa bắt đầu chấm điểm.`;
              $("#modalEditTeam").modal("show");
              return;
            }

            standardEdit?.classList.remove("d-none");
            relayEdit?.classList.add("d-none");
            saveButton?.classList.remove("d-none");

            fillEditPlayer(1, reg, false);

            const hideP2 = TOURNAMENT_GAME_TYPE !== "DOUBLE" || !!reg.waitingPair;
            const p2Wrap = $id("editP2Wrap");
            if(p2Wrap) p2Wrap.style.display = hideP2 ? "none" : "block";

            if(!hideP2){
              fillEditPlayer(2, reg, true);
            } else {
              setEditAvatarBox(2, null);
            }

            const note = $id("editTeamNote");
            if(note){
              note.textContent = hideP2
                ? "Đăng ký này chỉ sửa VDV 1 vì đang là giải đơn hoặc đội chờ ghép."
                : "Lưu đội sẽ cập nhật lại thành viên và tính lại điểm đội.";
            }

            $("#modalEditTeam").modal("show");
          }
          window.openEditTeam = openEditTeam;

          async function checkEditUser(pn){
            const idRaw = ($id(`e${pn}UserId`)?.value || "").trim();
            const id = Number(idRaw);
            if(!id || id <= 0) return showEditErr(`Vận động viên ${pn}: nhập ID người dùng hợp lệ.`);

            try{
              const res = await axios.get(`/api/admin/users/find/${id}`);
              const u = res.data;

              const single = Number(u.ratingSingle || 0);
              const dbl = Number(u.ratingDouble || 0);
              const pickedLevel = (TOURNAMENT_GAME_TYPE === "DOUBLE") ? dbl : single;

              const info = $id(`e${pn}UserInfo`);
              if(info){
                info.textContent =
                  `${u.fullName} • Trình đơn: ${single.toFixed(2)} • Trình đôi: ${dbl.toFixed(2)} • Trình áp dụng: ${pickedLevel.toFixed(2)} • ID người dùng: ${u.userId}`;
              }
              setEditAvatarBox(pn, u.avatarUrl || null);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Kiểm tra người dùng thất bại.";
              showEditErr(`VDV ${pn}: ${msg}`);
            }
          }

          function previewEditGuestAvatar(pn){
            const input = $id(`e${pn}GuestAvatarFile`);
            const f = input?.files?.[0];
            if(!f){
              const avatar = pn === 2 ? EDITING_REG?.player2Avatar : EDITING_REG?.player1Avatar;
              setEditAvatarBox(pn, avatar || null);
              return;
            }

            setEditAvatarBox(pn, URL.createObjectURL(f));
          }

          function appendEditPlayer(fd, pn, fieldPrefix){
            const type = $id(`e${pn}Type`)?.value || "USER";
            if(type === "USER"){
              const id = ($id(`e${pn}UserId`)?.value || "").trim();
              if(!id) throw new Error(`Vận động viên ${pn}: chưa nhập ID người dùng.`);
              fd.append(`${fieldPrefix}UserId`, id);
              return;
            }

            const name = ($id(`e${pn}GuestName`)?.value || "").trim();
            const level = ($id(`e${pn}GuestLevel`)?.value || "").trim();
            if(!name) throw new Error(`Vận động viên ${pn} (khách): thiếu họ tên.`);
            if(!level) throw new Error(`Vận động viên ${pn} (khách): thiếu điểm trình.`);

            fd.append(`${fieldPrefix}Name`, name);
            fd.append(`${fieldPrefix}Level`, level);

            const f = $id(`e${pn}GuestAvatarFile`)?.files?.[0];
            if(f) fd.append(`${fieldPrefix}AvatarFile`, f);
          }

          function buildEditFormData(){
            if(!EDITING_REG) throw new Error("Chưa chọn đội cần sửa.");

            const fd = new FormData();
            if(IS_RELAY){
              const teamName = String($id("relayEditTeamName")?.value || "").trim();
              const captainId = String($id("relayEditCaptainId")?.value || "").trim();
              if(!teamName) throw new Error("Vui lòng nhập tên đội tiếp sức.");
              fd.append("relayTeamName", teamName);
              if(captainId) fd.append("relayCaptainUserId", captainId);
              fd.append("relayExpectedVersion", String(EDITING_REG.relayVersion || 0));
              appendRelayMembers(fd, "edit");
              return fd;
            }

            appendEditPlayer(fd, 1, "player1");

            if(TOURNAMENT_GAME_TYPE === "DOUBLE" && !EDITING_REG.waitingPair){
              appendEditPlayer(fd, 2, "player2");
            }

            return fd;
          }

          function showCreateErr(msg){
            const box = $id("createErr");
            if(!box) return;
            box.textContent = msg || "Error";
            box.classList.remove("d-none");
          }
          function clearCreateErr(){
            const box = $id("createErr");
            if(!box) return;
            box.classList.add("d-none");
            box.textContent = "";
          }

          function setAvatarBox(boxId, url){
            const box = $id(boxId);
            if(!box) return;
            box.innerHTML = url ? `<img class="avatar-preview" src="${esc(url)}" />` : `<div class="avatar-placeholder">?</div>`;
          }

          function applyModeUI(){
            const dm = $id("doubleMode")?.value || "PAIR";

            if (TOURNAMENT_GAME_TYPE === "SINGLE" || TOURNAMENT_GAME_TYPE === "DOUBLE"){
              $id("gameType").value = TOURNAMENT_GAME_TYPE;
              $id("gameType").disabled = true;
            } else {
              $id("gameType").disabled = false;
            }

            const finalGT = $id("gameType")?.value || "DOUBLE";
            const p2Wrap = $id("p2Wrap");

            if(finalGT === "SINGLE"){
              if(p2Wrap) p2Wrap.style.display = "none";
              if($id("doubleMode")) $id("doubleMode").disabled = true;
            } else {
              if($id("doubleMode")) $id("doubleMode").disabled = false;
              if(p2Wrap) p2Wrap.style.display = (dm === "WAITING") ? "none" : "block";
            }
          }

          function applyPlayerTypeUI(pn){
            const type = $id(`p${pn}Type`)?.value || "USER";
            const userBlock = $id(`p${pn}UserBlock`);
            const guestBlock = $id(`p${pn}GuestBlock`);
            const info = $id(`p${pn}UserInfo`);

            if(type === "USER"){
              if(userBlock) userBlock.style.display = "block";
              if(guestBlock) guestBlock.style.display = "none";
              if(info) info.textContent = "Chưa kiểm tra";
              setAvatarBox(`p${pn}AvatarBox`, null);

              const gn = $id(`p${pn}GuestName`); if(gn) gn.value = "";
              const gl = $id(`p${pn}GuestLevel`); if(gl) gl.value = "2.50";
              const gf = $id(`p${pn}GuestAvatarFile`); if(gf) gf.value = "";
            } else {
              if(userBlock) userBlock.style.display = "none";
              if(guestBlock) guestBlock.style.display = "block";
              setAvatarBox(`p${pn}AvatarBox`, null);

              const ui = $id(`p${pn}UserId`); if(ui) ui.value = "";
              if(info) info.textContent = "Chế độ khách";
            }
          }

          async function checkUser(pn){
            const idRaw = ($id(`p${pn}UserId`)?.value || "").trim();
            const id = Number(idRaw);
            if(!id || id <= 0) return showCreateErr(`Vận động viên ${pn}: nhập ID người dùng hợp lệ.`);

            try{
              const res = await axios.get(`/api/admin/users/find/${id}`);
              const u = res.data;

              const single = Number(u.ratingSingle || 0);
              const dbl = Number(u.ratingDouble || 0);

              const pickedLevel = (TOURNAMENT_GAME_TYPE === "DOUBLE") ? dbl : single;

              const info = $id(`p${pn}UserInfo`);
              if(info){
                info.textContent =
                  `${u.fullName} • Trình đơn: ${single.toFixed(2)} • Trình đôi: ${dbl.toFixed(2)} • Trình áp dụng: ${pickedLevel.toFixed(2)} • ID người dùng: ${u.userId}`;
              }
              setAvatarBox(`p${pn}AvatarBox`, u.avatarUrl || null);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Kiểm tra người dùng thất bại.";
              showCreateErr(`VDV ${pn}: ${msg}`);
            }
          }

          function previewGuestAvatar(pn){
            const input = $id(`p${pn}GuestAvatarFile`);
            const f = input?.files?.[0];
            if(!f){ setAvatarBox(`p${pn}AvatarBox`, null); return; }
            const url = URL.createObjectURL(f);
            setAvatarBox(`p${pn}AvatarBox`, url);
          }

          function buildFormData(){
            const fd = new FormData();

            fd.append("paid", String(($id("paid")?.value || "false") === "true"));
            fd.append("btCode", $id("btCode")?.value || "");

            if(IS_RELAY){
              const teamName = String($id("relayCreateTeamName")?.value || "").trim();
              const captainId = String($id("relayCreateCaptainId")?.value || "").trim();
              if(!teamName) throw new Error("Vui lòng nhập tên đội tiếp sức.");
              fd.append("relayTeamName", teamName);
              if(captainId) fd.append("relayCaptainUserId", captainId);
              appendRelayMembers(fd, "create");
              return fd;
            }

            const gt = $id("gameType")?.value || "DOUBLE";
            let dm = $id("doubleMode")?.value || "PAIR";

            if(gt === "SINGLE") dm = "PAIR";
            const waitingPair = (gt === "DOUBLE" && dm === "WAITING");

            fd.append("gameType", gt);
            fd.append("waitingPair", String(waitingPair));

            const p1Type = $id("p1Type")?.value || "USER";
            if(p1Type === "USER"){
              const id = ($id("p1UserId")?.value || "").trim();
              if(!id) throw new Error("Vận động viên 1: chưa nhập ID người dùng.");
              fd.append("player1UserId", id);
            } else {
              const name = ($id("p1GuestName")?.value || "").trim();
              const level = ($id("p1GuestLevel")?.value || "").trim();
              if(!name) throw new Error("Vận động viên 1 (khách): thiếu họ tên.");
              if(!level) throw new Error("Vận động viên 1 (khách): thiếu điểm trình.");
              fd.append("player1Name", name);
              fd.append("player1Level", level);

              const f = $id("p1GuestAvatarFile")?.files?.[0];
              if(f) fd.append("player1AvatarFile", f);
            }

            if(gt === "DOUBLE" && !waitingPair){
              const p2Type = $id("p2Type")?.value || "USER";
              if(p2Type === "USER"){
                const id = ($id("p2UserId")?.value || "").trim();
                if(!id) throw new Error("Vận động viên 2: chưa nhập ID người dùng.");
                fd.append("player2UserId", id);
              } else {
                const name = ($id("p2GuestName")?.value || "").trim();
                const level = ($id("p2GuestLevel")?.value || "").trim();
                if(!name) throw new Error("Vận động viên 2 (khách): thiếu họ tên.");
                if(!level) throw new Error("Vận động viên 2 (khách): thiếu điểm trình.");
                fd.append("player2Name", name);
                fd.append("player2Level", level);

                const f = $id("p2GuestAvatarFile")?.files?.[0];
                if(f) fd.append("player2AvatarFile", f);
              }
            }

            return fd;
          }

          document.addEventListener("DOMContentLoaded", async () => {
            if(!TOURNAMENT_ID){
              console.error("TOURNAMENT_ID missing. Check ViewBag.TournamentId.");
              return;
            }

            document.addEventListener("click", (event) => {
              const clear = event.target.closest("[data-relay-reserve-clear]");
              if (clear) {
                const prefix = clear.dataset.prefix, position = Number(clear.dataset.position);
                $id(`${prefix}RelayUser${position}`).value = "";
                $id(`${prefix}RelayName${position}`).value = "";
                resetRelayUserCheck(prefix, position);
                return;
              }
              const button = event.target.closest("[data-relay-user-check]");
              if(!button) return;
              checkRelayUser(button.dataset.prefix, Number(button.dataset.position));
            });

            document.addEventListener("input", (event) => {
              const input = event.target.closest("[data-relay-user-input]");
              if(!input) return;
              resetRelayUserCheck(input.dataset.prefix, Number(input.dataset.position));
            });

            on("tabSuccess","click", () => load("SUCCESS"));
            on("tabWaiting","click", () => load("WAITING"));
            on("tabCapacity","click", () => alert(IS_RELAY
              ? "Số chỗ còn lại = Số đội dự kiến - Tổng số đăng ký đội tiếp sức."
              : "Số chỗ còn lại = Số đội dự kiến - Số đội đăng ký thành công."));

            on("btnSearch", "click", applySearchFilter);
            on("btnClearSearch", "click", () => {
              const input = $id("q");
              if(input) input.value = "";
              applySearchFilter();
              input?.focus();
            });
            on("q", "keydown", event => {
              if(event.key !== "Enter") return;
              event.preventDefault();
              window.clearTimeout(SEARCH_TIMER);
              applySearchFilter();
            });
            on("q", "input", () => {
              window.clearTimeout(SEARCH_TIMER);
              SEARCH_TIMER = window.setTimeout(applySearchFilter, 220);
            });

            on("btnOpenCreate","click", () => {
              clearCreateErr();
              $id("formCreate")?.reset();

              if(IS_RELAY){
                if($id("relayCreateTeamName")) $id("relayCreateTeamName").value = "";
                if($id("relayCreateCaptainId")) $id("relayCreateCaptainId").value = "";
                renderRelayMemberEditors("relayCreateMembers", "create", [], false);
                renderRelayReserveEditors("Create", []);
              }

              if($id("p1Type")) $id("p1Type").value = "USER";
              if($id("p2Type")) $id("p2Type").value = "USER";
              applyPlayerTypeUI(1);
              applyPlayerTypeUI(2);

              setAvatarBox("p1AvatarBox", null);
              setAvatarBox("p2AvatarBox", null);

              if($id("doubleMode")) $id("doubleMode").value = "PAIR";
              applyModeUI();
              applyTournamentModeUI();

              $("#modalCreate").modal("show");
            });

            on("gameType","change", applyModeUI);
            on("doubleMode","change", applyModeUI);

            on("p1Type","change", () => applyPlayerTypeUI(1));
            on("p2Type","change", () => applyPlayerTypeUI(2));

            on("btnP1Check","click", () => checkUser(1));
            on("btnP2Check","click", () => checkUser(2));

            on("p1GuestAvatarFile","change", () => previewGuestAvatar(1));
            on("p2GuestAvatarFile","change", () => previewGuestAvatar(2));

            on("e1Type","change", () => applyEditPlayerTypeUI(1));
            on("e2Type","change", () => applyEditPlayerTypeUI(2));

            on("btnE1Check","click", () => checkEditUser(1));
            on("btnE2Check","click", () => checkEditUser(2));

            on("e1GuestAvatarFile","change", () => previewEditGuestAvatar(1));
            on("e2GuestAvatarFile","change", () => previewEditGuestAvatar(2));

            on("btnConfirmDeleteRegistration", "click", confirmDeleteRegistration);
            on("btnConfirmCashPayment", "click", confirmCashPayment);
            on("btnCloseRegistrationNotice", "click", hideRegistrationNotice);

            $("#modalDeleteRegistration")
              .on("shown.bs.modal", function(){
                $id("btnCancelDeleteRegistration")?.focus();
              })
              .on("hide.bs.modal", function(event){
                if(DELETE_REGISTRATION.submitting){
                  event.preventDefault();
                }
              })
              .on("hidden.bs.modal", resetDeleteRegistrationModal);

            $("#modalCashPaymentConfirmation")
              .on("shown.bs.modal", function(){
                $id("btnCancelCashPayment")?.focus();
              })
              .on("hide.bs.modal", function(event){
                if(CASH_PAYMENT_CONFIRMATION.submitting){
                  event.preventDefault();
                }
              })
              .on("hidden.bs.modal", function(){
                resetCashPaymentConfirmation();
                if($("#modalPaymentInfo").hasClass("show")){
                  document.body.classList.add("modal-open");
                }
              });

            $("#modalPaymentInfo").on("hidden.bs.modal", cleanupActivePayment);
            $("#modalCancelPaymentConfirmation").on("hidden.bs.modal", function(){
              if($("#modalPaymentInfo").hasClass("show")){
                document.body.classList.add("modal-open");
              }
            });
            window.addEventListener("pagehide", cleanupActivePayment);

            on("formPair","submit", async (e) => {
              e.preventDefault();
              const baseId = Number($id("pairBaseId")?.value || 0);
              const withId = Number($id("pairWith")?.value || 0);
              try{
                await axios.post(`/api/admin/registrations/${baseId}/pair`, { withWaitingRegistrationId: withId });
                $("#modalPair").modal("hide");
                await load(CURRENT_TAB);
              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Ghép đôi thất bại.";
                const box = $id("pairErr");
                if(box){
                  box.textContent = msg;
                  box.classList.remove("d-none");
                }
              }
            });

            on("formEditTeam","submit", async (e) => {
              e.preventDefault();
              clearEditErr();

              const id = Number($id("editRegistrationId")?.value || 0);
              const btn = $id("btnEditSubmit");
              if(btn){
                btn.disabled = true;
                btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Saving...`;
              }

              try{
                const fd = buildEditFormData();
                await axios.put(`/api/admin/registrations/${id}/players`, fd);
                $("#modalEditTeam").modal("hide");
                await load(CURRENT_TAB);
              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Cập nhật đội thất bại.";
                showEditErr(msg);
              } finally {
                if(btn){
                  btn.disabled = false;
                  btn.innerHTML = `<i class="fas fa-save"></i> Lưu đội`;
                }
              }
            });

            on("formCreate","submit", async (e) => {
              e.preventDefault();
              clearCreateErr();

              const btn = $id("btnCreateSubmit");
              if(btn){
                btn.disabled = true;
                btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Saving...`;
              }

              try{
                const fd = buildFormData();

                await axios.post(`/api/admin/tournaments/${TOURNAMENT_ID}/registrations`, fd, {
                });

                $("#modalCreate").modal("hide");
                window.location.reload();

              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Tạo đăng ký thất bại.";
                showCreateErr(msg);
              } finally {
                if(btn){
                  btn.disabled = false;
                  btn.innerHTML = `<i class="fas fa-save"></i> Đăng ký`;
                }
              }
            });

            await load("SUCCESS");
          });
        })();
    </script>
}
