@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách đăng ký";
    var tid = (long)(ViewBag.TournamentId ?? 0L);
}

<style>
    .pill {
        border-radius: 999px;
    }

    .player-card {
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 12px;
        background: #fff;
        height: 100%;
    }

    .avatar-preview {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #ddd;
    }

    .avatar-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 1px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-weight: 700;
    }

    .registration-toolbar {
        gap: 8px;
    }

    .registration-filter-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        width: 100%;
    }

        .registration-filter-toolbar .filter-keyword {
            flex: 1 1 320px;
            min-width: 220px;
        }

        .registration-filter-toolbar .filter-action {
            flex: 0 0 auto;
        }

    .player-head-tools {
        gap: 8px;
        align-items: center;
    }

    .player-body-wrap {
        gap: 12px;
        align-items: center;
    }

    .player-avatar-col {
        flex: 0 0 auto;
    }

    .player-form-col {
        flex: 1 1 auto;
        min-width: 0;
    }

    .payment-status-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .payment-info-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 10px;
    }

    .payment-info-row {
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 10px 12px;
        background: #fff;
    }

    .payment-info-row span {
        display: block;
        font-size: 12px;
        color: #858796;
        margin-bottom: 4px;
    }

    .payment-info-row b {
        display: block;
        color: #3a3b45;
        overflow-wrap: anywhere;
    }

    .payment-qr-img {
        width: 180px;
        max-width: 100%;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        background: #fff;
        padding: 8px;
    }

    @@media (max-width: 991.98px) {
        .card-header-responsive {
            flex-direction: column;
            align-items: stretch !important;
            gap: 12px;
        }

            .card-header-responsive h6 {
                margin-bottom: 0;
            }

        .registration-filter-toolbar .filter-keyword,
        .registration-filter-toolbar .filter-action {
            flex: 1 1 100%;
            min-width: 100%;
        }

        .registration-filter-toolbar .btn {
            width: 100%;
        }
    }

    @@media (max-width: 767.98px) {
        .player-head {
            flex-direction: column;
            align-items: stretch !important;
            gap: 10px;
        }

        .player-head-tools {
            width: 100%;
            justify-content: space-between;
        }

            .player-head-tools label {
                margin-bottom: 0;
            }

            .player-head-tools select {
                flex: 1 1 auto;
                max-width: 180px;
            }

        .player-body-wrap {
            flex-direction: column;
            align-items: flex-start;
        }

        .player-form-col {
            width: 100%;
        }

        .payment-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .page-title-bar {
            gap: 12px;
        }

            .page-title-bar > div:last-child {
                width: 100%;
            }

        .registration-toolbar {
            display: flex;
            flex-wrap: wrap;
            width: 100%;
        }

            .registration-toolbar > * {
                flex: 1 1 calc(50% - 4px);
            }

        .tabs-toolbar {
            gap: 8px !important;
        }

            .tabs-toolbar .btn {
                flex: 1 1 100%;
            }

        .player-head-tools {
            flex-wrap: wrap;
            gap: 8px;
        }

            .player-head-tools select {
                flex: 1 1 100%;
                max-width: 100%;
            }
    }
</style>

<div class="container-fluid" id="pageRoot" data-tournament-id="@tid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3 page-title-bar">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Danh sách đăng ký</h1>
            <div class="small text-muted" id="tournamentMeta">Giải đấu #@tid</div>
        </div>

        <div>
            <div class="d-flex registration-toolbar">
                <button class="btn btn-sm btn-primary shadow-sm" type="button" id="btnOpenCreate">
                    <i class="fas fa-plus fa-sm text-white-50"></i> Đăng ký cho vận động viên
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="/Home/Tournaments">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Tabs counts -->
    <div class="mb-3 d-flex flex-wrap tabs-toolbar" style="gap:10px">
        <button class="btn btn-sm pill" id="tabSuccess">Thành công</button>
        <button class="btn btn-sm pill" id="tabWaiting">Chờ ghép</button>
        <button class="btn btn-sm pill btn-outline-secondary" id="tabCapacity">Còn chỗ</button>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between card-header-responsive">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách đăng ký</h6>

            <div class="registration-filter-toolbar">
                <div class="filter-keyword">
                    <input id="q" class="form-control form-control-sm w-100" placeholder="Tìm tên / mã ĐK ..." />
                </div>
                <div class="filter-action">
                    <button class="btn btn-sm btn-outline-primary" type="button" id="btnSearch">Tìm kiếm</button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th style="width:160px">Mã ĐK</th>
                            <th style="width:160px">Thời gian</th>
                            <th>VĐV 1</th>
                            <th>VĐV 2</th>
                            <th style="width:90px">Điểm</th>
                            <th style="width:110px">Mã BT</th>
                            <th style="width:80px">Thanh toán</th>
                            <th style="width:220px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="body">
                        <tr><td colspan="9" class="text-center text-muted">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create -->
<div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <form id="formCreate">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm đăng ký</h5>
                    <button class="close" type="button" data-dismiss="modal"><span aria-hidden="true">×</span></button>
                </div>

                <div class="modal-body">
                    <div id="createErr" class="alert alert-danger d-none"></div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Loại thi đấu</label>
                            <select class="form-control" id="gameType">
                                <option value="SINGLE">ĐẤU ĐƠN</option>
                                <option value="DOUBLE" selected>ĐẤU ĐÔI</option>
                            </select>
                            <small class="text-muted">Loại thi đấu sẽ tự động khóa theo cấu hình của giải.</small>
                        </div>

                        <div class="form-group col-md-4">
                            <label>Trạng thái (Đủ - Chờ Ghép)</label>
                            <select class="form-control" id="doubleMode">
                                <option value="PAIR" selected>Đủ cặp</option>
                                <option value="WAITING">Chờ ghép</option>
                            </select>
                        </div>

                        <div class="form-group col-md-4">
                            <label>Thanh Toán</label>
                            <select class="form-control" id="paid">
                                <option value="false" selected>Chưa Thanh Toán</option>
                                <option value="true">Đã Thanh Toán</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Mã chuyển khoản (tùy chọn)</label>
                            <input class="form-control" id="btCode" placeholder="Nhập mã chuyển khoản..." />
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <!-- Player 1 -->
                        <div class="col-lg-6 mb-3">
                            <div class="player-card">
                                <div class="d-flex align-items-center justify-content-between mb-2 player-head">
                                    <h6 class="text-primary font-weight-bold mb-0">VĐV 1</h6>
                                    <div class="d-flex player-head-tools">
                                        <label class="mb-0 small text-muted">Loại tài khoản</label>
                                        <select class="form-control form-control-sm" id="p1Type" style="width:120px;">
                                            <option value="USER" selected>Người dùng hệ thống</option>
                                            <option value="GUEST">Khách</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex player-body-wrap">
                                    <div class="player-avatar-col" id="p1AvatarBox"><div class="avatar-placeholder">?</div></div>

                                    <div class="player-form-col">
                                        <!-- USER block -->
                                        <div id="p1UserBlock">
                                            <div class="form-row">
                                                <div class="form-group col-md-7 mb-2">
                                                    <label class="small text-muted">ID người dùng</label>
                                                    <input class="form-control" id="p1UserId" placeholder="123" />
                                                </div>
                                                <div class="form-group col-md-5 mb-2 d-flex align-items-end">
                                                    <button class="btn btn-outline-primary btn-block" type="button" id="btnP1Check">
                                                        <i class="fas fa-check"></i> Check
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="small text-muted" id="p1UserInfo">Chưa kiểm tra</div>
                                        </div>

                                        <!-- GUEST block -->
                                        <div id="p1GuestBlock" style="display:none;">
                                            <div class="form-row">
                                                <div class="form-group col-md-7 mb-2">
                                                    <label class="small text-muted">Họ tên *</label>
                                                    <input class="form-control" id="p1GuestName" placeholder="Tên vận động viên 1" />
                                                </div>
                                                <div class="form-group col-md-5 mb-2">
                                                    <label class="small text-muted">Điểm trình *</label>
                                                    <input type="number" step="0.01" class="form-control" id="p1GuestLevel" value="2.50" />
                                                </div>
                                            </div>

                                            <div class="form-group mb-0">
                                                <label class="small text-muted">Ảnh đại diện (chọn tệp)</label>
                                                <input type="file" id="p1GuestAvatarFile" accept="image/*" class="form-control" />
