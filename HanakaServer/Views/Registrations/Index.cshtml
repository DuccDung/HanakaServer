                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Player 2 -->
                        <div class="col-lg-6 mb-3" id="p2Wrap">
                            <div class="player-card">
                                <div class="d-flex align-items-center justify-content-between mb-2 player-head">
                                    <h6 class="text-primary font-weight-bold mb-0">VĐV 2</h6>
                                    <div class="d-flex player-head-tools">
                                        <label class="mb-0 small text-muted">Loại tài khoản</label>
                                        <select class="form-control form-control-sm" id="p2Type" style="width:120px;">
                                            <option value="USER" selected>Người dùng hệ thống</option>
                                            <option value="GUEST">Khách</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="d-flex player-body-wrap">
                                    <div class="player-avatar-col" id="p2AvatarBox"><div class="avatar-placeholder">?</div></div>

                                    <div class="player-form-col">
                                        <!-- USER block -->
                                        <div id="p2UserBlock">
                                            <div class="form-row">
                                                <div class="form-group col-md-7 mb-2">
                                                    <label class="small text-muted">ID người dùng</label>
                                                    <input class="form-control" id="p2UserId" placeholder="456" />
                                                </div>
                                                <div class="form-group col-md-5 mb-2 d-flex align-items-end">
                                                    <button class="btn btn-outline-primary btn-block" type="button" id="btnP2Check">
                                                        <i class="fas fa-check"></i> Check
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="small text-muted" id="p2UserInfo">Chưa kiểm tra</div>
                                        </div>

                                        <!-- GUEST block -->
                                        <div id="p2GuestBlock" style="display:none;">
                                            <div class="form-row">
                                                <div class="form-group col-md-7 mb-2">
                                                    <label class="small text-muted">Họ tên *</label>
                                                    <input class="form-control" id="p2GuestName" placeholder="Tên vận động viên 2" />
                                                </div>
                                                <div class="form-group col-md-5 mb-2">
                                                    <label class="small text-muted">Điểm trình *</label>
                                                    <input type="number" step="0.01" class="form-control" id="p2GuestLevel" value="2.50" />
                                                </div>
                                            </div>

                                            <div class="form-group mb-0">
                                                <label class="small text-muted">Ảnh đại diện (chọn tệp)</label>
                                                <input type="file" id="p2GuestAvatarFile" accept="image/*" class="form-control" />
                                                <small class="text-muted">jpg/png/webp • tối đa 10 MB</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                    <button class="btn btn-primary" type="submit" id="btnCreateSubmit">
                        <i class="fas fa-save"></i> Đăng ký
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Payment Info -->
<div class="modal fade" id="modalPaymentInfo" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentInfoTitle">Thông tin thanh toán</h5>
                <button class="close" type="button" data-dismiss="modal"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body" id="paymentInfoBody">
                <div class="text-center text-muted py-4">
                    <i class="fas fa-spinner fa-spin"></i> Đang tải...
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

