          async function confirmDeleteRegistration(){
            const registrationId = Number(DELETE_REGISTRATION.registrationId || 0);
            const errorBox = $id("deleteRegistrationError");
            if(!registrationId || DELETE_REGISTRATION.submitting) return;

            setDeleteRegistrationSubmitting(true);

            let result;

            try{
              const response = await axios.delete(`/api/admin/registrations/${registrationId}`);
              result = response.data || {};
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể xóa đăng ký.";
              if(errorBox){
                errorBox.textContent = msg;
                errorBox.classList.remove("d-none");
              }
              setDeleteRegistrationSubmitting(false);
              return;
            }

            const deletedRegCode = DELETE_REGISTRATION.regCode;
            setDeleteRegistrationSubmitting(false);
            $("#modalDeleteRegistration").modal("hide");

            const deletedPaymentCount = Number(result.deletedPaymentCount || 0);
            const detachedWebhookCount = Number(result.detachedWebhookCount || 0);
            const detachedPairRequestCount = Number(result.detachedPairRequestCount || 0);
            const details = [];
            if(deletedPaymentCount) details.push(`đã dọn ${deletedPaymentCount} giao dịch chưa thành công`);
            if(detachedWebhookCount) details.push(`giữ lại ${detachedWebhookCount} webhook đối soát`);
            if(detachedPairRequestCount) details.push(`ngắt ${detachedPairRequestCount} yêu cầu ghép đôi`);

            try{
              await load(CURRENT_TAB);
              showRegistrationNotice(
                "success",
                `Đã xóa ${deletedRegCode}`,
                details.length ? details.join("; ") + "." : "Đăng ký đã được xóa an toàn."
              );
            } catch(_error){
              showRegistrationNotice(
                "success",
                `Đã xóa ${deletedRegCode}`,
                "Đăng ký đã được xóa. Vui lòng tải lại trang để cập nhật danh sách."
              );
            }
          }

