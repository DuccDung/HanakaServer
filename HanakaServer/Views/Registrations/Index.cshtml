@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách đăng ký";
    var tid = (long)(ViewBag.TournamentId ?? 0L);
}

<style>
    .pill {
        border-radius: 999px;
    }

    .player-card {
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 12px;
        background: #fff;
        height: 100%;
    }

    .avatar-preview {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #ddd;
    }

    .avatar-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 1px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-weight: 700;
    }

    .registration-toolbar {
        gap: 8px;
    }

    .registration-filter-toolbar {
        display: flex;
        flex: 1 1 360px;
        flex-wrap: nowrap;
        gap: 8px;
        align-items: center;
        min-width: 0;
    }

        .registration-filter-toolbar .filter-keyword {
            flex: 1 1 220px;
            min-width: 0;
        }

        .registration-filter-toolbar .filter-action {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            white-space: nowrap;
        }

    .player-head-tools {
        gap: 8px;
        align-items: center;
    }

    .player-body-wrap {
        gap: 12px;
        align-items: center;
    }

    .player-avatar-col {
        flex: 0 0 auto;
    }

    .player-form-col {
        flex: 1 1 auto;
        min-width: 0;
    }

    .payment-status-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .payment-info-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 10px;
    }

    .payment-info-row {
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 10px 12px;
        background: #fff;
    }

    .payment-info-row span {
        display: block;
        font-size: 12px;
        color: #858796;
        margin-bottom: 4px;
    }

    .payment-info-row b {
        display: block;
        color: #3a3b45;
        overflow-wrap: anywhere;
    }

    .payment-qr-img {
        width: 180px;
        max-width: 100%;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        background: #fff;
        padding: 8px;
    }

    .registration-notice {
        position: fixed;
        top: 84px;
        right: 24px;
        z-index: 1090;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        width: min(390px, calc(100vw - 32px));
        padding: 14px 16px;
        border: 1px solid #d1e7dd;
        border-left: 4px solid #1cc88a;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 12px 32px rgba(58, 59, 69, 0.18);
        opacity: 0;
        pointer-events: none;
        transform: translateY(-12px);
        transition: opacity 180ms ease, transform 180ms ease;
    }

    .registration-notice.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .registration-notice.is-danger {
        border-color: #f5c6cb;
        border-left-color: #e74a3b;
    }

    .registration-notice-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: #13855c;
        background: #d1f2e5;
    }

    .registration-notice.is-danger .registration-notice-icon {
        color: #be2617;
        background: #fce3e1;
    }

    .registration-notice-content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .registration-notice-title {
        color: #3a3b45;
        font-weight: 700;
        line-height: 1.25;
    }

    .registration-notice-message {
        margin-top: 3px;
        color: #6e707e;
        font-size: 13px;
        line-height: 1.45;
    }

    .delete-registration-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 20px 55px rgba(58, 59, 69, 0.28);
    }

    .delete-registration-modal .modal-header {
        align-items: flex-start;
        padding: 22px 24px 16px;
        border-bottom: 0;
    }

    .delete-registration-modal .modal-body {
        padding: 0 24px 22px;
    }

    .delete-registration-modal .modal-footer {
        padding: 16px 24px;
        border-top-color: #eaecf4;
        background: #f8f9fc;
    }

    .delete-registration-heading {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding-right: 24px;
    }

    .delete-registration-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        color: #be2617;
        background: #fce3e1;
        font-size: 18px;
    }

    .delete-registration-subtitle {
        margin-top: 4px;
        color: #858796;
        font-size: 13px;
        line-height: 1.45;
    }

    .delete-registration-summary {
        display: grid;
        grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 14px;
    }

    .delete-registration-summary-item {
        padding: 12px 14px;
        border: 1px solid #e3e6f0;
        border-radius: 10px;
        background: #fff;
    }

    .delete-registration-summary-label {
        margin-bottom: 4px;
        color: #858796;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .delete-registration-summary-value {
        color: #3a3b45;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .delete-registration-warning {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 14px;
        border: 1px solid #f6d98f;
        border-radius: 10px;
        color: #745000;
        background: #fff8e5;
        font-size: 13px;
        line-height: 1.5;
    }

    .delete-registration-warning i {
        margin-top: 3px;
        color: #d39e00;
    }

    .delete-registration-error {
        border-radius: 10px;
        font-size: 13px;
    }

    .cash-payment-confirmation-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 20px 55px rgba(58, 59, 69, 0.28);
    }

    .cash-payment-confirmation-modal .modal-header {
        align-items: flex-start;
        padding: 22px 24px 16px;
        border-bottom: 0;
    }

    .cash-payment-confirmation-modal .modal-body {
        padding: 0 24px 22px;
    }

    .cash-payment-confirmation-modal .modal-footer {
        padding: 16px 24px;
        border-top-color: #eaecf4;
        background: #f8f9fc;
    }

    .cash-payment-confirmation-heading {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding-right: 24px;
    }

    .cash-payment-confirmation-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        color: #13855c;
        background: #d9f3e8;
        font-size: 18px;
    }

    .cash-payment-confirmation-subtitle {
        margin-top: 4px;
        color: #858796;
        font-size: 13px;
        line-height: 1.45;
    }

    .cash-payment-confirmation-summary {
        display: grid;
        grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 14px;
    }

    .cash-payment-confirmation-summary-item {
        padding: 12px 14px;
        border: 1px solid #e3e6f0;
        border-radius: 10px;
        background: #fff;
    }

    .cash-payment-confirmation-summary-item.is-wide {
        grid-column: 1 / -1;
    }

    .cash-payment-confirmation-summary-label {
        margin-bottom: 4px;
        color: #858796;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .cash-payment-confirmation-summary-value {
        color: #3a3b45;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .cash-payment-confirmation-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 14px;
        border: 1px solid #b8dfcf;
        border-radius: 10px;
        color: #0f6848;
        background: #edf9f4;
        font-size: 13px;
        line-height: 1.5;
    }

    .cash-payment-confirmation-note i {
        margin-top: 3px;
        color: #1cc88a;
    }

    .cash-payment-confirmation-error {
        border-radius: 10px;
        font-size: 13px;
    }

    @@media (max-width: 991.98px) {
        .card-header-responsive {
            flex-direction: column;
            align-items: stretch !important;
            gap: 12px;
        }

            .card-header-responsive h6 {
                margin-bottom: 0;
            }

        .registration-filter-toolbar {
            flex: 0 0 auto;
            width: 100%;
        }
    }

    @@media (max-width: 767.98px) {
        .player-head {
            flex-direction: column;
            align-items: stretch !important;
            gap: 10px;
        }

        .player-head-tools {
            width: 100%;
            justify-content: space-between;
        }

            .player-head-tools label {
                margin-bottom: 0;
            }

            .player-head-tools select {
                flex: 1 1 auto;
                max-width: 180px;
            }

        .player-body-wrap {
            flex-direction: column;
            align-items: flex-start;
        }

        .player-form-col {
            width: 100%;
        }

        .payment-info-grid {
            grid-template-columns: 1fr;
        }

        .delete-registration-summary {
            grid-template-columns: 1fr;
        }

        .cash-payment-confirmation-summary {
            grid-template-columns: 1fr;
        }

        .cash-payment-confirmation-summary-item.is-wide {
            grid-column: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .registration-notice {
            top: 72px;
            right: 16px;
        }

        .delete-registration-modal .modal-header,
        .delete-registration-modal .modal-body,
        .delete-registration-modal .modal-footer {
            padding-left: 18px;
            padding-right: 18px;
        }

        .delete-registration-modal .modal-footer {
            flex-direction: column-reverse;
        }

        .delete-registration-modal .modal-footer .btn {
            width: 100%;
            margin: 4px 0 0;
        }

        .cash-payment-confirmation-modal .modal-header,
        .cash-payment-confirmation-modal .modal-body,
        .cash-payment-confirmation-modal .modal-footer {
            padding-left: 18px;
            padding-right: 18px;
        }

        .cash-payment-confirmation-modal .modal-footer {
            flex-direction: column-reverse;
        }

        .cash-payment-confirmation-modal .modal-footer .btn {
            width: 100%;
            margin: 4px 0 0;
        }

        .page-title-bar {
            gap: 12px;
        }

            .page-title-bar > div:last-child {
                width: 100%;
            }

        .registration-toolbar {
            display: flex;
            flex-wrap: wrap;
            width: 100%;
        }

            .registration-toolbar > * {
                flex: 1 1 calc(50% - 4px);
            }

        .tabs-toolbar {
            gap: 8px !important;
        }

            .tabs-toolbar .btn {
                flex: 1 1 100%;
            }

        .player-head-tools {
            flex-wrap: wrap;
            gap: 8px;
        }

            .player-head-tools select {
                flex: 1 1 100%;
                max-width: 100%;
            }
    }
    .relay-roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1rem;
    }

    .relay-reserve-editor summary { cursor: pointer; font-weight: 600; padding: 8px 0; }
    .relay-reserve-editor summary span { font-size: 12px; font-weight: 400; }
    .relay-reserve-list { margin-top: 12px; padding-top: 10px; border-top: 1px solid #e3e6f0; }
    .relay-reserve-list .relay-team-card__roster-head { margin-bottom: 6px; }
    .relay-reserve-list .relay-pair-member__position { min-width: 30px; width: auto; border-radius: 4px; padding: 0 3px; }

    .relay-pair-editor {
        overflow: hidden;
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(58, 59, 69, .06);
    }

    .relay-pair-editor.is-locked {
        background: #f1f5f9;
    }

    .relay-pair-editor__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 14px;
        border-bottom: 1px solid #e8edf5;
        color: #2947a9;
        background: #f4f7ff;
    }

    .relay-pair-editor__head small {
        color: #6e7891;
        font-weight: 600;
    }

    .relay-athlete-editor {
        padding: 13px 14px 14px;
        background: #fff;
    }

    .relay-athlete-editor + .relay-athlete-editor {
        border-top: 1px dashed #dbe4f0;
    }

    .relay-athlete-editor.is-locked {
        background: #f8fafc;
    }

    .relay-athlete-editor__title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 9px;
        color: #3a3b45;
        font-size: 13px;
        font-weight: 700;
    }

    .relay-athlete-editor__position {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        color: #4e73df;
        background: #eaf0ff;
        font-size: 11px;
    }

    .relay-user-check-button {
        white-space: nowrap;
    }

    .relay-user-check-status {
        display: block;
        min-height: 1.25rem;
        margin-top: .35rem;
    }

    .relay-lineup-list {
        display: grid;
        gap: .35rem;
    }

    .registration-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        padding: 20px 22px;
        border: 1px solid #dfe6f3;
        border-radius: 18px;
        background: linear-gradient(135deg, #ffffff 0%, #f5f8ff 100%);
        box-shadow: 0 8px 24px rgba(58, 59, 69, .07);
    }

    .registration-page-header__eyebrow {
        margin-bottom: 4px;
        color: #4e73df;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .registration-page-header h1 {
        font-size: 24px;
        font-weight: 800;
        line-height: 1.25;
    }

    .registration-page-header__meta {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 7px;
        color: #6e707e;
        font-size: 13px;
        line-height: 1.45;
    }

    .registration-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .registration-summary__item {
        position: relative;
        overflow: hidden;
        min-height: 92px;
        padding: 15px 16px;
        border: 1px solid #e3e8f2;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 5px 16px rgba(58, 59, 69, .05);
    }

    .registration-summary__item::after {
        position: absolute;
        top: 0;
        right: 0;
        width: 4px;
        height: 100%;
        content: "";
        background: var(--summary-color, #4e73df);
    }

    .registration-summary__label {
        display: block;
        margin-bottom: 7px;
        color: #7a8192;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .registration-summary__value {
        color: #2d3348;
        font-size: 24px;
        font-weight: 800;
        line-height: 1;
    }

    .registration-summary__hint {
        margin-top: 7px;
        color: #858796;
        font-size: 12px;
    }

    .registration-list-card {
        overflow: hidden;
        border: 1px solid #e2e7f0;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(58, 59, 69, .07) !important;
    }

    .registration-list-card .card-header {
        gap: 16px;
        padding: 15px 18px !important;
        border-bottom: 1px solid #e8ecf3;
        background: #fff;
    }

    .registration-list-card .card-body {
        padding: 18px;
        background: #f8f9fc;
    }

    .registration-list-heading {
        flex: 0 1 auto;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .registration-list-heading small {
        display: block;
        margin-top: 3px;
        color: #858796;
        font-weight: 400;
    }

    .registration-filter-toolbar .input-group {
        flex-wrap: nowrap;
        border-radius: .35rem;
    }

    .registration-filter-toolbar .input-group:focus-within {
        box-shadow: 0 0 0 .15rem rgba(78, 115, 223, .2);
    }

    .registration-filter-toolbar .input-group-text {
        min-height: 40px;
        border-right: 0;
        color: #858796;
        background: #fff;
    }

    .registration-filter-toolbar .filter-keyword input {
        height: 40px;
        min-height: 40px;
        border-left: 0;
        box-shadow: none;
    }

    .registration-filter-toolbar .filter-keyword input:focus {
        border-color: #d1d3e2;
    }

    .registration-tabs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        margin-bottom: 14px;
    }

    .registration-tabs__label {
        margin-right: 3px;
        color: #6e707e;
        font-size: 12px;
        font-weight: 700;
    }

    .registration-tabs .btn {
        min-height: 36px;
        padding: 7px 14px;
        font-weight: 700;
    }

    .relay-team-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .relay-team-card {
        overflow: hidden;
        border: 1px solid #dfe5ef;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 5px 18px rgba(58, 59, 69, .06);
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    .relay-team-card:hover {
        border-color: #b9c8f5;
        box-shadow: 0 10px 24px rgba(58, 59, 69, .11);
        transform: translateY(-1px);
    }

    .relay-team-card.is-locked {
        border-top: 4px solid #1cc88a;
    }

    .relay-team-card.is-ready {
        border-top: 4px solid #f6c23e;
    }

    .relay-team-card.is-incomplete {
        border-top: 4px solid #e74a3b;
    }

    .relay-team-card__head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 17px 13px;
        border-bottom: 1px solid #edf0f5;
    }

    .relay-team-card__identity {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        min-width: 0;
    }

    .relay-team-card__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        color: #4e73df;
        background: #edf2ff;
        font-weight: 800;
    }

    .relay-team-card__title {
        margin: 0;
        color: #2d3348;
        font-size: 16px;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .relay-team-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px 12px;
        margin-top: 5px;
        color: #858796;
        font-size: 11px;
    }

    .relay-team-card__status {
        flex: 0 0 auto;
        border-radius: 999px;
        padding: 6px 9px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .relay-team-card__status.is-locked {
        color: #0f704f;
        background: #dff6ed;
    }

    .relay-team-card__status.is-ready {
        color: #795b05;
        background: #fff3cf;
    }

    .relay-team-card__status.is-incomplete {
        color: #a9281e;
        background: #fce5e3;
    }

    .relay-team-card__body {
        padding: 14px 17px 16px;
    }

    .relay-team-card__roster-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        color: #5a5c69;
        font-size: 12px;
        font-weight: 700;
    }

    .relay-pair-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
        gap: 9px;
    }

    .relay-pair-card {
        overflow: hidden;
        border: 1px solid #e1e6ef;
        border-radius: 11px;
        background: #fbfcfe;
    }

    .relay-pair-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 10px;
        color: #3956b4;
        background: #f0f4ff;
        font-size: 11px;
        font-weight: 800;
    }

    .relay-pair-member {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        padding: 10px;
    }

    .relay-pair-member + .relay-pair-member {
        border-top: 1px dashed #e0e5ee;
    }

    .relay-pair-member__avatar {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        color: #4e73df;
        background: #e9efff;
        font-size: 14px;
        font-weight: 800;
    }

    .relay-pair-member__avatar img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
    }

    .relay-pair-member__position {
        position: absolute;
