            $id("registrationNotice")?.classList.remove("is-visible");
          }

          function showRegistrationNotice(type, title, message){
            const notice = $id("registrationNotice");
            const titleElement = $id("registrationNoticeTitle");
            const messageElement = $id("registrationNoticeMessage");
            const icon = notice?.querySelector(".registration-notice-icon i");
            if(!notice || !titleElement || !messageElement) return;

            window.clearTimeout(REGISTRATION_NOTICE_TIMER);
            const isDanger = String(type || "").toLowerCase() === "danger";
            notice.classList.toggle("is-danger", isDanger);
            titleElement.textContent = title || (isDanger ? "Không thể thực hiện" : "Thành công");
            messageElement.textContent = message || "";
            if(icon){
              icon.className = isDanger ? "fas fa-exclamation" : "fas fa-check";
            }

            notice.classList.add("is-visible");
            REGISTRATION_NOTICE_TIMER = window.setTimeout(hideRegistrationNotice, 6500);
          }

