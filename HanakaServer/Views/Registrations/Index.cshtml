</div>

<!-- Modal Pair -->
<div class="modal fade" id="modalPair" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="formPair">
                <input type="hidden" id="pairBaseId" />
                <div class="modal-header">
                    <h5 class="modal-title">Ghép cặp</h5>
                    <button class="close" type="button" data-dismiss="modal"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div id="pairErr" class="alert alert-danger d-none"></div>
                    <div class="form-group">
                        <label>Chọn 1 đăng ký đang chờ ghép</label>
                        <select class="form-control" id="pairWith"></select>
                        <small class="text-muted">Chỉ hiển thị đăng ký đang chờ ghép và ưu tiên chọn người mới nhất.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-link"></i> Pair
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        (() => {
          const $id = (id) => document.getElementById(id);
          const on = (id, evt, handler) => { const el = $id(id); if (el) el.addEventListener(evt, handler); };

          const root = $id("pageRoot");
          const TOURNAMENT_ID = Number(root?.dataset?.tournamentId || 0);

          let CURRENT_TAB = "SUCCESS";
          let CACHE = { items: [], waiting: [] };
          let TOURNAMENT_GAME_TYPE = null; // "SINGLE" | "DOUBLE"
          let EDITING_REG = null;
          let ACTIVE_PAYMENT = { registrationId: 0, transactionCode: "", pollUrl: "", paid: false, pollTimer: null };
          const PAYMENT_RT = {
            ws: null,
            reconnectTimer: null,
            pingTimer: null,
            manualClose: false,
            payments: Object.create(null)
          };

          const API_LIST = `/api/admin/tournaments/${TOURNAMENT_ID}/registrations`;

          const esc = (s) => String(s || "").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
          const fmt = (dt) => {
            if(!dt) return "—";
            const d = new Date(dt);
            if(isNaN(d.getTime())) return "—";
            const yyyy=d.getFullYear(), mm=String(d.getMonth()+1).padStart(2,"0"), dd=String(d.getDate()).padStart(2,"0");
            const hh=String(d.getHours()).padStart(2,"0"), mi=String(d.getMinutes()).padStart(2,"0");
            return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
          };

          function avatarHtml(url){
            if(!url) return `<div class="avatar-placeholder">?</div>`;
            return `<img class="avatar-preview" src="${esc(url)}" />`;
          }

          function formatLevel(value){
            return (value === null || value === undefined || Number.isNaN(Number(value)))
              ? "—"
              : Number(value).toFixed(2);
          }

          function hasPlayer(name){
            return !!String(name || "").trim();
          }

          function getPickedLevel(singleLevel, doubleLevel, pickedLevel){
            if(TOURNAMENT_GAME_TYPE === "DOUBLE"){
              return doubleLevel ?? pickedLevel;
            }
            if(TOURNAMENT_GAME_TYPE === "SINGLE"){
              return singleLevel ?? pickedLevel;
            }
            return pickedLevel ?? doubleLevel ?? singleLevel;
          }

          function getTeamPoints(reg){
            const p1 = Number(getPickedLevel(reg.player1LevelSingle, reg.player1LevelDouble, reg.player1Level) || 0);
            if(TOURNAMENT_GAME_TYPE !== "DOUBLE"){
              return p1;
            }

            if(!hasPlayer(reg.player2Name)){
              return p1;
            }

            const p2 = Number(getPickedLevel(reg.player2LevelSingle, reg.player2LevelDouble, reg.player2Level) || 0);
            return p1 + p2;
          }

          function playerCell(name, singleLevel, doubleLevel, pickedLevel, avatar, verified){
            if(!hasPlayer(name)){
              return `<div class="small text-muted">—</div>`;
            }

            const badge = verified ? `<span class="badge badge-success ml-2">Đã xác minh</span>` : ``;
            const pickLabel = TOURNAMENT_GAME_TYPE === "DOUBLE" ? "Trình đôi áp dụng" : "Trình đơn áp dụng";
            const actualPickedLevel = getPickedLevel(singleLevel, doubleLevel, pickedLevel);

            const s = formatLevel(singleLevel);
            const d = formatLevel(doubleLevel);
            const p = formatLevel(actualPickedLevel);

            return `
              <div class="d-flex" style="gap:10px;align-items:center;">
                ${avatarHtml(avatar)}
                <div>
                  <div class="font-weight-bold text-gray-900">${esc(name||"—")}${badge}</div>
                  <div class="small text-muted">Đơn: ${s} • Đôi: ${d}</div>
                  <div class="small text-muted">${pickLabel}: ${p}</div>
                </div>
              </div>
            `;
          }

          async function togglePaid(id, paid){
            await axios.put(`/api/admin/registrations/${id}`, { paid });
          }

          async function delReg(id){
            if(!confirm("Xoá đăng ký này?")) return;
            try{
              await axios.delete(`/api/admin/registrations/${id}`);
              await load(CURRENT_TAB);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể xoá đăng ký.";
              alert(msg);
            }
          }

          async function syncLevels(id){
            try{
              await axios.post(`/api/admin/registrations/${id}/sync-levels`);
              await load(CURRENT_TAB);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể đồng bộ trình.";
              alert(msg);
            }
          }

          function infoValue(value){
            const text = String(value ?? "").trim();
            return text || "—";
          }

          function paymentInfoRow(label, value, strong){
            return `
              <div class="payment-info-row">
                <span>${esc(label)}</span>
                <b class="${strong ? "text-primary" : ""}">${esc(infoValue(value))}</b>
              </div>
            `;
          }

          function paymentQrHtml(url){
            if(!String(url || "").trim()) return "";
            return `
              <div class="text-center mb-3">
                <img class="payment-qr-img" src="${esc(url)}" alt="QR thanh toán" />
              </div>
            `;
          }

          function cashConfirmHtml(data){
            if(data?.isPaid) return "";

            return `
              <div class="mt-3">
                <button class="btn btn-success" type="button" onclick="confirmCashPayment(${Number(data?.registrationId || 0)})">
                  <i class="fas fa-money-bill-wave"></i> Xác nhận tiền mặt
                </button>
                <div class="small text-muted mt-2">Dùng khi khách đã thanh toán trực tiếp bằng tiền mặt.</div>
              </div>
            `;
          }

          function normalizePaymentCode(value){
            return String(value || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
          }

          function sendPaymentRealtime(payload){
            if(!PAYMENT_RT.ws || PAYMENT_RT.ws.readyState !== WebSocket.OPEN){
              connectPaymentRealtime();
              return false;
            }

            try{
              PAYMENT_RT.ws.send(JSON.stringify(payload));
              return true;
            } catch(_error){
              return false;
            }
          }

          function flushPaymentSubscriptions(){
            Object.keys(PAYMENT_RT.payments).forEach(function(code){
              if(!PAYMENT_RT.payments[code]) return;
              sendPaymentRealtime({ type: "payment.subscribe", transactionCode: code });
            });
          }

          function connectPaymentRealtime(){
            if(!("WebSocket" in window)) return false;
            if(PAYMENT_RT.ws && (
              PAYMENT_RT.ws.readyState === WebSocket.OPEN ||
              PAYMENT_RT.ws.readyState === WebSocket.CONNECTING
            )){
              return true;
            }

            const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
            PAYMENT_RT.manualClose = false;

            try{
              PAYMENT_RT.ws = new WebSocket(`${protocol}//${window.location.host}/ws-public`);
            } catch(_error){
              return false;
            }

            PAYMENT_RT.ws.addEventListener("open", function(){
              flushPaymentSubscriptions();
              window.clearInterval(PAYMENT_RT.pingTimer);
              PAYMENT_RT.pingTimer = window.setInterval(function(){
                sendPaymentRealtime({ type: "ping" });
              }, 25000);
            });

            PAYMENT_RT.ws.addEventListener("message", function(event){
              try{
                const message = JSON.parse(event.data);
                if(String(message?.type || "") === "tournament.payment.status.updated"){
                  handlePaymentStatusUpdated(message.payload || {}, "realtime");
                }
              } catch(_error){
              }
            });

            PAYMENT_RT.ws.addEventListener("close", function(){
              window.clearInterval(PAYMENT_RT.pingTimer);
              PAYMENT_RT.ws = null;

              if(!PAYMENT_RT.manualClose && Object.keys(PAYMENT_RT.payments).length){
                window.clearTimeout(PAYMENT_RT.reconnectTimer);
                PAYMENT_RT.reconnectTimer = window.setTimeout(connectPaymentRealtime, 2500);
              }
            });

            return true;
          }

          function subscribePaymentRealtime(transactionCode){
            const code = normalizePaymentCode(transactionCode);
            if(!code) return false;

            PAYMENT_RT.payments[code] = true;
            connectPaymentRealtime();
            return sendPaymentRealtime({ type: "payment.subscribe", transactionCode: code });
          }

          function unsubscribePaymentRealtime(transactionCode){
            const code = normalizePaymentCode(transactionCode);
            if(!code) return false;

            delete PAYMENT_RT.payments[code];
            return sendPaymentRealtime({ type: "payment.unsubscribe", transactionCode: code });
          }

          function cleanupActivePayment(){
            if(ACTIVE_PAYMENT.pollTimer){
              window.clearInterval(ACTIVE_PAYMENT.pollTimer);
              ACTIVE_PAYMENT.pollTimer = null;
            }

            if(ACTIVE_PAYMENT.transactionCode){
              unsubscribePaymentRealtime(ACTIVE_PAYMENT.transactionCode);
            }

            ACTIVE_PAYMENT = { registrationId: 0, transactionCode: "", pollUrl: "", paid: false, pollTimer: null };
          }

          function setPaymentModalLoading(){
            const body = $id("paymentInfoBody");
            if(body){
              body.innerHTML = `
                <div class="text-center text-muted py-4">
                  <i class="fas fa-spinner fa-spin"></i> Đang tải...
                </div>
              `;
            }
          }

          function renderPaymentInfo(data){
            const payment = data?.payment || {};
            const record = data?.paymentRecord || {};
            const manual = data?.manualPayment || {};
            const tournament = data?.tournament || {};
            const team = data?.team || {};
            const isPaid = !!data?.isPaid;

            const transactionCode = payment.transactionCode || record.transactionCode || "";
            const isCashPayment = !!data?.isCashPayment || !!record.isCashPayment || normalizePaymentCode(transactionCode).startsWith("MANUAL");
            const transferContent = payment.transferContent || record.transferContent || transactionCode;
            const amountText = isPaid
              ? (record.paidAmountText || manual.paidAmountText || payment.amountText || record.amountText || tournament.feeText)
              : (payment.amountText || record.amountText || tournament.feeText);
            const statusTitle = isCashPayment ? "Đã thanh toán tiền mặt" : (payment.statusTitle || manual.statusTitle || record.status || (isPaid ? "Đã thanh toán" : "Chưa thanh toán"));
            const statusDesc = isCashPayment ? "Admin đã xác nhận khách thanh toán trực tiếp bằng tiền mặt." : (payment.statusDescription || (isPaid ? "Thông tin thanh toán của khách." : "Chuyển khoản đúng số tiền và nội dung để hệ thống tự xác nhận."));
            const alertClass = isPaid ? "alert-success" : "alert-warning";

            const qrUrl = payment.qrImageUrl || record.qrImageUrl || "";
            const paidAtText = payment.paidAtText || record.paidAtText || manual.paidAtText;

            const paymentRows = isPaid
              ? (isCashPayment ? [
                  paymentInfoRow("Phương thức", "Tiền mặt", true),
                  paymentInfoRow("Số tiền khách thanh toán", amountText, true),
                  paymentInfoRow("Thời gian xác nhận", paidAtText, false),
                  paymentInfoRow("Mã xác nhận", transactionCode, false)
                ] : [
                  paymentInfoRow("Số tiền khách thanh toán", amountText, true),
                  paymentInfoRow("Thời gian thanh toán", paidAtText, false),
                  paymentInfoRow("Mã Sepay", transactionCode, true),
                  paymentInfoRow("Mã giao dịch ngân hàng", record.providerTransactionId, false),
                  paymentInfoRow("Ngân hàng", payment.receiverBankShortName || record.bankCode, false),
                  paymentInfoRow("Tài khoản nhận", payment.receiverAccountNumber || record.bankAccountNo, false)
                ]).join("")
              : [
                  paymentInfoRow("Số tiền cần thanh toán", amountText, true),
                  paymentInfoRow("Mã Sepay", transactionCode, true),
                  paymentInfoRow("Nội dung chuyển khoản", transferContent, true),
                  paymentInfoRow("Ngân hàng", payment.receiverBankShortName || record.bankCode, false),
                  paymentInfoRow("Số tài khoản", payment.receiverAccountNumber || record.bankAccountNo, true),
                  paymentInfoRow("Chủ tài khoản", payment.receiverAccountName || record.bankAccountName, false),
                  paymentInfoRow("Hết hạn", payment.expiresAt ? new Date(payment.expiresAt).toLocaleString("vi-VN") : record.expiredAtText, false)
                ].join("");

            return `
              <div class="alert ${alertClass}">
                <div class="font-weight-bold">${esc(statusTitle)}</div>
                <div>${esc(statusDesc)}</div>
              </div>

              <div class="payment-info-grid mb-3">
                ${paymentInfoRow("Giải đấu", tournament.title, false)}
                ${paymentInfoRow("Mã đăng ký", data?.regCode, true)}
                ${paymentInfoRow("Đội đấu", team.name, true)}
                ${paymentInfoRow("Điểm đội", team.points !== undefined ? Number(team.points || 0).toFixed(2) : "", false)}
                ${paymentInfoRow("VDV 1", team.player1Name, false)}
                ${paymentInfoRow("VDV 2", team.player2Name, false)}
              </div>

              ${!isPaid ? paymentQrHtml(qrUrl) : ""}

              <div class="payment-info-grid">
                ${paymentRows}
              </div>

              ${cashConfirmHtml(data)}
            `;
          }

          function updateActivePaymentFromData(data){
            const payment = data?.payment || {};
            const record = data?.paymentRecord || {};
            const transactionCode = payment.transactionCode || record.transactionCode || "";
            const pollUrl = payment.pollStatusUrl || (transactionCode ? `/api/tournament-registration-payments/${encodeURIComponent(transactionCode)}/status` : "");

            ACTIVE_PAYMENT.registrationId = Number(data?.registrationId || ACTIVE_PAYMENT.registrationId || 0);
            ACTIVE_PAYMENT.transactionCode = normalizePaymentCode(transactionCode);
            ACTIVE_PAYMENT.pollUrl = pollUrl;
            ACTIVE_PAYMENT.paid = !!data?.isPaid || !!payment.isPaid;
          }

          function startActivePaymentWatch(data){
            cleanupActivePayment();
            updateActivePaymentFromData(data);

            if(!ACTIVE_PAYMENT.transactionCode || ACTIVE_PAYMENT.paid){
              return;
            }

            subscribePaymentRealtime(ACTIVE_PAYMENT.transactionCode);

            if(ACTIVE_PAYMENT.pollUrl){
              ACTIVE_PAYMENT.pollTimer = window.setInterval(function(){
                pollActivePaymentStatus("poll");
              }, 3000);

              window.setTimeout(function(){
                pollActivePaymentStatus("initial");
              }, 900);
            }
          }

          async function pollActivePaymentStatus(source){
            if(!ACTIVE_PAYMENT.pollUrl || ACTIVE_PAYMENT.paid){
              return;
            }

            try{
              const res = await axios.get(ACTIVE_PAYMENT.pollUrl);
              handlePaymentStatusUpdated(res.data || {}, source || "poll");
            } catch(_error){
            }
          }

          async function refreshPaymentModalAsPaid(status){
            ACTIVE_PAYMENT.paid = true;
            if(ACTIVE_PAYMENT.pollTimer){
              window.clearInterval(ACTIVE_PAYMENT.pollTimer);
              ACTIVE_PAYMENT.pollTimer = null;
            }

            const id = ACTIVE_PAYMENT.registrationId;
            if(!id){
              return;
            }

            try{
              const res = await axios.post(`/api/admin/registrations/${id}/payment-info`);
              const data = res.data || {};
              updateActivePaymentFromData(data);

              const title = $id("paymentInfoTitle");
              const body = $id("paymentInfoBody");
              if(title){
                title.textContent = `Thanh toán thành công - ${data.regCode || ""}`;
              }
              if(body){
                body.innerHTML = `
                  <div class="alert alert-success">
                    <div class="font-weight-bold">Đã ghi nhận thanh toán thành công</div>
                    <div>Webhook Sepay đã xác nhận giao dịch cho đội này.</div>
                  </div>
                  ${renderPaymentInfo(data)}
                `;
              }

              await load(CURRENT_TAB);
            } catch(_error){
              const body = $id("paymentInfoBody");
              if(body){
                body.insertAdjacentHTML("afterbegin", `
                  <div class="alert alert-success">
                    <div class="font-weight-bold">Đã ghi nhận thanh toán thành công</div>
                    <div>${esc(status?.paidAtText || "")}</div>
                  </div>
                `);
              }
              await load(CURRENT_TAB);
            }
          }

          function handlePaymentStatusUpdated(status, source){
            const activeCode = normalizePaymentCode(ACTIVE_PAYMENT.transactionCode);
            const nextCode = normalizePaymentCode(status?.transactionCode);
            if(activeCode && nextCode && activeCode !== nextCode){
              return;
            }

            if(!status?.isPaid || ACTIVE_PAYMENT.paid){
              return;
            }

            refreshPaymentModalAsPaid(status);
          }

          async function confirmCashPayment(id){
            const registrationId = Number(id || ACTIVE_PAYMENT.registrationId || 0);
            if(!registrationId){
              alert("Không xác định được đăng ký cần xác nhận.");
              return;
            }

            if(!confirm("Xác nhận đội này đã thanh toán tiền mặt?")){
              return;
            }

            const body = $id("paymentInfoBody");
            try{
              if(body){
                body.insertAdjacentHTML("afterbegin", `
                  <div class="alert alert-info" data-cash-confirm-loading>
                    <i class="fas fa-spinner fa-spin"></i> Đang xác nhận thanh toán tiền mặt...
                  </div>
                `);
              }

              await axios.post(`/api/admin/registrations/${registrationId}/confirm-cash-payment`);

              cleanupActivePayment();
              ACTIVE_PAYMENT.registrationId = registrationId;
              await refreshPaymentModalAsPaid({ isPaid: true });
            } catch(err){
              const loading = document.querySelector("[data-cash-confirm-loading]");
              if(loading) loading.remove();

              const msg = err?.response?.data?.detail || err?.response?.data?.message || err?.message || "Không thể xác nhận thanh toán tiền mặt.";
              if(body){
                body.insertAdjacentHTML("afterbegin", `<div class="alert alert-danger">${esc(msg)}</div>`);
              } else {
                alert(msg);
              }
            }
          }

          async function openPaymentInfo(id){
            const title = $id("paymentInfoTitle");
            const body = $id("paymentInfoBody");

            cleanupActivePayment();

            if(title) title.textContent = "Thông tin thanh toán";
            setPaymentModalLoading();

            $("#modalPaymentInfo").modal("show");

            try{
              const res = await axios.post(`/api/admin/registrations/${id}/payment-info`);
              const data = res.data || {};
              if(title){
                title.textContent = data.isPaid
                  ? `Thông tin đã thanh toán - ${data.regCode || ""}`
                  : `Mã Sepay - ${data.regCode || ""}`;
              }
              if(body) body.innerHTML = renderPaymentInfo(data);
              startActivePaymentWatch(data);
              if(data.isPaid){
                await load(CURRENT_TAB);
              }
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Không thể tải thông tin thanh toán.";
              if(body){
                body.innerHTML = `<div class="alert alert-danger mb-0">${esc(msg)}</div>`;
              }
            }
          }

          function paidHtml(reg){
            const paid = !!reg.paid;
            const cls = paid ? "btn-success" : "btn-outline-danger";
            const icon = paid ? "fa-check" : "fa-times";
            const title = paid ? "Đã thanh toán - xem thông tin" : "Chưa thanh toán - tạo/xem mã Sepay";
            return `
              <button class="btn btn-sm ${cls} payment-status-btn" type="button" onclick="openPaymentInfo(${reg.registrationId})" title="${title}">
                <i class="fas ${icon}"></i>
              </button>
            `;
          }

          function actionsHtml(reg){
            const isDouble = (TOURNAMENT_GAME_TYPE === "DOUBLE");
            const pairBtn = (isDouble && reg.waitingPair)
              ? `<button class="btn btn-sm btn-outline-warning" type="button" onclick="openPair(${reg.registrationId})" title="Ghép">
                   <i class="fas fa-link"></i>
                 </button>`
              : `<button class="btn btn-sm btn-outline-secondary" type="button" disabled title="Không cần ghép">
                   <i class="fas fa-link"></i>
                 </button>`;

            return `
              <div class="d-flex flex-wrap" style="gap:6px">
                ${pairBtn}
                <button class="btn btn-sm btn-outline-info" type="button" onclick="syncLevels(${reg.registrationId})" title="Đồng bộ trình">
                  <i class="fas fa-sync-alt"></i>
                </button>
                <button class="btn btn-sm btn-outline-primary" type="button" onclick="openEditTeam(${reg.registrationId})" title="Sửa đội">
                  <i class="fas fa-user-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" type="button" onclick="delReg(${reg.registrationId})" title="Xoá">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            `;
          }

          function rowHtml(reg){
            const teamPoints = getTeamPoints(reg);

            return `
              <tr>
                <td>${reg.regIndex ?? ""}</td>
                <td><div class="font-weight-bold">${esc(reg.regCode)}</div></td>
                <td>${fmt(reg.regTime)}</td>
                <td>${playerCell(
                  reg.player1Name,
                  reg.player1LevelSingle,
                  reg.player1LevelDouble,
                  reg.player1Level,
                  reg.player1Avatar,
                  reg.player1Verified
                )}</td>

                <td>${playerCell(
                  reg.player2Name,
                  reg.player2LevelSingle,
                  reg.player2LevelDouble,
                  reg.player2Level,
                  reg.player2Avatar,
                  reg.player2Verified
                )}</td>
                <td class="text-right">${teamPoints.toFixed(2)}</td>
                <td>${esc(reg.btCode||"")}</td>
                <td class="text-center">${paidHtml(reg)}</td>
                <td>${actionsHtml(reg)}</td>
              </tr>
            `;
          }

          function setTabButtons(counts){
            const tabSuccess = $id("tabSuccess");
            const tabWaiting = $id("tabWaiting");
            const tabCapacity = $id("tabCapacity");

            if(tabSuccess){
              tabSuccess.className = `btn btn-sm pill ${CURRENT_TAB==="SUCCESS"?"btn-success":"btn-outline-success"}`;
              tabSuccess.textContent = `Thành công (${counts.success})`;
            }
            if(tabWaiting){
              tabWaiting.className = `btn btn-sm pill ${CURRENT_TAB==="WAITING"?"btn-warning":"btn-outline-warning"}`;
              tabWaiting.textContent = `Chờ ghép (${counts.waiting})`;
            }
            if(tabCapacity){
              tabCapacity.className = `btn btn-sm pill btn-outline-secondary`;
              tabCapacity.textContent = `Còn chỗ (${counts.capacityLeft})`;
            }
          }

          async function load(tab){
            CURRENT_TAB = tab;
            const body = $id("body");
            if(body) body.innerHTML = `<tr><td colspan="9" class="text-center text-muted">Đang tải...</td></tr>`;

            const res = await axios.get(API_LIST, { params: { tab } });
            const { tournament, counts, items } = res.data;

            const typeCode = String(tournament.tournamentTypeCode || "").toUpperCase();
            const rawGameType = String(tournament.gameType || "").toUpperCase();
            TOURNAMENT_GAME_TYPE = typeCode.startsWith("SINGLE")
              ? "SINGLE"
              : (typeCode.startsWith("DOUBLE") ? "DOUBLE" : (rawGameType === "SINGLE" ? "SINGLE" : "DOUBLE"));

            const meta = $id("tournamentMeta");
            if(meta){
              meta.textContent = `${tournament.title} • ${tournament.status} • Loại thi đấu: ${tournament.gameType}`;
            }
            setTabButtons(counts);

            CACHE.items = items || [];
            const waitingRes = await axios.get(API_LIST, { params: { tab: "WAITING" } });
            CACHE.waiting = waitingRes.data.items || [];

            if(!body) return;

            if(!CACHE.items.length){
              body.innerHTML = `<tr><td colspan="9" class="text-center text-muted">No registrations</td></tr>`;
              return;
            }
            body.innerHTML = CACHE.items.map(rowHtml).join("");
          }

          window.togglePaid = togglePaid;
          window.delReg = delReg;
          window.syncLevels = syncLevels;
          window.openPaymentInfo = openPaymentInfo;
          window.confirmCashPayment = confirmCashPayment;

          function openPair(baseId){
            if(TOURNAMENT_GAME_TYPE !== "DOUBLE"){
              alert("Giải đơn không cần ghép đôi.");
              return;
            }

            $id("pairBaseId").value = String(baseId);
            $id("pairErr")?.classList.add("d-none");

            const waiting = (CACHE.waiting || [])
              .filter(x => x.registrationId !== baseId)
              .sort((a,b) => (b.regIndex||0) - (a.regIndex||0));

            const sel = $id("pairWith");
            const options = waiting.map(x => {
              const s = (x.player1LevelSingle ?? x.player1Level ?? 0).toFixed(2);
              const d = (x.player1LevelDouble ?? x.player1Level ?? 0).toFixed(2);
              return `<option value="${x.registrationId}">${x.regCode} — ${esc(x.player1Name)} (Đơn: ${s}, Đôi: ${d})</option>`;
            });
            sel.innerHTML = options.join("");

            if(sel.options.length > 0) sel.selectedIndex = 0;

            $("#modalPair").modal("show");
          }
          window.openPair = openPair;

          function findRegById(id){
            return (CACHE.items || []).concat(CACHE.waiting || [])
              .find(x => Number(x.registrationId) === Number(id)) || null;
          }

          function showEditErr(msg){
            const box = $id("editErr");
            if(!box) return;
            box.textContent = msg || "Error";
            box.classList.remove("d-none");
          }

          function clearEditErr(){
            const box = $id("editErr");
            if(!box) return;
            box.textContent = "";
            box.classList.add("d-none");
          }

          function setEditAvatarBox(pn, url){
            const box = $id(`e${pn}AvatarBox`);
            if(!box) return;
            box.innerHTML = url ? `<img class="avatar-preview" src="${esc(url)}" />` : `<div class="avatar-placeholder">?</div>`;
          }

          function applyEditPlayerTypeUI(pn){
            const type = $id(`e${pn}Type`)?.value || "USER";
            const userBlock = $id(`e${pn}UserBlock`);
            const guestBlock = $id(`e${pn}GuestBlock`);
            const info = $id(`e${pn}UserInfo`);

            if(type === "USER"){
              if(userBlock) userBlock.style.display = "block";
              if(guestBlock) guestBlock.style.display = "none";
              if(info && !String(info.textContent || "").trim()) info.textContent = "Chưa kiểm tra";

              const gn = $id(`e${pn}GuestName`); if(gn) gn.value = "";
              const gl = $id(`e${pn}GuestLevel`); if(gl) gl.value = "2.50";
              const gf = $id(`e${pn}GuestAvatarFile`); if(gf) gf.value = "";
            } else {
              if(userBlock) userBlock.style.display = "none";
              if(guestBlock) guestBlock.style.display = "block";

              const ui = $id(`e${pn}UserId`); if(ui) ui.value = "";
              if(info) info.textContent = "Chế độ khách";
            }
          }

          function fillEditPlayer(pn, reg, isPlayer2){
            const userId = isPlayer2 ? reg.player2UserId : reg.player1UserId;
            const name = isPlayer2 ? reg.player2Name : reg.player1Name;
            const avatar = isPlayer2 ? reg.player2Avatar : reg.player1Avatar;
            const pickedLevel = isPlayer2 ? reg.player2Level : reg.player1Level;
            const singleLevel = isPlayer2 ? reg.player2LevelSingle : reg.player1LevelSingle;
            const doubleLevel = isPlayer2 ? reg.player2LevelDouble : reg.player1LevelDouble;

            const type = userId ? "USER" : "GUEST";
            const typeEl = $id(`e${pn}Type`);
            if(typeEl) typeEl.value = type;

            if(type === "USER"){
              const idEl = $id(`e${pn}UserId`);
              if(idEl) idEl.value = userId || "";
              const info = $id(`e${pn}UserInfo`);
              if(info){
                info.textContent = `${name || ""} • Trình đơn: ${formatLevel(singleLevel)} • Trình đôi: ${formatLevel(doubleLevel)} • ID người dùng: ${userId}`;
              }
            } else {
              const nameEl = $id(`e${pn}GuestName`);
              const levelEl = $id(`e${pn}GuestLevel`);
              if(nameEl) nameEl.value = name || "";
              if(levelEl) levelEl.value = Number(pickedLevel || 0).toFixed(2);
            }

            const fileEl = $id(`e${pn}GuestAvatarFile`);
            if(fileEl) fileEl.value = "";
            setEditAvatarBox(pn, avatar || null);
            applyEditPlayerTypeUI(pn);
            setEditAvatarBox(pn, avatar || null);
          }

          function openEditTeam(id){
            const reg = findRegById(id);
            if(!reg){
              alert("Không tìm thấy đăng ký trong dữ liệu hiện tại.");
              return;
            }

            EDITING_REG = reg;
            clearEditErr();
            $id("formEditTeam")?.reset();
            $id("editRegistrationId").value = String(reg.registrationId);

            const title = $id("editTeamTitle");
            if(title) title.textContent = `Sửa đội ${reg.regCode || ""}`;

            fillEditPlayer(1, reg, false);

            const hideP2 = TOURNAMENT_GAME_TYPE !== "DOUBLE" || !!reg.waitingPair;
            const p2Wrap = $id("editP2Wrap");
            if(p2Wrap) p2Wrap.style.display = hideP2 ? "none" : "block";

            if(!hideP2){
              fillEditPlayer(2, reg, true);
            } else {
              setEditAvatarBox(2, null);
            }

            const note = $id("editTeamNote");
            if(note){
              note.textContent = hideP2
                ? "Đăng ký này chỉ sửa VDV 1 vì đang là giải đơn hoặc đội chờ ghép."
                : "Lưu đội sẽ cập nhật lại thành viên và tính lại điểm đội.";
            }

            $("#modalEditTeam").modal("show");
          }
          window.openEditTeam = openEditTeam;

          async function checkEditUser(pn){
            const idRaw = ($id(`e${pn}UserId`)?.value || "").trim();
            const id = Number(idRaw);
            if(!id || id <= 0) return showEditErr(`Vận động viên ${pn}: nhập ID người dùng hợp lệ.`);

            try{
              const res = await axios.get(`/api/admin/users/find/${id}`);
              const u = res.data;

              const single = Number(u.ratingSingle || 0);
              const dbl = Number(u.ratingDouble || 0);
              const pickedLevel = (TOURNAMENT_GAME_TYPE === "DOUBLE") ? dbl : single;

              const info = $id(`e${pn}UserInfo`);
              if(info){
                info.textContent =
                  `${u.fullName} • Trình đơn: ${single.toFixed(2)} • Trình đôi: ${dbl.toFixed(2)} • Trình áp dụng: ${pickedLevel.toFixed(2)} • ID người dùng: ${u.userId}`;
              }
              setEditAvatarBox(pn, u.avatarUrl || null);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Kiểm tra người dùng thất bại.";
              showEditErr(`VDV ${pn}: ${msg}`);
            }
          }

          function previewEditGuestAvatar(pn){
            const input = $id(`e${pn}GuestAvatarFile`);
            const f = input?.files?.[0];
            if(!f){
              const avatar = pn === 2 ? EDITING_REG?.player2Avatar : EDITING_REG?.player1Avatar;
              setEditAvatarBox(pn, avatar || null);
              return;
            }

            setEditAvatarBox(pn, URL.createObjectURL(f));
          }

          function appendEditPlayer(fd, pn, fieldPrefix){
            const type = $id(`e${pn}Type`)?.value || "USER";
            if(type === "USER"){
              const id = ($id(`e${pn}UserId`)?.value || "").trim();
              if(!id) throw new Error(`Vận động viên ${pn}: chưa nhập ID người dùng.`);
              fd.append(`${fieldPrefix}UserId`, id);
              return;
            }

            const name = ($id(`e${pn}GuestName`)?.value || "").trim();
            const level = ($id(`e${pn}GuestLevel`)?.value || "").trim();
            if(!name) throw new Error(`Vận động viên ${pn} (khách): thiếu họ tên.`);
            if(!level) throw new Error(`Vận động viên ${pn} (khách): thiếu điểm trình.`);

            fd.append(`${fieldPrefix}Name`, name);
            fd.append(`${fieldPrefix}Level`, level);

            const f = $id(`e${pn}GuestAvatarFile`)?.files?.[0];
            if(f) fd.append(`${fieldPrefix}AvatarFile`, f);
          }

          function buildEditFormData(){
            if(!EDITING_REG) throw new Error("Chưa chọn đội cần sửa.");

            const fd = new FormData();
            appendEditPlayer(fd, 1, "player1");

            if(TOURNAMENT_GAME_TYPE === "DOUBLE" && !EDITING_REG.waitingPair){
              appendEditPlayer(fd, 2, "player2");
            }

            return fd;
          }

          function showCreateErr(msg){
            const box = $id("createErr");
            if(!box) return;
            box.textContent = msg || "Error";
            box.classList.remove("d-none");
          }
          function clearCreateErr(){
            const box = $id("createErr");
            if(!box) return;
            box.classList.add("d-none");
            box.textContent = "";
          }

          function setAvatarBox(boxId, url){
            const box = $id(boxId);
            if(!box) return;
            box.innerHTML = url ? `<img class="avatar-preview" src="${esc(url)}" />` : `<div class="avatar-placeholder">?</div>`;
          }

          function applyModeUI(){
            const dm = $id("doubleMode")?.value || "PAIR";

            if (TOURNAMENT_GAME_TYPE === "SINGLE" || TOURNAMENT_GAME_TYPE === "DOUBLE"){
              $id("gameType").value = TOURNAMENT_GAME_TYPE;
              $id("gameType").disabled = true;
            } else {
              $id("gameType").disabled = false;
            }

            const finalGT = $id("gameType")?.value || "DOUBLE";
            const p2Wrap = $id("p2Wrap");

            if(finalGT === "SINGLE"){
              if(p2Wrap) p2Wrap.style.display = "none";
              if($id("doubleMode")) $id("doubleMode").disabled = true;
            } else {
              if($id("doubleMode")) $id("doubleMode").disabled = false;
              if(p2Wrap) p2Wrap.style.display = (dm === "WAITING") ? "none" : "block";
            }
          }

          function applyPlayerTypeUI(pn){
            const type = $id(`p${pn}Type`)?.value || "USER";
            const userBlock = $id(`p${pn}UserBlock`);
            const guestBlock = $id(`p${pn}GuestBlock`);
            const info = $id(`p${pn}UserInfo`);

            if(type === "USER"){
              if(userBlock) userBlock.style.display = "block";
              if(guestBlock) guestBlock.style.display = "none";
              if(info) info.textContent = "Chưa kiểm tra";
              setAvatarBox(`p${pn}AvatarBox`, null);

              const gn = $id(`p${pn}GuestName`); if(gn) gn.value = "";
              const gl = $id(`p${pn}GuestLevel`); if(gl) gl.value = "2.50";
              const gf = $id(`p${pn}GuestAvatarFile`); if(gf) gf.value = "";
            } else {
              if(userBlock) userBlock.style.display = "none";
              if(guestBlock) guestBlock.style.display = "block";
              setAvatarBox(`p${pn}AvatarBox`, null);

              const ui = $id(`p${pn}UserId`); if(ui) ui.value = "";
              if(info) info.textContent = "Chế độ khách";
            }
          }

          async function checkUser(pn){
            const idRaw = ($id(`p${pn}UserId`)?.value || "").trim();
            const id = Number(idRaw);
            if(!id || id <= 0) return showCreateErr(`Vận động viên ${pn}: nhập ID người dùng hợp lệ.`);

            try{
              const res = await axios.get(`/api/admin/users/find/${id}`);
              const u = res.data;

              const single = Number(u.ratingSingle || 0);
              const dbl = Number(u.ratingDouble || 0);

              const pickedLevel = (TOURNAMENT_GAME_TYPE === "DOUBLE") ? dbl : single;

              const info = $id(`p${pn}UserInfo`);
              if(info){
                info.textContent =
                  `${u.fullName} • Trình đơn: ${single.toFixed(2)} • Trình đôi: ${dbl.toFixed(2)} • Trình áp dụng: ${pickedLevel.toFixed(2)} • ID người dùng: ${u.userId}`;
              }
              setAvatarBox(`p${pn}AvatarBox`, u.avatarUrl || null);
            } catch(err){
              const msg = err?.response?.data?.message || err?.message || "Kiểm tra người dùng thất bại.";
              showCreateErr(`VDV ${pn}: ${msg}`);
            }
          }

          function previewGuestAvatar(pn){
            const input = $id(`p${pn}GuestAvatarFile`);
            const f = input?.files?.[0];
            if(!f){ setAvatarBox(`p${pn}AvatarBox`, null); return; }
            const url = URL.createObjectURL(f);
            setAvatarBox(`p${pn}AvatarBox`, url);
          }

          function buildFormData(){
            const fd = new FormData();

            const gt = $id("gameType")?.value || "DOUBLE";
            let dm = $id("doubleMode")?.value || "PAIR";

            if(gt === "SINGLE") dm = "PAIR";
            const waitingPair = (gt === "DOUBLE" && dm === "WAITING");

            fd.append("gameType", gt);
            fd.append("waitingPair", String(waitingPair));
            fd.append("paid", String(($id("paid")?.value || "false") === "true"));
            fd.append("btCode", $id("btCode")?.value || "");

            const p1Type = $id("p1Type")?.value || "USER";
            if(p1Type === "USER"){
              const id = ($id("p1UserId")?.value || "").trim();
              if(!id) throw new Error("Vận động viên 1: chưa nhập ID người dùng.");
              fd.append("player1UserId", id);
            } else {
              const name = ($id("p1GuestName")?.value || "").trim();
              const level = ($id("p1GuestLevel")?.value || "").trim();
              if(!name) throw new Error("Vận động viên 1 (khách): thiếu họ tên.");
              if(!level) throw new Error("Vận động viên 1 (khách): thiếu điểm trình.");
              fd.append("player1Name", name);
              fd.append("player1Level", level);

              const f = $id("p1GuestAvatarFile")?.files?.[0];
              if(f) fd.append("player1AvatarFile", f);
            }

            if(gt === "DOUBLE" && !waitingPair){
              const p2Type = $id("p2Type")?.value || "USER";
              if(p2Type === "USER"){
                const id = ($id("p2UserId")?.value || "").trim();
                if(!id) throw new Error("Vận động viên 2: chưa nhập ID người dùng.");
                fd.append("player2UserId", id);
              } else {
                const name = ($id("p2GuestName")?.value || "").trim();
                const level = ($id("p2GuestLevel")?.value || "").trim();
                if(!name) throw new Error("Vận động viên 2 (khách): thiếu họ tên.");
                if(!level) throw new Error("Vận động viên 2 (khách): thiếu điểm trình.");
                fd.append("player2Name", name);
                fd.append("player2Level", level);

                const f = $id("p2GuestAvatarFile")?.files?.[0];
                if(f) fd.append("player2AvatarFile", f);
              }
            }

            return fd;
          }

          document.addEventListener("DOMContentLoaded", async () => {
            if(!TOURNAMENT_ID){
              console.error("TOURNAMENT_ID missing. Check ViewBag.TournamentId.");
              return;
            }

            on("tabSuccess","click", () => load("SUCCESS"));
            on("tabWaiting","click", () => load("WAITING"));
            on("tabCapacity","click", () => alert("Số chỗ còn lại = Số đội dự kiến - Số đội đăng ký thành công."));

            on("btnSearch","click", () => {
              const key = ($id("q")?.value || "").trim().toLowerCase();
              const body = $id("body");
              if(!body) return;

              const filtered = (CACHE.items || []).filter(x =>
                (x.player1Name||"").toLowerCase().includes(key) ||
                (x.player2Name||"").toLowerCase().includes(key) ||
                (x.regCode||"").toLowerCase().includes(key)
              );

              body.innerHTML = filtered.length
                ? filtered.map(rowHtml).join("")
                : `<tr><td colspan="9" class="text-center text-muted">Không có kết quả</td></tr>`;
            });

            on("btnOpenCreate","click", () => {
              clearCreateErr();
              $id("formCreate")?.reset();

              if($id("p1Type")) $id("p1Type").value = "USER";
              if($id("p2Type")) $id("p2Type").value = "USER";
              applyPlayerTypeUI(1);
              applyPlayerTypeUI(2);

              setAvatarBox("p1AvatarBox", null);
              setAvatarBox("p2AvatarBox", null);

              if($id("doubleMode")) $id("doubleMode").value = "PAIR";
              applyModeUI();

              $("#modalCreate").modal("show");
            });

            on("gameType","change", applyModeUI);
            on("doubleMode","change", applyModeUI);

            on("p1Type","change", () => applyPlayerTypeUI(1));
            on("p2Type","change", () => applyPlayerTypeUI(2));

            on("btnP1Check","click", () => checkUser(1));
            on("btnP2Check","click", () => checkUser(2));

            on("p1GuestAvatarFile","change", () => previewGuestAvatar(1));
            on("p2GuestAvatarFile","change", () => previewGuestAvatar(2));

            on("e1Type","change", () => applyEditPlayerTypeUI(1));
            on("e2Type","change", () => applyEditPlayerTypeUI(2));

            on("btnE1Check","click", () => checkEditUser(1));
            on("btnE2Check","click", () => checkEditUser(2));

            on("e1GuestAvatarFile","change", () => previewEditGuestAvatar(1));
            on("e2GuestAvatarFile","change", () => previewEditGuestAvatar(2));

            $("#modalPaymentInfo").on("hidden.bs.modal", cleanupActivePayment);
            window.addEventListener("pagehide", cleanupActivePayment);

            on("formPair","submit", async (e) => {
              e.preventDefault();
              const baseId = Number($id("pairBaseId")?.value || 0);
              const withId = Number($id("pairWith")?.value || 0);
              try{
                await axios.post(`/api/admin/registrations/${baseId}/pair`, { withWaitingRegistrationId: withId });
                $("#modalPair").modal("hide");
                await load(CURRENT_TAB);
              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Ghép đôi thất bại.";
                const box = $id("pairErr");
                if(box){
                  box.textContent = msg;
                  box.classList.remove("d-none");
                }
              }
            });

            on("formEditTeam","submit", async (e) => {
              e.preventDefault();
              clearEditErr();

              const id = Number($id("editRegistrationId")?.value || 0);
              const btn = $id("btnEditSubmit");
              if(btn){
                btn.disabled = true;
                btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Saving...`;
              }

              try{
                const fd = buildEditFormData();
                await axios.put(`/api/admin/registrations/${id}/players`, fd);
                $("#modalEditTeam").modal("hide");
                await load(CURRENT_TAB);
              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Cập nhật đội thất bại.";
                showEditErr(msg);
              } finally {
                if(btn){
                  btn.disabled = false;
                  btn.innerHTML = `<i class="fas fa-save"></i> Lưu đội`;
                }
              }
            });

            on("formCreate","submit", async (e) => {
              e.preventDefault();
              clearCreateErr();

              const btn = $id("btnCreateSubmit");
              if(btn){
                btn.disabled = true;
                btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Saving...`;
              }

              try{
                const fd = buildFormData();

                await axios.post(`/api/admin/tournaments/${TOURNAMENT_ID}/registrations`, fd, {
                });

                $("#modalCreate").modal("hide");
                window.location.reload();

              } catch(err){
                const msg = err?.response?.data?.message || err?.message || "Tạo đăng ký thất bại.";
                showCreateErr(msg);
              } finally {
                if(btn){
                  btn.disabled = false;
                  btn.innerHTML = `<i class="fas fa-save"></i> Đăng ký`;
                }
              }
            });

            await load("SUCCESS");
          });
        })();
    </script>
}
