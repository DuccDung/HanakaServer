          function cancelPaymentConfirmationHtml(data){
            if(!data?.isPaid) return "";

            return `
              <div class="mt-3 pt-3 border-top">
                <button class="btn btn-outline-danger" type="button" onclick="openCancelPaymentConfirmation(${Number(data?.registrationId || 0)})">
