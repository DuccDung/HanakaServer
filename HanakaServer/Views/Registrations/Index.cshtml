@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>window.HanakaApiLoading?.installAxios(window.axios);</script>
    <script>
        (() => {
          const $id = (id) => document.getElementById(id);
          const on = (id, evt, handler) => { const el = $id(id); if (el) el.addEventListener(evt, handler); };

          const root = $id("pageRoot");
          const TOURNAMENT_ID = Number(root?.dataset?.tournamentId || 0);

          let CURRENT_TAB = "SUCCESS";
          let CACHE = { items: [], waiting: [] };
          let TOURNAMENT_GAME_TYPE = null; // "SINGLE" | "DOUBLE"
          let IS_RELAY = false;
          let RELAY_TEAM_SIZE = 0;
          let RELAY_PAIR_COUNT = 0;
          let EDITING_REG = null;
          let LOAD_SEQUENCE = 0;
          let SEARCH_TIMER = null;
          let HAS_AUTO_SELECTED_RELAY_TAB = false;
          let DELETE_REGISTRATION = { registrationId: 0, regCode: "", teamName: "", submitting: false };
          let CASH_PAYMENT_CONFIRMATION = { registrationId: 0, submitting: false };
          let REGISTRATION_NOTICE_TIMER = null;
          let ACTIVE_PAYMENT = {
            registrationId: 0,
            regCode: "",
            teamName: "",
            amountText: "",
            transactionCode: "",
            pollUrl: "",
            paid: false,
            pollTimer: null
          };
          const PAYMENT_RT = {
            ws: null,
            reconnectTimer: null,
            pingTimer: null,
            manualClose: false,
            payments: Object.create(null)
          };

          const API_LIST = `/api/admin/tournaments/${TOURNAMENT_ID}/registrations`;

          const esc = (s) => String(s || "").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
          const escAttr = (s) => esc(s).replaceAll('"', "&quot;").replaceAll("'", "&#39;");
          const fmt = (dt) => {
            if(!dt) return "—";
            const d = new Date(dt);
            if(isNaN(d.getTime())) return "—";
            const yyyy=d.getFullYear(), mm=String(d.getMonth()+1).padStart(2,"0"), dd=String(d.getDate()).padStart(2,"0");
            const hh=String(d.getHours()).padStart(2,"0"), mi=String(d.getMinutes()).padStart(2,"0");
            return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
          };

          function avatarHtml(url){
            if(!url) return `<div class="avatar-placeholder">?</div>`;
            return `<img class="avatar-preview" src="${esc(url)}" />`;
          }

          function formatLevel(value){
            return (value === null || value === undefined || Number.isNaN(Number(value)))
              ? "—"
              : Number(value).toFixed(2);
          }

          function hasPlayer(name){
            return !!String(name || "").trim();
          }

          function getPickedLevel(singleLevel, doubleLevel, pickedLevel){
            if(TOURNAMENT_GAME_TYPE === "DOUBLE"){
              return doubleLevel ?? pickedLevel;
            }
            if(TOURNAMENT_GAME_TYPE === "SINGLE"){
              return singleLevel ?? pickedLevel;
            }
            return pickedLevel ?? doubleLevel ?? singleLevel;
          }

          function getTeamPoints(reg){
            const p1 = Number(getPickedLevel(reg.player1LevelSingle, reg.player1LevelDouble, reg.player1Level) || 0);
            if(TOURNAMENT_GAME_TYPE !== "DOUBLE"){
              return p1;
            }

            if(!hasPlayer(reg.player2Name)){
              return p1;
            }

            const p2 = Number(getPickedLevel(reg.player2LevelSingle, reg.player2LevelDouble, reg.player2Level) || 0);
            return p1 + p2;
          }

          function playerCell(name, singleLevel, doubleLevel, pickedLevel, avatar, verified){
            if(!hasPlayer(name)){
              return `<div class="small text-muted">—</div>`;
            }

            const badge = verified ? `<span class="badge badge-success ml-2">Đã xác minh</span>` : ``;
            const pickLabel = TOURNAMENT_GAME_TYPE === "DOUBLE" ? "Trình đôi áp dụng" : "Trình đơn áp dụng";
            const actualPickedLevel = getPickedLevel(singleLevel, doubleLevel, pickedLevel);

            const s = formatLevel(singleLevel);
            const d = formatLevel(doubleLevel);
            const p = formatLevel(actualPickedLevel);

            return `
              <div class="d-flex" style="gap:10px;align-items:center;">
                ${avatarHtml(avatar)}
                <div>
                  <div class="font-weight-bold text-gray-900">${esc(name||"—")}${badge}</div>
                  <div class="small text-muted">Đơn: ${s} • Đôi: ${d}</div>
                  <div class="small text-muted">${pickLabel}: ${p}</div>
                </div>
              </div>
            `;
          }

          async function togglePaid(id, paid){
            await axios.put(`/api/admin/registrations/${id}`, { paid });
          }

          function registrationTeamName(registration){
            if(!registration) return "—";
            if(registration.isRelay && String(registration.relayTeamName || "").trim()){
              return String(registration.relayTeamName).trim();
            }
            const player1Name = String(registration.player1Name || "").trim();
            const player2Name = String(registration.player2Name || "").trim();
            return [player1Name, player2Name].filter(Boolean).join(" / ") || "—";
          }

          function relayMemberEditorHtml(prefix, position, member, locked, reserve = false){
            const userId = member?.userId || "";
            const displayName = member?.displayName || "";
            const disabled = locked ? "disabled" : "";
            const accountStatus = userId
              ? `Tài khoản hiện tại: ${displayName || `ID ${userId}`}`
              : "Chưa kiểm tra tài khoản";
            return `
              <div class="relay-athlete-editor ${locked ? "is-locked" : ""}">
                <div class="relay-athlete-editor__title">
                  <span><i class="fas fa-user mr-1 text-primary" aria-hidden="true"></i>${reserve ? "Dự bị" : "Vận động viên"} ${position}</span>
                  <span class="relay-athlete-editor__position">#${position}</span>
                  ${reserve ? `<button type="button" class="btn btn-sm btn-link text-danger p-0" data-relay-reserve-clear data-prefix="${prefix}" data-position="${position}">Bỏ chọn</button>` : ""}
                </div>
                <div class="form-group mb-2">
                  <label class="small text-muted mb-1">ID tài khoản</label>
                  <div class="input-group input-group-sm">
                    <input class="form-control" id="${prefix}RelayUser${position}" type="number" min="1" step="1" value="${escAttr(userId)}" placeholder="Nhập User ID" data-relay-user-input data-prefix="${prefix}" data-position="${position}" ${disabled} />
                    <div class="input-group-append">
                      <button class="btn btn-outline-primary relay-user-check-button" id="${prefix}RelayUserCheck${position}" type="button" data-relay-user-check data-prefix="${prefix}" data-position="${position}" title="Kiểm tra ID tài khoản" ${disabled}>
                        <i class="fas fa-check" aria-hidden="true"></i> Kiểm tra
                      </button>
                    </div>
                  </div>
                  <small class="relay-user-check-status ${userId ? "text-success" : "text-muted"}" id="${prefix}RelayUserInfo${position}" aria-live="polite">${esc(accountStatus)}</small>
                </div>
                <div class="form-group mb-0">
                  <label class="small text-muted mb-1">Họ tên nếu là khách</label>
                  <input class="form-control form-control-sm" id="${prefix}RelayName${position}" maxlength="150" value="${escAttr(displayName)}" placeholder="Chỉ nhập khi VĐV chưa có tài khoản" ${disabled} />
                </div>
              </div>`;
          }

          function resetRelayUserCheck(prefix, position){
            const input = $id(`${prefix}RelayUser${position}`);
            const status = $id(`${prefix}RelayUserInfo${position}`);
            if(input) delete input.dataset.checkedUserId;
            if(status){
              status.className = "relay-user-check-status text-muted";
              status.textContent = String(input?.value || "").trim()
                ? "ID đã thay đổi, vui lòng kiểm tra lại."
                : "Chưa kiểm tra tài khoản";
            }
          }

          async function checkRelayUser(prefix, position){
            const input = $id(`${prefix}RelayUser${position}`);
            const status = $id(`${prefix}RelayUserInfo${position}`);
            const button = $id(`${prefix}RelayUserCheck${position}`);
            const idRaw = String(input?.value || "").trim();
            const userId = Number(idRaw);

            if(!/^\d+$/.test(idRaw) || !Number.isSafeInteger(userId) || userId <= 0){
              if(input) delete input.dataset.checkedUserId;
              if(status){
                status.className = "relay-user-check-status text-danger";
                status.textContent = "Vui lòng nhập User ID là số nguyên dương.";
              }
              input?.focus();
              return;
            }

            if(button){
              button.disabled = true;
              button.innerHTML = `<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Đang kiểm tra`;
            }
            if(status){
              status.className = "relay-user-check-status text-muted";
              status.textContent = `Đang kiểm tra User ID ${userId}...`;
            }

            try{
              const res = await axios.get(`/api/admin/users/find/${userId}`);
              if(String(input?.value || "").trim() !== idRaw) return;

              const user = res.data || {};
              if(input) input.dataset.checkedUserId = String(user.userId || userId);
              if(status){
                const single = Number(user.ratingSingle || 0);
                const double = Number(user.ratingDouble || 0);
                status.className = "relay-user-check-status text-success";
                status.textContent = `Đúng tài khoản: ${user.fullName || "Chưa có họ tên"} · Đơn ${single.toFixed(2)} · Đôi ${double.toFixed(2)}`;
              }
            } catch(err){
              if(String(input?.value || "").trim() !== idRaw) return;

              if(input) delete input.dataset.checkedUserId;
              if(status){
                status.className = "relay-user-check-status text-danger";
                status.textContent = err?.response?.data?.message || err?.message || "Không kiểm tra được tài khoản.";
              }
            } finally {
              if(button){
                button.disabled = false;
                button.innerHTML = `<i class="fas fa-check" aria-hidden="true"></i> Kiểm tra`;
              }
            }
          }

          function renderRelayMemberEditors(containerId, prefix, members, locked){
            const map = new Map((members || []).map(x => [Number(x.position), x]));
            const container = $id(containerId);
            if(!container) return;
            container.innerHTML = Array.from({ length: RELAY_PAIR_COUNT }, (_, index) => {
              const pairNumber = index + 1;
              const firstPosition = (pairNumber * 2) - 1;
              const secondPosition = pairNumber * 2;
              return `
                <section class="relay-pair-editor ${locked ? "is-locked" : ""}">
                  <div class="relay-pair-editor__head">
                    <strong><i class="fas fa-layer-group mr-1" aria-hidden="true"></i>Cặp ${pairNumber}</strong>
                    <small>Vị trí ${firstPosition}–${secondPosition}</small>
                  </div>
                  ${relayMemberEditorHtml(prefix, firstPosition, map.get(firstPosition), locked)}
                  ${relayMemberEditorHtml(prefix, secondPosition, map.get(secondPosition), locked)}
                </section>`;
            }).join("");
          }

          function renderRelayReserveEditors(mode, members){
            const prefix = mode.toLowerCase() + "Reserve";
            const map = new Map((members || []).map(x => [Number(x.position), x]));
            $id('relay' + mode + 'Reserves').innerHTML = Array.from({length: 4}, (_, index) =>
              '<section class="relay-pair-editor">' + relayMemberEditorHtml(prefix, index + 1, map.get(index + 1), false, true) + '</section>'
            ).join('');
            $id('relay' + mode + 'ReservesBlock').open = (members || []).length > 0;
          }

          function appendRelayMembers(fd, prefix){
            const seenUserIds = new Set();
            for(let position = 1; position <= RELAY_TEAM_SIZE; position++){
              const userId = String($id(`${prefix}RelayUser${position}`)?.value || "").trim();
              const displayName = String($id(`${prefix}RelayName${position}`)?.value || "").trim();
              if(!userId && !displayName){
                throw new Error(`Vận động viên vị trí ${position}: cần nhập ID tài khoản hoặc họ tên khách.`);
              }
              if(userId){
                const parsedId = Number(userId);
                if(!Number.isInteger(parsedId) || parsedId <= 0){
                  throw new Error(`Vận động viên vị trí ${position}: ID tài khoản không hợp lệ.`);
                }
                if(seenUserIds.has(parsedId)){
                  throw new Error(`Tài khoản ${parsedId} đang bị nhập trùng trong đội.`);
                }
                seenUserIds.add(parsedId);
              }
              const index = position - 1;
              fd.append(`relayMembers[${index}].position`, String(position));
              if(userId) fd.append(`relayMembers[${index}].userId`, userId);
              fd.append(`relayMembers[${index}].displayName`, displayName);
            }
            fd.append("relayReserveMembersIncluded", "true");
            let reserveIndex = 0;
            for (let position = 1; position <= 4; position++) {
              const userId = String($id(`${prefix}ReserveRelayUser${position}`)?.value || "").trim();
              const displayName = String($id(`${prefix}ReserveRelayName${position}`)?.value || "").trim();
              if (!userId && !displayName) continue;
              if (userId) {
                const id = Number(userId);
                if (!Number.isSafeInteger(id) || id <= 0) throw new Error(`Dự bị ${position}: ID tài khoản không hợp lệ.`);
                if (seenUserIds.has(id)) throw new Error(`Tài khoản ${id} bị trùng trong đội, kể cả dự bị.`);
                seenUserIds.add(id);
              }
              fd.append(`relayReserveMembers[${reserveIndex}].position`, String(position));
              if (userId) fd.append(`relayReserveMembers[${reserveIndex}].userId`, userId);
              fd.append(`relayReserveMembers[${reserveIndex}].displayName`, displayName);
              reserveIndex++;
            }
          }

          function hideRegistrationNotice(){
            window.clearTimeout(REGISTRATION_NOTICE_TIMER);
