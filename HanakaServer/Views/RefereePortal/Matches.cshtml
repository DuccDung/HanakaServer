@{
    Layout = null;
    ViewData["Title"] = "Trận đấu của trọng tài";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/api-loading.css" asp-append-version="true" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg: #f5f7fb;
            --card: #ffffff;
            --border: #e5e7eb;
            --muted: #6b7280;
            --text: #111827;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-soft: #eff6ff;
            --success: #16a34a;
            --success-dark: #166534;
            --success-soft: #f0fdf4;
            --warning: #d97706;
            --danger: #b91c1c;
            --danger-soft: #fef2f2;
            --dark: #0f172a;
            --surface-soft: #f8fafc;
            --focus-ring: rgba(37, 99, 235, .32);
            --shadow-card: 0 12px 32px rgba(15, 23, 42, .08);
            --radius-card: 20px;
            --touch-target: 48px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            font-family: "Be Vietnam Pro", Arial, sans-serif;
            color: var(--text);
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
            overflow-x: hidden;
        }

        button,
        .match-card {
            touch-action: manipulation;
        }

        .topbar {
            background: var(--dark);
            color: #fff;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .16);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            min-width: 0;
            line-height: 1.35;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .topbar-right .small {
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: rgba(255, 255, 255, .78);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 0 0 auto;
        }

        .topbar .btn {
            min-height: 40px;
            border-radius: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .topbar-icon-btn {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border: 0;
            border-radius: 14px;
            background: rgba(255, 255, 255, .12);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: background-color .15s ease, transform .15s ease;
        }

        .topbar-icon-btn:active {
            transform: scale(.96);
        }

        .topbar-icon-btn:hover,
        .topbar-icon-btn:focus,
        .topbar-icon-btn.active {
            background: #fff;
            color: var(--dark);
            outline: 0;
        }

        .topbar-search {
            position: absolute;
            top: calc(100% + 8px);
            right: 24px;
            z-index: 120;
            width: min(390px, calc(100vw - 28px));
            padding: 10px;
            border: 1px solid rgba(148, 163, 184, .3);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 18px 42px rgba(15, 23, 42, .2);
            display: none;
        }

        .topbar.search-open .topbar-search {
            display: block;
        }

        .search-input-shell {
            display: grid;
            grid-template-columns: 20px minmax(0, 1fr) 34px;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 0 8px 0 12px;
            border: 1px solid #d1d5db;
            border-radius: 14px;
            background: #f8fafc;
            color: #64748b;
        }

        .search-input-shell input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: var(--text);
            font-size: 15px;
            font-weight: 700;
        }

        .search-input-shell input::placeholder {
            color: #94a3b8;
            font-weight: 600;
        }

        .search-clear-btn {
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 12px;
            background: transparent;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .search-clear-btn:hover,
        .search-clear-btn:focus {
            background: #e5e7eb;
            color: #111827;
            outline: 0;
        }

        .search-hint {
            margin-top: 8px;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
        }

        .page-wrap {
            max-width: 1280px;
            margin: 24px auto;
            padding: 0 16px 32px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 6px;
            color: var(--text);
            line-height: 1.2;
        }

        .page-subtitle {
            color: var(--muted);
            margin-bottom: 24px;
            line-height: 1.65;
        }

        .match-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .match-card {
            background: var(--card);
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: 0 8px 24px rgba(0,0,0,.05);
            padding: 18px;
            cursor: pointer;
            transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
            -webkit-tap-highlight-color: transparent;
        }

        .match-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08);
            border-color: #cbd5e1;
        }

        .match-card:active {
            transform: scale(.995);
        }

        .match-card.completed {
            border-color: #bbf7d0;
        }

        .match-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .match-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 4px;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .match-meta {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 2px;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .match-chip-col {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }

        .match-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 700;
            background: #eef2ff;
            color: #3730a3;
            line-height: 1.25;
            white-space: nowrap;
        }

        .match-chip.success {
            background: #dcfce7;
            color: #166534;
        }

        .match-chip.muted {
            background: #f3f4f6;
            color: #4b5563;
        }

        .match-id-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 8px;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .02em;
            background: #111827;
            color: #fff;
        }

        .score-preview {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px dashed #d1d5db;
        }

        .team-preview {
            font-weight: 700;
            font-size: 15px;
            color: var(--text);
            line-height: 1.4;
        }

        .team-preview.right {
            text-align: right;
        }

        .team-preview.winner {
            color: var(--warning);
        }

        .score-preview-value {
            font-size: 28px;
            font-weight: 900;
            color: var(--text);
            min-width: 96px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }

        .hint-click {
            margin-top: 14px;
            font-size: 12px;
            color: var(--primary);
            font-weight: 700;
            line-height: 1.45;
        }

        .empty-box {
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 18px;
            padding: 32px;
            text-align: center;
            color: var(--muted);
            grid-column: 1 / -1;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .72);
            z-index: 3000;
            display: none;
            align-items: stretch;
            justify-content: stretch;
        }

        .overlay.show {
            display: flex;
        }

        .overlay-panel {
            background: #fff;
            width: 100%;
            height: 100%;
            min-height: 0;
            overflow: auto;
            display: flex;
            flex-direction: column;
        }

        .overlay-header {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #fff;
            border-bottom: 1px solid var(--border);
            padding: 16px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .overlay-title {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 4px;
            color: var(--text);
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .overlay-subtitle {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.5;
        }

        .overlay-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            flex: 0 0 auto;
        }

        .overlay-actions .btn {
            min-height: 44px;
            border-radius: 14px;
            font-weight: 800;
        }

        #btnCloseOverlay {
            border: 0;
            background: transparent;
            box-shadow: none;
            color: #64748b;
            min-width: 44px;
            min-height: 44px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        #btnCloseOverlay:hover,
        #btnCloseOverlay:focus {
            border: 0;
            background: rgba(15, 23, 42, .06);
            box-shadow: none;
            color: #334155;
        }

        #btnCloseOverlay i {
            margin: 0;
            font-size: 16px;
        }

        .overlay-body {
            padding: 24px;
        }

        .focus-match {
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,.05);
        }

        .focus-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 18px;
        }

        .focus-meta {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .focus-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .focus-scoreboard {
            margin-top: 18px;
            padding-top: 20px;
            border-top: 1px dashed #d1d5db;
            display: grid;
            grid-template-columns: 1fr 280px 1fr;
            gap: 20px;
            align-items: center;
        }

        .focus-team {
            font-size: 28px;
            font-weight: 800;
            line-height: 1.35;
            color: var(--text);
            overflow-wrap: anywhere;
        }

        .focus-team.right {
            text-align: right;
        }

        .focus-team.winner {
            color: var(--warning);
        }

        .focus-score-center {
            background: #0f172a;
            color: #fff;
            border-radius: 24px;
            padding: 24px 12px;
            text-align: center;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .18);
        }

        .focus-score-value {
            font-size: 72px;
            font-weight: 900;
            line-height: 1;
            letter-spacing: 1px;
            font-variant-numeric: tabular-nums;
        }

        .focus-score-label {
            margin-top: 10px;
            font-size: 14px;
            opacity: .9;
            font-weight: 700;
        }

        .focus-controls {
            margin-top: 28px;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 24px;
        }

        .history-section,
        .score-form-section {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 14px;
            color: var(--text);
        }

        .history-list {
            max-height: 420px;
            overflow: auto;
            padding-right: 4px;
        }

        .history-empty {
            color: var(--muted);
            font-size: 14px;
        }

        .history-item {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 10px;
        }

        .history-score {
            font-size: 18px;
            font-weight: 900;
            color: var(--text);
            font-variant-numeric: tabular-nums;
        }

        .history-meta {
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
        }

        .history-note {
            margin-top: 8px;
            font-size: 14px;
            color: var(--text);
        }

        .big-score-inputs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .big-score-box label {
            font-weight: 700;
            margin-bottom: 8px;
            display: block;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .big-score-box input {
            height: 90px;
            font-size: 42px;
            font-weight: 900;
            text-align: center;
            border-radius: 16px;
            font-variant-numeric: tabular-nums;
            -webkit-appearance: none;
            appearance: textfield;
            touch-action: manipulation;
        }

        .big-score-box input::-webkit-outer-spin-button,
        .big-score-box input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .score-stepper {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
            align-items: stretch;
        }

        .score-stepper-btn {
            display: none;
            align-items: center;
            justify-content: center;
            min-width: 58px;
            min-height: 58px;
            border: 0;
            border-radius: 18px;
            background: #2563eb;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 12px 24px rgba(37, 99, 235, .22);
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            transition: transform .12s ease, background-color .12s ease, box-shadow .12s ease;
        }

        .score-stepper-btn:active {
            transform: scale(.96);
            background: #1d4ed8;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .22);
        }

        .score-stepper-btn--minus {
            background: #475569;
            box-shadow: 0 12px 24px rgba(71, 85, 105, .18);
        }

        .score-stepper-btn--minus:active {
            background: #334155;
            box-shadow: 0 8px 18px rgba(71, 85, 105, .18);
        }

        .score-stepper-btn:disabled {
            opacity: .9;
        }

        .score-stepper-btn:focus-visible {
            outline: 3px solid rgba(37, 99, 235, .22);
            outline-offset: 2px;
        }

        .score-toast {
            position: fixed;
            top: calc(12px + env(safe-area-inset-top));
            left: 50%;
            z-index: 2000;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            max-width: calc(100vw - 28px);
            min-height: 42px;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(15, 23, 42, .94);
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            line-height: 1.25;
            box-shadow: 0 14px 34px rgba(15, 23, 42, .22);
            opacity: 0;
            pointer-events: none;
            transform: translate(-50%, -12px);
            transition: opacity .18s ease, transform .18s ease;
        }

        .score-toast.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        .score-toast.success {
            background: rgba(22, 101, 52, .96);
        }

        .score-toast.error {
            background: rgba(185, 28, 28, .96);
        }

        .score-toast.info {
            background: rgba(29, 78, 216, .96);
        }

        .end-match-modal {
            position: fixed;
            inset: 0;
            z-index: 4200;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            background: rgba(15, 23, 42, .66);
        }

        .end-match-modal.show {
            display: flex;
        }

        .end-match-dialog {
            width: min(430px, 100%);
            border-radius: 22px;
            background: #fff;
            padding: 22px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, .28);
        }

        .end-match-icon {
            width: 54px;
            height: 54px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #dcfce7;
            color: #15803d;
            font-size: 22px;
            margin-bottom: 14px;
        }

        .end-match-title {
            color: var(--text);
            font-size: 24px;
            font-weight: 900;
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .end-match-text {
            color: #64748b;
            font-size: 15px;
            line-height: 1.55;
            margin-bottom: 18px;
        }

        .end-match-actions {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 10px;
        }

        .end-match-actions .btn {
            min-height: 48px;
            border-radius: 14px;
            font-weight: 900;
        }

        .form-note-select {
            height: 48px;
            border-radius: 12px;
        }

        .score-form-section .btn-success {
            min-height: 52px;
            border-radius: 14px;
            font-weight: 800;
            box-shadow: 0 12px 24px rgba(22, 163, 74, .18);
        }

        .switch-wrap {
            margin-top: 14px;
            padding: 12px 14px;
            background: #f8fafc;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
        }

        .focus-lock {
            margin-top: 14px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #fff7ed;
            color: #9a3412;
            border: 1px solid #fed7aa;
            font-size: 14px;
            font-weight: 700;
        }

        @@media (max-width: 1100px) {
            .match-grid {
                grid-template-columns: 1fr;
            }

            .focus-scoreboard {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .focus-team,
            .focus-team.right {
                text-align: center;
                font-size: 24px;
            }

            .focus-controls {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .topbar {
                padding: 12px 14px;
                align-items: stretch;
                flex-direction: column;
                gap: 10px;
            }

            .topbar-left {
                font-size: 15px;
            }

            .topbar-right {
                justify-content: space-between;
                width: 100%;
            }

            .topbar-right .small {
                max-width: calc(100vw - 206px);
                min-height: 24px;
                display: inline-flex;
                align-items: center;
            }

            .topbar-actions {
                gap: 8px;
            }

            .topbar-search {
                left: 14px;
                right: 14px;
                top: calc(100% + 8px);
                width: auto;
            }

            .page-wrap {
                margin: 0 auto;
                padding: 18px 14px calc(28px + env(safe-area-inset-bottom));
            }

            .page-title {
                font-size: 24px;
                margin-bottom: 8px;
            }

            .page-subtitle {
                font-size: 14px;
                margin-bottom: 16px;
            }

            .match-grid {
                gap: 14px;
            }

            .match-card {
                border-radius: 18px;
                padding: 16px;
                box-shadow: 0 8px 22px rgba(15, 23, 42, .07);
            }

            .match-head {
                flex-direction: column;
                gap: 12px;
            }

            .match-chip-col {
                width: 100%;
                align-items: flex-start;
                flex-direction: row;
                flex-wrap: wrap;
            }

            .score-preview {
                grid-template-columns: 1fr;
                gap: 8px;
                margin-top: 14px;
                padding-top: 14px;
            }

            .score-preview-value {
                order: -1;
                width: 100%;
                min-width: 0;
                padding: 12px 14px;
                border-radius: 16px;
                background: #f8fafc;
                border: 1px solid #e5e7eb;
            }

            .team-preview,
            .team-preview.right {
                text-align: left;
                font-size: 14px;
            }

            .hint-click {
                display: flex;
                align-items: center;
                gap: 8px;
                min-height: 44px;
                padding: 10px 12px;
                border-radius: 14px;
                background: #eff6ff;
            }

            .overlay-header,
            .overlay-body {
                padding: 14px;
            }

            .overlay-header {
                align-items: flex-start;
                gap: 10px;
            }

            .overlay-title {
                font-size: 18px;
            }

            .overlay-subtitle {
                font-size: 12px;
            }

            .overlay-actions .btn {
                width: 44px;
                padding: 0;
                overflow: hidden;
                color: transparent;
            }

            .overlay-actions .btn i {
                color: #6b7280;
                margin: 0;
                font-size: 16px;
