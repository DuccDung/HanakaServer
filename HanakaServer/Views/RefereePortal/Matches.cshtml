            box-shadow: inset 0 1px 2px rgba(15, 23, 42, .04);
        }

        .score-form-section .big-score-box input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .12);
        }

        .score-save-status {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            min-height: 44px;
            margin-top: 12px;
            padding: 11px 12px;
            border: 1px solid #dbe4f0;
            border-radius: 13px;
            background: #f1f5f9;
            color: #334155;
            font-size: 13px;
            font-weight: 800;
            line-height: 1.45;
        }

        .score-save-status i {
            flex: 0 0 auto;
            margin-top: 2px;
        }

        .score-save-status.success {
            border-color: #bbf7d0;
            background: var(--success-soft);
            color: var(--success-dark);
        }

        .score-save-status.saving {
            border-color: #bfdbfe;
            background: var(--primary-soft);
            color: #1e40af;
        }

        .score-save-status.dirty {
            border-color: #fed7aa;
            background: #fff7ed;
            color: #9a3412;
        }

        .score-save-status.error {
            border-color: #fecaca;
            background: var(--danger-soft);
            color: #991b1b;
        }

        #inlineScoreErr {
            margin-bottom: 12px;
            border-radius: 13px;
            font-size: 13px;
            line-height: 1.5;
        }

        .score-form-options {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
            margin-top: 14px;
        }

        .situation-field {
            margin: 0;
        }

        .situation-field label {
            margin-bottom: 7px;
            color: #334155;
            font-size: 13px;
            font-weight: 900;
        }

        .form-note-select,
        .score-form-section .form-control {
            min-height: 48px;
            font-size: 16px;
        }

        .form-note-select {
            border-color: #cbd5e1;
            border-radius: 13px;
            color: var(--text);
            font-weight: 700;
        }

        .switch-wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 64px;
            margin: 0;
            padding: 10px 12px;
            border: 1px solid #fed7aa;
            border-radius: 13px;
            background: #fff7ed;
        }

        .completion-copy {
            min-width: 0;
        }

        .completion-copy strong,
        .completion-copy span {
            display: block;
        }

        .completion-copy strong {
            color: #9a3412;
            font-size: 13px;
            font-weight: 900;
        }

        .completion-copy span {
            margin-top: 2px;
            color: #9a3412;
            font-size: 11px;
            line-height: 1.4;
        }

        .switch-wrap .custom-control {
            flex: 0 0 auto;
            width: 56px;
            min-height: 44px;
            padding-left: 56px;
        }

        .switch-wrap .custom-control-label {
            position: absolute;
            inset: 0;
            width: 56px;
            min-height: 44px;
            cursor: pointer;
        }

        .switch-wrap .custom-control-label::before {
            top: 9px;
            left: 0;
            width: 48px;
            height: 26px;
            border-color: #cbd5e1;
            border-radius: 999px;
        }

        .switch-wrap .custom-control-label::after {
            top: 12px;
            left: 3px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
        }

        .switch-wrap .custom-control-input:checked ~ .custom-control-label::after {
            transform: translateX(22px);
        }

        .score-form-section .btn-success {
            min-height: 56px;
            margin-top: 14px;
            border: 0;
            border-radius: 15px;
            background: var(--success);
            font-size: 15px;
            font-weight: 900;
            box-shadow: 0 12px 24px rgba(22, 163, 74, .2);
        }

        .score-form-section .btn-success:hover:not(:disabled),
        .score-form-section .btn-success:focus:not(:disabled) {
            background: #15803d;
        }

        .focus-scoreboard {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
            align-items: stretch;
            gap: 8px;
            margin: 0;
            padding: 0;
            border: 0;
        }

        .focus-team,
        .focus-team.right {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-width: 0;
            min-height: 144px;
            padding: 14px 10px;
            border: 1px solid #dbe4f0;
            border-radius: 17px;
            background: var(--surface-soft);
            color: var(--text);
            font-size: 14px;
            text-align: center;
        }

        .focus-team span {
            display: -webkit-box;
            font-weight: 900;
            line-height: 1.35;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            overflow-wrap: anywhere;
        }

        .focus-team strong {
            color: var(--dark);
            font-size: clamp(42px, 15vw, 68px);
            font-weight: 900;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .focus-team.winner {
            border-color: #fdba74;
            background: #fff7ed;
            color: #9a3412;
        }

        .focus-score-separator {
            display: flex;
            align-items: center;
            color: #94a3b8;
            font-size: 28px;
            font-weight: 900;
        }

        .focus-lock {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-top: 12px;
            padding: 12px;
            border-radius: 13px;
            line-height: 1.5;
        }

        .focus-lock i {
            margin-top: 3px;
        }

        .focus-secondary {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
            margin-top: 12px;
        }

        .disclosure-panel,
        .history-section {
            padding: 0;
            border: 1px solid #dbe4f0;
            border-radius: 16px;
            background: #fff;
            overflow: hidden;
        }

        .disclosure-panel summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 52px;
            padding: 12px 14px;
            color: #334155;
            font-size: 14px;
            font-weight: 900;
            cursor: pointer;
            list-style: none;
            touch-action: manipulation;
        }

        .disclosure-panel summary::-webkit-details-marker {
            display: none;
        }

        .disclosure-panel summary > span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .disclosure-panel summary > span > i {
            color: var(--primary);
        }

        .disclosure-panel summary small {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 24px;
            height: 24px;
            padding: 0 7px;
            border-radius: 999px;
            background: #e2e8f0;
            color: #334155;
            font-size: 11px;
        }

        .disclosure-panel summary:hover {
            background: var(--surface-soft);
        }

        .disclosure-chevron {
            color: #64748b;
            transition: transform .18s ease;
        }

        .disclosure-panel[open] .disclosure-chevron {
            transform: rotate(180deg);
        }

        .match-info-grid,
        .history-content {
            border-top: 1px solid #e2e8f0;
        }

        .match-info-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
            padding: 4px 14px 12px;
        }

        .match-info-grid > div {
            display: grid;
            gap: 3px;
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .match-info-grid > div:last-child {
            border-bottom: 0;
        }

        .match-info-grid span {
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .match-info-grid strong {
            color: var(--text);
            font-size: 13px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .history-content {
            padding: 12px;
        }

        .history-list {
            max-height: 340px;
            padding-right: 3px;
        }

        .history-item {
            margin-bottom: 8px;
            border-radius: 12px;
        }

        .history-item:last-child {
            margin-bottom: 0;
        }

        .score-toast {
            z-index: 4100;
            width: max-content;
            max-width: calc(100vw - 24px);
            min-height: 44px;
            border-radius: 14px;
            text-align: center;
        }

        .end-match-modal {
            z-index: 4200;
            align-items: flex-end;
            padding: 12px 12px max(12px, env(safe-area-inset-bottom));
            background: rgba(15, 23, 42, .72);
        }

        .end-match-dialog {
            width: min(480px, 100%);
            max-height: calc(100dvh - 24px - env(safe-area-inset-top));
            overflow-y: auto;
            padding: 20px;
            border-radius: 22px;
        }

        .end-match-title {
            font-size: 22px;
        }

        .end-match-text {
            margin-bottom: 12px;
            color: #475569;
            font-size: 14px;
        }

        .end-match-summary {
            margin-bottom: 16px;
            padding: 14px;
            border: 1px solid #dbe4f0;
            border-radius: 15px;
            background: var(--surface-soft);
            text-align: center;
        }

        .end-match-summary-id {
            color: var(--primary-dark);
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .end-match-summary-teams {
            margin-top: 7px;
            color: var(--text);
            font-size: 13px;
            font-weight: 800;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }

        .end-match-summary-score {
            margin-top: 10px;
            color: var(--dark);
            font-size: 42px;
            font-weight: 900;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .end-match-actions {
            grid-template-columns: 1fr 1.15fr;
        }

        .end-match-actions .btn {
            min-height: 52px;
        }

        @@media (max-width: 479px) {
            .topbar-right .small {
                display: none;
            }

            .logout-label {
                display: none;
            }

            #btnLogout {
                width: 44px;
                padding: 0;
            }

            .page-heading {
                align-items: center;
            }

            .page-count {
                min-width: 64px;
            }

            .match-card-footer {
                align-items: center;
            }

            .match-card-tournament {
                max-width: 58%;
            }
        }

        @@media (max-width: 359px) {
            .topbar,
            .page-wrap,
            .overlay-header,
            .overlay-body {
                padding-left: 8px;
                padding-right: 8px;
            }

            .portal-name {
                font-size: 14px;
            }

            #btnCloseOverlay {
                padding: 0 8px;
                font-size: 12px;
            }

            .match-card,
            .score-form-section {
                padding: 12px;
                border-radius: 16px;
            }

            .match-chip {
                max-width: 108px;
                white-space: normal;
            }

            .score-stepper {
                grid-template-columns: 56px minmax(0, 1fr) 62px;
                gap: 7px;
            }

            .score-stepper-btn {
                min-width: 56px;
                min-height: 60px;
            }

            .score-form-section .big-score-box input {
                height: 60px;
                font-size: 34px;
            }

            .score-auto-save-hint {
                white-space: normal;
                text-align: right;
            }

            .end-match-dialog {
                padding: 16px;
            }
        }

        @@media (min-width: 640px) {
            .page-wrap {
                padding: 26px 20px 42px;
            }

            .overlay-header {
                padding-right: 20px;
                padding-left: 20px;
            }

            .overlay-body {
                padding: 20px 20px calc(36px + env(safe-area-inset-bottom));
            }

            .score-form-section {
                padding: 22px;
            }

            .score-form-options {
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                align-items: end;
            }

            .switch-wrap {
                min-height: 72px;
            }

            .match-info-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                column-gap: 24px;
            }

            .match-info-address {
                grid-column: 1 / -1;
            }

            .end-match-modal {
                align-items: center;
            }
        }

        @@media (min-width: 768px) {
            .topbar {
                padding: calc(12px + env(safe-area-inset-top)) 24px 12px;
            }

            .topbar-search {
                right: 24px;
                left: auto;
                width: min(390px, calc(100vw - 48px));
            }

            .big-score-inputs {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px;
            }

            .big-score-box {
                padding: 16px;
            }

            .score-stepper {
                grid-template-columns: 68px minmax(0, 1fr) 76px;
                gap: 10px;
            }

            .score-stepper-btn,
            .score-form-section .big-score-box input {
                min-height: 76px;
                height: 76px;
            }

            .score-form-section .big-score-box input {
                font-size: 48px;
            }

            .focus-secondary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                align-items: start;
            }
        }

        @@media (min-width: 900px) {
            .match-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .match-card {
                padding: 18px;
            }

            .overlay-title {
                font-size: 20px;
            }

            .score-form-section {
                padding: 26px;
            }

            .section-title {
                font-size: 24px;
            }
        }

        @@media (orientation: landscape) and (max-height: 520px) {
            .topbar {
                position: sticky;
            }

            .overlay-panel {
                overflow: hidden;
            }

            .overlay-header {
                position: sticky;
                min-height: 54px;
                padding: calc(5px + env(safe-area-inset-top)) 8px 5px;
            }

            #btnCloseOverlay {
                min-height: 42px;
            }

            .overlay-title {
                display: block;
                font-size: 14px;
            }

            .overlay-subtitle {
                display: block;
                font-size: 10px;
            }

            .overlay-body {
                padding: 8px 8px calc(12px + env(safe-area-inset-bottom));
            }

            .focus-match {
                display: block;
                min-height: 0;
                padding: 0;
            }

            .focus-top {
                display: block;
                margin-bottom: 8px;
                padding: 8px 10px;
            }

            .match-context-title {
                font-size: 12px;
            }

            .match-context-line {
                margin-top: 3px;
                font-size: 10px;
            }

            .score-form-section {
                display: block;
                padding: 10px;
                border-radius: 14px;
            }

            .score-section-header {
                margin-bottom: 8px;
            }

            .section-kicker {
                display: none;
            }

            .section-title {
                font-size: 15px;
            }

            .big-score-inputs {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 8px;
            }

            .big-score-box {
                padding: 8px;
                border-radius: 12px;
            }

            .score-team-heading {
                min-height: 28px;
                margin-bottom: 4px;
            }

            .big-score-box label {
                font-size: 12px;
                -webkit-line-clamp: 1;
            }

            .score-stepper {
                grid-template-columns: 48px minmax(0, 1fr) 54px;
                gap: 6px;
            }

            .score-stepper-btn,
            .score-form-section .big-score-box input {
                min-height: 50px;
                height: 50px;
                border-radius: 12px;
            }

            .score-stepper-btn {
                min-width: 48px;
                font-size: 18px;
                box-shadow: none;
            }

            .score-form-section .big-score-box input {
                font-size: 28px;
            }

            .score-save-status {
                min-height: 36px;
                margin-top: 7px;
                padding: 7px 9px;
                font-size: 11px;
            }

            .score-form-options {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 8px;
                margin-top: 8px;
            }

            .situation-field label {
                display: none;
            }

            .form-note-select,
            .score-form-section .form-control {
                min-height: 44px;
                height: 44px;
                font-size: 14px;
            }

            .switch-wrap {
                min-height: 44px;
                padding: 4px 8px;
            }

            .completion-copy span {
                display: none;
            }

            .score-form-section .btn-success {
                min-height: 44px;
                margin-top: 8px;
            }

            .focus-secondary {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                margin-top: 8px;
            }

            .history-section {
                display: block;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="topbar-left">
            <i class="fas fa-gavel"></i>
            <span class="portal-name">Cổng trọng tài</span>
        </div>
        <div class="topbar-right">
            <span id="meBox" class="small"></span>
            <div class="topbar-actions">
                <button class="topbar-icon-btn" id="btnSearchToggle" type="button" aria-label="Tìm trận đấu" aria-expanded="false" aria-controls="matchSearchPopover">
                    <i class="fas fa-search"></i>
                </button>
                <button class="btn btn-sm btn-light" id="btnLogout" type="button">
                    <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                    <span class="logout-label">Đăng xuất</span>
                </button>
            </div>
        </div>
        <div class="topbar-search" id="matchSearchPopover" role="search">
            <div class="search-input-shell">
                <i class="fas fa-search"></i>
                <input type="search" id="matchSearchInput" placeholder="Tìm theo mã trận hoặc tên đội" autocomplete="off" />
                <button type="button" class="search-clear-btn" id="btnSearchClear" aria-label="Xóa tìm kiếm">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="search-hint" id="searchHint">Nhập mã trận hoặc tên đội để lọc nhanh.</div>
        </div>
    </div>

    <main class="page-wrap" id="mainContent">
        <div class="page-heading">
            <div>
                <h1 class="page-title">Trận đấu được phân công</h1>
                <div class="page-subtitle">
                    Chọn đúng trận để vào màn hình chấm điểm. Hệ thống sẽ hiển thị rõ khi trận có thể chấm.
                </div>
            </div>
            <div class="page-count" id="matchCountBadge" aria-live="polite"></div>
        </div>

        <div id="errBox" class="alert alert-danger d-none"></div>

        <div id="cards" class="match-grid" aria-busy="true">
            <div class="match-card-skeleton" aria-hidden="true"></div>
            <div class="match-card-skeleton" aria-hidden="true"></div>
            <span class="sr-only">Đang tải danh sách trận đấu...</span>
        </div>
    </main>

    <!-- Full screen overlay -->
    <div class="overlay" id="matchOverlay">
        <div class="overlay-panel">
            <div class="overlay-header">
                <button type="button" class="btn btn-outline-secondary" id="btnCloseOverlay" aria-label="Quay lại danh sách trận đấu">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    <span>Danh sách trận</span>
                </button>

                <div class="overlay-heading">
                    <div class="overlay-title" id="overlayTitle" tabindex="-1">Chi tiết trận đấu</div>
                    <div class="overlay-subtitle" id="overlaySubtitle"></div>
                </div>
            </div>

            <div class="overlay-body">
                <div id="overlayContent"></div>
            </div>
        </div>
    </div>

    <div class="score-toast" id="scoreToast" role="status" aria-live="polite" aria-atomic="true"></div>

    <div class="end-match-modal" id="endMatchConfirm" aria-hidden="true">
        <div class="end-match-dialog" role="dialog" aria-modal="true" aria-labelledby="endMatchConfirmTitle" aria-describedby="endMatchConfirmText">
            <div class="end-match-icon">
                <i class="fas fa-flag-checkered" aria-hidden="true"></i>
            </div>
            <div class="end-match-title" id="endMatchConfirmTitle">Kết thúc trận đấu?</div>
            <div class="end-match-text" id="endMatchConfirmText">
                Kiểm tra lại thông tin trước khi xác nhận. Thao tác này sẽ lưu tỷ số và kết thúc trận.
            </div>
            <div class="end-match-summary">
                <div class="end-match-summary-id" id="endMatchConfirmMatch"></div>
                <div class="end-match-summary-teams" id="endMatchConfirmTeams"></div>
                <div class="end-match-summary-score" id="endMatchConfirmScore"></div>
            </div>
            <div class="end-match-actions">
                <button type="button" class="btn btn-outline-secondary" id="btnEndMatchCancel">Xem lại</button>
                <button type="button" class="btn btn-success" id="btnEndMatchConfirm">
                    <i class="fas fa-check"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/js/api-loading.js" asp-append-version="true"></script>
    <script src="~/js/public-realtime.js" asp-append-version="true"></script>

    <script>
        (() => {
            const $id = (id) => document.getElementById(id);
            const API = `/api/referee/matches`;
            const SAVE_REQUEST_TIMEOUT_MS = 15000;
            const READ_REQUEST_TIMEOUT_MS = 12000;
            const RESUME_IDLE_THRESHOLD_MS = 30000;
            const RESUME_DEBOUNCE_MS = 600;

            let CACHE = { items: [] };
            let ACTIVE_MATCH_ID = null;
            let SCORE_SAVE_BUSY = false;
            let ACTIVE_SCORE_REQUEST = null;
            let RECOVERY_BUSY = false;
            let RECOVERY_TIMER = null;
            let RECOVERY_REQUIRED = false;
            let PAGE_HIDDEN_AT = document.hidden ? Date.now() : null;
            let LAST_PAGE_ACTIVE_AT = Date.now();
            let AUTH_REDIRECTING = false;
            let SCORE_TOAST_TIMER = null;
            let REFRESH_CARDS_ON_CLOSE = false;
            let SEARCH_QUERY = "";
            let END_MATCH_CONFIRM_RESOLVE = null;
            let END_MATCH_CONFIRM_TRIGGER = null;
            let OVERLAY_TRIGGER = null;
            let INLINE_SCORE_BASELINE = null;
            let OPEN_MATCH_DETAIL_KEY = null;
            let SCORE_DATA_REVISION = 0;
            let MATCH_LIST_LOAD_SEQUENCE = 0;
            let PENDING_REALTIME_SYNC = false;
            let REALTIME_SYNC_TIMER = null;
            let REMOVE_REALTIME_LISTENER = null;
            const REALTIME_TOURNAMENT_IDS = new Set();

            const esc = (s) => String(s || "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

            const fmt = (dt) => {
                if (!dt) return "—";
                const d = new Date(dt);
                if (isNaN(d.getTime())) return "—";
                const yyyy = d.getFullYear();
                const mm = String(d.getMonth() + 1).padStart(2, "0");
                const dd = String(d.getDate()).padStart(2, "0");
                const hh = String(d.getHours()).padStart(2, "0");
                const mi = String(d.getMinutes()).padStart(2, "0");
                return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
            };

            function showErr(msg) {
                const box = $id("errBox");
                box.textContent = msg || "Đã xảy ra lỗi";
                box.classList.remove("d-none");
            }

            function hideErr() {
                const box = $id("errBox");
                box.classList.add("d-none");
                box.textContent = "";
            }

            function getMatch(matchId) {
                return (CACHE.items || []).find(x => x.matchId === matchId) || null;
            }

            function getPrimaryStatus(m) {
                if (m.isCompleted) {
                    return {
                        label: "Đã kết thúc",
                        className: "success",
                        icon: "fa-check-circle"
                    };
                }

                if (m.canEditScore) {
                    return {
                        label: "Có thể chấm",
                        className: "active",
                        icon: "fa-clipboard-check"
                    };
                }

                return {
                    label: "Chưa thể chấm",
                    className: "muted",
                    icon: "fa-lock"
                };
            }

            function getPrimaryStatusBadge(m) {
                const status = getPrimaryStatus(m);
                return `<span class="match-chip ${status.className}"><i class="fas ${status.icon}" aria-hidden="true"></i> ${status.label}</span>`;
            }

            function fmtCardStart(dt) {
                if (!dt) return "Chưa có giờ";
                const d = new Date(dt);
                if (isNaN(d.getTime())) return "Chưa có giờ";

                const dd = String(d.getDate()).padStart(2, "0");
                const mm = String(d.getMonth() + 1).padStart(2, "0");
                const hh = String(d.getHours()).padStart(2, "0");
                const mi = String(d.getMinutes()).padStart(2, "0");
                return `${dd}/${mm} · ${hh}:${mi}`;
            }

            function cardHtml(m) {
                const completed = !!m.isCompleted;
                const t1Winner = completed && m.winnerRegistrationId && m.winnerRegistrationId === m.team1RegistrationId;
                const t2Winner = completed && m.winnerRegistrationId && m.winnerRegistrationId === m.team2RegistrationId;
                const status = getPrimaryStatus(m);
                const actionLabel = m.canEditScore && !completed ? "Vào chấm điểm" : "Xem chi tiết";
                const cardClass = completed ? "completed" : m.canEditScore ? "active" : "locked";
                const accessibleLabel = `${actionLabel} trận ${m.matchId}, ${m.team1Text} ${Number(m.scoreTeam1 || 0)}, ${m.team2Text} ${Number(m.scoreTeam2 || 0)}, ${status.label}`;

                return `
                    <article class="match-card ${cardClass}">
                        <button type="button" class="match-card-action" onclick="openMatchDetail(${m.matchId})" aria-label="${esc(accessibleLabel)}"></button>

                        <div class="match-card-overview">
                            <div class="match-card-identity">
                                <div class="match-id-badge">Trận #${m.matchId}</div>
                                <div class="match-schedule">
                                    <i class="far fa-clock" aria-hidden="true"></i>
                                    <span>${fmtCardStart(m.startAt)}</span>
                                    ${m.courtText ? `<span aria-hidden="true">•</span><span>${esc(m.courtText)}</span>` : ``}
                                </div>
                            </div>
                            ${getPrimaryStatusBadge(m)}
                        </div>

                        <div class="score-preview" aria-label="Tỷ số ${esc(m.team1Text)} ${Number(m.scoreTeam1 || 0)}, ${esc(m.team2Text)} ${Number(m.scoreTeam2 || 0)}">
                            <div class="score-preview-row ${t1Winner ? "winner" : ""}">
                                <span class="team-preview">${esc(m.team1Text)}</span>
                                <strong class="score-preview-value">${Number(m.scoreTeam1 || 0)}</strong>
                            </div>
                            <div class="score-preview-row ${t2Winner ? "winner" : ""}">
                                <span class="team-preview">${esc(m.team2Text)}</span>
                                <strong class="score-preview-value">${Number(m.scoreTeam2 || 0)}</strong>
                            </div>
                        </div>

                        <div class="match-card-footer">
                            <div class="match-card-tournament">
                                <span>${esc(m.tournamentTitle)}</span>
                                <small>${esc(m.roundLabel || m.roundKey)}${m.groupName ? " · " + esc(m.groupName) : ""}</small>
                            </div>
                            <span class="hint-click">
                                ${actionLabel} <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </span>
                        </div>
                    </article>
                `;
            }

            function historyHtml(histories) {
                if (!histories || !histories.length) {
                    return `<div class="history-empty">Chưa có lịch sử chấm điểm.</div>`;
                }

                return `
                    <div class="history-list">
                        ${histories.map(h => `
                            <div class="history-item">
                                <div class="history-score">
                                    ${Number(h.scoreTeam1 || 0)} - ${Number(h.scoreTeam2 || 0)}
                                    ${h.winnerTeam ? `<span class="badge badge-warning ml-2">Đội thắng: ${h.winnerTeam}</span>` : ``}
                                </div>
                                <div class="history-meta">
                                    ${esc(h.refereeName || ("User #" + h.refereeUserId))} • ${fmt(h.createdAt)}
                                </div>
                                ${h.note ? `<div class="history-note">${esc(h.note)}</div>` : ``}
                            </div>
                        `).join("")}
                    </div>
                `;
            }

            function detailHtml(m) {
                const completed = !!m.isCompleted;
                const t1Winner = completed && m.winnerRegistrationId && m.winnerRegistrationId === m.team1RegistrationId;
                const t2Winner = completed && m.winnerRegistrationId && m.winnerRegistrationId === m.team2RegistrationId;
                const historyCount = Array.isArray(m.scoreHistories) ? m.scoreHistories.length : 0;
                const currentScoreText = `${Number(m.scoreTeam1 || 0)}–${Number(m.scoreTeam2 || 0)}`;

                return `
                    <article class="focus-match">
                        <div class="focus-top">
                            <div class="match-context">
                                <div class="match-context-heading">
                                    <div class="match-context-title">${esc(m.tournamentTitle)}</div>
                                    <div class="focus-badges">
                                        ${getPrimaryStatusBadge(m)}
                                    </div>
                                </div>
                                <div class="match-context-line">
                                    <span><i class="far fa-clock" aria-hidden="true"></i>${fmtCardStart(m.startAt)}</span>
                                    <span><i class="fas fa-map-marker-alt" aria-hidden="true"></i>${esc(m.courtText || "Chưa có sân")}</span>
                                </div>
                            </div>
                        </div>

                        <section class="score-form-section" aria-labelledby="scoreSectionTitle">
                            <div class="score-section-header">
                                <div>
                                    <div class="section-kicker">Bảng điều khiển trọng tài</div>
                                    <h2 class="section-title" id="scoreSectionTitle">Tỷ số trận đấu</h2>
                                </div>
                                ${m.canEditScore ? `<div class="score-auto-save-hint"><i class="fas fa-bolt" aria-hidden="true"></i> Cộng/trừ tự lưu</div>` : ``}
                            </div>

                            ${m.canEditScore ? `
                                <form id="inlineScoreForm">
                                    <div id="inlineScoreErr" class="alert alert-danger d-none" role="alert" aria-live="assertive" tabindex="-1"></div>

                                    <fieldset class="score-fieldset">
                                        <legend class="sr-only">Nhập điểm cho hai đội</legend>
                                        <div class="big-score-inputs">
                                            <div class="big-score-box ${t1Winner ? "winner" : ""}">
                                                <div class="score-team-heading">
                                                    <span class="score-team-number">Đội 1</span>
                                                    <label for="inlineScore1">${esc(m.team1Text)}</label>
                                                </div>
                                                <div class="score-stepper">
                                                    <button type="button" class="score-stepper-btn score-stepper-btn--minus" data-score-target="inlineScore1" data-score-step="-1" aria-label="Trừ 1 điểm cho ${esc(m.team1Text)}">
                                                        <i class="fas fa-minus" aria-hidden="true"></i>
                                                    </button>
                                                    <input type="text" class="form-control" id="inlineScore1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" enterkeyhint="done" value="${Number(m.scoreTeam1 || 0)}" aria-label="Điểm ${esc(m.team1Text)}" aria-describedby="scoreSaveStatus inlineScoreErr" />
                                                    <button type="button" class="score-stepper-btn" data-score-target="inlineScore1" data-score-step="1" aria-label="Cộng 1 điểm cho ${esc(m.team1Text)}">
                                                        <i class="fas fa-plus" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="big-score-box ${t2Winner ? "winner" : ""}">
                                                <div class="score-team-heading">
                                                    <span class="score-team-number">Đội 2</span>
                                                    <label for="inlineScore2">${esc(m.team2Text)}</label>
                                                </div>
                                                <div class="score-stepper">
                                                    <button type="button" class="score-stepper-btn score-stepper-btn--minus" data-score-target="inlineScore2" data-score-step="-1" aria-label="Trừ 1 điểm cho ${esc(m.team2Text)}">
                                                        <i class="fas fa-minus" aria-hidden="true"></i>
                                                    </button>
                                                    <input type="text" class="form-control" id="inlineScore2" inputmode="numeric" pattern="[0-9]*" autocomplete="off" enterkeyhint="done" value="${Number(m.scoreTeam2 || 0)}" aria-label="Điểm ${esc(m.team2Text)}" aria-describedby="scoreSaveStatus inlineScoreErr" />
                                                    <button type="button" class="score-stepper-btn" data-score-target="inlineScore2" data-score-step="1" aria-label="Cộng 1 điểm cho ${esc(m.team2Text)}">
                                                        <i class="fas fa-plus" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>

                                    <div class="score-save-status idle" id="scoreSaveStatus" role="status" aria-live="polite" aria-atomic="true">
                                        <i class="fas fa-check-circle" aria-hidden="true"></i>
                                        <span>Tỷ số ${currentScoreText} đã sẵn sàng</span>
                                    </div>

                                    <div class="score-form-options">
                                        <div class="form-group situation-field">
                                            <label for="inlineScoreNote">Tình huống</label>
                                            <select class="form-control form-note-select" id="inlineScoreNote">
                                                <option value="">-- Chọn tình huống --</option>
                                                <option value="Tay Hai">Tay Hai</option>
                                                <option value="Tay Một">Tay Một</option>
                                                <option value="Đổi tay">Đổi tay</option>
                                            </select>
                                        </div>

                                        <div class="switch-wrap">
                                            <div class="completion-copy">
                                                <strong>Kết thúc trận đấu</strong>
                                                <span>Bật sau khi đã kiểm tra đúng tỷ số.</span>
                                            </div>
                                            <div class="custom-control custom-switch">
                                                <input type="checkbox" class="custom-control-input" id="inlineIsCompleted" ${completed ? "checked" : ""}>
                                                <label class="custom-control-label" for="inlineIsCompleted"><span class="sr-only">Kết thúc trận đấu</span></label>
                                            </div>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-success btn-block" id="btnInlineSubmit">
                                        <i class="fas fa-save" aria-hidden="true"></i> Lưu điểm cho trận này
                                    </button>
                                </form>
                            ` : `
                                <div class="focus-scoreboard" aria-label="Tỷ số hiện tại ${esc(m.team1Text)} ${Number(m.scoreTeam1 || 0)}, ${esc(m.team2Text)} ${Number(m.scoreTeam2 || 0)}">
                                    <div class="focus-team ${t1Winner ? "winner" : ""}">
                                        <span>${esc(m.team1Text)}</span>
                                        <strong data-live-score="team1">${Number(m.scoreTeam1 || 0)}</strong>
                                    </div>
                                    <div class="focus-score-separator" aria-hidden="true">–</div>
                                    <div class="focus-team right ${t2Winner ? "winner" : ""}">
                                        <span>${esc(m.team2Text)}</span>
                                        <strong data-live-score="team2">${Number(m.scoreTeam2 || 0)}</strong>
                                    </div>
                                </div>
                                <div class="focus-lock" role="status">
                                    <i class="fas fa-lock" aria-hidden="true"></i>
                                    <span>Trận này đang ở chế độ chỉ xem. Trọng tài chỉ có thể chấm khi đáp ứng thời gian thi đấu hiện tại.</span>
                                </div>
                            `}
                        </section>

                        <div class="focus-secondary">
                            <details class="disclosure-panel match-info-section">
                                <summary>
                                    <span><i class="fas fa-info-circle" aria-hidden="true"></i> Thông tin trận đấu</span>
                                    <i class="fas fa-chevron-down disclosure-chevron" aria-hidden="true"></i>
                                </summary>
                                <div class="match-info-grid">
                                    <div><span>Giải đấu</span><strong>${esc(m.tournamentTitle)}</strong></div>
                                    <div><span>Vòng / Bảng</span><strong>${esc(m.roundKey)} · ${esc(m.roundLabel)}${m.groupName ? " · " + esc(m.groupName) : ""}</strong></div>
                                    <div><span>Bắt đầu</span><strong>${fmt(m.startAt)}</strong></div>
                                    <div><span>Sân</span><strong>${esc(m.courtText || "—")}</strong></div>
                                    <div class="match-info-address"><span>Địa chỉ</span><strong>${esc(m.addressText || "—")}</strong></div>
                                </div>
                            </details>

                            <details class="history-section disclosure-panel">
                                <summary>
                                    <span><i class="fas fa-history" aria-hidden="true"></i> Lịch sử chấm điểm <small>${historyCount}</small></span>
                                    <i class="fas fa-chevron-down disclosure-chevron" aria-hidden="true"></i>
                                </summary>
                                <div class="history-content">
                                    ${historyHtml(m.scoreHistories)}
                                </div>
                            </details>
                        </div>
                    </article>
                `;
            }

            function normalizeSearchText(value) {
                return String(value || "")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();
            }

            function getSearchText(m) {
                return normalizeSearchText([
                    m.matchId,
                    `#${m.matchId}`,
                    m.team1Text,
                    m.team2Text
                ].join(" "));
            }

            function getVisibleMatches() {
                const items = CACHE.items || [];
                const query = normalizeSearchText(SEARCH_QUERY);

                if (!query) return items;

                return items.filter(m => getSearchText(m).includes(query));
            }

            function updateSearchHint(visibleCount, totalCount) {
                const hint = $id("searchHint");
                const toggle = $id("btnSearchToggle");
                if (!hint || !toggle) return;

                const hasQuery = !!SEARCH_QUERY.trim();
                toggle.classList.toggle("active", hasQuery);

                if (!hasQuery) {
                    hint.textContent = "Nhập mã trận hoặc tên đội để lọc nhanh.";
                    return;
                }

                hint.textContent = `Đang hiển thị ${visibleCount}/${totalCount} trận phù hợp.`;
            }

            function render() {
                const box = $id("cards");
                const countBadge = $id("matchCountBadge");
                const allItems = CACHE.items || [];
                const items = getVisibleMatches();

                updateSearchHint(items.length, allItems.length);
                box.setAttribute("aria-busy", "false");

                if (countBadge) {
                    countBadge.textContent = SEARCH_QUERY.trim()
                        ? `${items.length}/${allItems.length} trận`
                        : `${allItems.length} trận`;
                }

                if (!allItems.length) {
                    box.innerHTML = `
                        <div class="empty-box">
                            <i class="far fa-calendar-check" aria-hidden="true"></i>
                            <strong>Chưa có trận được phân công</strong>
                            <span>Danh sách sẽ xuất hiện tại đây khi trọng tài được phân công trận đấu.</span>
                        </div>`;
                    return;
                }

                if (!items.length) {
                    box.innerHTML = `
                        <div class="empty-box">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <strong>Không tìm thấy trận phù hợp</strong>
                            <span>Thử lại bằng mã trận hoặc tên đội khác.</span>
                        </div>`;
                    return;
                }

                box.innerHTML = items.map(cardHtml).join("");
            }

            function getMatchIdFromUrl() {
                const params = new URLSearchParams(window.location.search);
                const queryId = Number(params.get("matchId") || 0);

                if (Number.isFinite(queryId) && queryId > 0) {
                    return queryId;
                }

                const parts = window.location.pathname.replace(/\/+$/, "").split("/").filter(Boolean);
                const isMatchesPage = parts[0]?.toLowerCase() === "refereeportal" && parts[1]?.toLowerCase() === "matches";
                const pathId = Number(isMatchesPage ? parts[2] : 0);

                return Number.isFinite(pathId) && pathId > 0 ? pathId : null;
            }

            function setMatchUrl(matchId, replace = false) {
                const nextUrl = `/RefereePortal/Matches/${encodeURIComponent(matchId)}`;
                const currentUrl = `${window.location.pathname}${window.location.search}`;
                if (currentUrl === nextUrl) return;

                window.history[replace ? "replaceState" : "pushState"]({ matchId }, "", nextUrl);
            }

            function setMatchesListUrl() {
                const nextUrl = "/RefereePortal/Matches";
                const currentUrl = `${window.location.pathname}${window.location.search}`;
                if (currentUrl === nextUrl) return;

                window.history.replaceState({ matchId: null }, "", nextUrl);
            }

            function getMatchDetailKey(m) {
                // Score results are synchronized in place; only structural changes rebuild the detail.
                return JSON.stringify([
                    m.matchId, m.tournamentTitle, m.roundKey, m.roundLabel, m.groupName,
                    m.startAt, m.courtText, m.addressText, m.team1RegistrationId, m.team2RegistrationId,
                    m.team1Text, m.team2Text, m.canEditScore
                ]);
            }

            function updateOpenMatchScore(m) {
                const previousScore = captureInlineScoreState();
                syncInlineScoreView(m);
                const completed = !!m.isCompleted;
                const completionInput = $id("inlineIsCompleted");
                if (completionInput) completionInput.checked = completed;

                const badges = document.querySelector("#overlayContent .focus-badges");
                const badgeMarkup = getPrimaryStatusBadge(m);
                if (badges && badges.innerHTML.trim() !== badgeMarkup.trim()) badges.innerHTML = badgeMarkup;

                [1, 2].forEach(side => {
                    const score = $id(`inlineScore${side}`)
                        || document.querySelector(`#overlayContent [data-live-score='team${side}']`);
                    const team = score?.closest(".big-score-box, .focus-team");
                    const winner = completed && m.winnerRegistrationId != null
                        && m.winnerRegistrationId === m[`team${side}RegistrationId`];
                    team?.classList.toggle("winner", winner);
                });

                const history = document.querySelector("#overlayContent .history-content");
                const historyCount = document.querySelector("#overlayContent .history-section summary small");
                const histories = Array.isArray(m.scoreHistories) ? m.scoreHistories : [];
                const markup = historyHtml(histories);
                if (history && history.innerHTML.trim() !== markup.trim()) history.innerHTML = markup;
                if (historyCount) historyCount.textContent = String(histories.length);
                if (previousScore && (previousScore.scoreTeam1 !== Number(m.scoreTeam1 || 0)
                    || previousScore.scoreTeam2 !== Number(m.scoreTeam2 || 0))) {
                    setScoreSaveStatus(`Đã cập nhật tỷ số ${Number(m.scoreTeam1 || 0)}–${Number(m.scoreTeam2 || 0)}`, "success");
                }
            }

            function openOverlay(matchId, options = {}) {
                ACTIVE_MATCH_ID = matchId;
                const m = getMatch(matchId);
                if (!m) return;
                const overlay = $id("matchOverlay");
                const wasOpen = overlay.classList.contains("show");

                if (!wasOpen) {
                    OVERLAY_TRIGGER = document.activeElement instanceof HTMLElement
                        ? document.activeElement
                        : null;
                }

                $id("overlayTitle").textContent = `Trận #${m.matchId}`;
                $id("overlaySubtitle").textContent = [
                    fmtCardStart(m.startAt),
                    m.courtText || null
                ].filter(Boolean).join(" • ");
                const detailKey = getMatchDetailKey(m);
                if (options.incremental && wasOpen && OPEN_MATCH_DETAIL_KEY === detailKey) {
                    updateOpenMatchScore(m);
                } else {
                    const scrollContainer = overlay.querySelector(".overlay-body");
                    const scrollTop = wasOpen ? scrollContainer.scrollTop : 0;
                    const openDetails = Array.from(overlay.querySelectorAll("details")).map(x => x.open);
                    $id("overlayContent").innerHTML = detailHtml(m);
                    OPEN_MATCH_DETAIL_KEY = detailKey;
                    if (wasOpen) {
                        overlay.querySelectorAll("details").forEach((element, index) => { element.open = !!openDetails[index]; });
                    }
                    bindInlineScoreForm();
                    scrollContainer.scrollTop = scrollTop;
                }
                overlay.classList.add("show");
                document.body.style.overflow = "hidden";

                INLINE_SCORE_BASELINE = captureInlineScoreState();

                if (!wasOpen && options.focusTitle !== false) {
                    window.setTimeout(() => $id("overlayTitle")?.focus({ preventScroll: true }), 0);
                }

                if (options.syncUrl !== false) {
                    setMatchUrl(matchId, !!options.replaceUrl);
                }
            }

            function closeOverlay(options = {}) {
                ACTIVE_MATCH_ID = null;
                INLINE_SCORE_BASELINE = null;
                OPEN_MATCH_DETAIL_KEY = null;
                $id("matchOverlay").classList.remove("show");
                $id("overlayContent").innerHTML = "";
                document.body.style.overflow = "";

                if (REFRESH_CARDS_ON_CLOSE) {
                    render();
                    REFRESH_CARDS_ON_CLOSE = false;
                }

                if (options.syncUrl !== false) {
                    setMatchesListUrl();
                }

                if (PENDING_REALTIME_SYNC) {
                    PENDING_REALTIME_SYNC = false;
                    scheduleRealtimeSync();
                }

                const trigger = OVERLAY_TRIGGER;
                OVERLAY_TRIGGER = null;
                if (options.restoreFocus !== false && trigger?.isConnected) {
                    window.setTimeout(() => trigger.focus({ preventScroll: true }), 0);
                }
            }

            function normalizeScoreInput(input, fallbackToZero = false) {
                if (!input) return "0";

                const cleaned = String(input.value || "").replace(/[^\d]/g, "");
                const nextValue = fallbackToZero && cleaned === "" ? "0" : cleaned;

                if (input.value !== nextValue) {
                    input.value = nextValue;
                }

                return nextValue;
            }

            function readScoreInput(input) {
                const value = normalizeScoreInput(input, true);
                const score = Number(value || 0);
                return Number.isFinite(score) ? Math.max(0, Math.floor(score)) : 0;
            }

            function setScoreInput(input, value) {
                if (!input) return;

                const score = Number(value || 0);
                input.value = String(Number.isFinite(score) ? Math.max(0, Math.floor(score)) : 0);
                input.dispatchEvent(new Event("input", { bubbles: true }));
            }

            function getInlineScorePayload() {
                const note = ($id("inlineScoreNote")?.value || "").trim();
                const isCompleted = !!$id("inlineIsCompleted")?.checked;

                return {
                    scoreTeam1: readScoreInput($id("inlineScore1")),
                    scoreTeam2: readScoreInput($id("inlineScore2")),
                    isCompleted,
                    note: note || null
                };
            }

            function captureInlineScoreState() {
                if (!$id("inlineScoreForm")) return null;
                const payload = getInlineScorePayload();
                return {
                    scoreTeam1: payload.scoreTeam1,
                    scoreTeam2: payload.scoreTeam2,
                    isCompleted: payload.isCompleted,
                    note: payload.note || null
                };
            }

            function isInlineScoreDirty() {
                if (!ACTIVE_MATCH_ID || !INLINE_SCORE_BASELINE || !$id("inlineScoreForm")) return false;
                const current = captureInlineScoreState();
                return current.scoreTeam1 !== INLINE_SCORE_BASELINE.scoreTeam1
                    || current.scoreTeam2 !== INLINE_SCORE_BASELINE.scoreTeam2
                    || current.isCompleted !== INLINE_SCORE_BASELINE.isCompleted
                    || current.note !== INLINE_SCORE_BASELINE.note;
            }

            function setInlineScoreSaving(form, isSaving, triggerButton = null, showTriggerSpinner = true, showSubmitSpinner = true) {
                const submitButton = $id("btnInlineSubmit");
                const stepButtons = form ? Array.from(form.querySelectorAll("[data-score-target]")) : [];
                const controlsBusy = isSaving || RECOVERY_BUSY;

                if (form) {
                    form.classList.toggle("is-saving", isSaving && !RECOVERY_BUSY);
                    form.setAttribute("aria-busy", controlsBusy ? "true" : "false");
                    form.querySelectorAll("input, select").forEach(control => {
                        control.disabled = controlsBusy;
                    });
                }

                if (submitButton) {
                    submitButton.disabled = controlsBusy;

                    if (RECOVERY_BUSY) {
                        submitButton.innerHTML = `<i class="fas fa-sync-alt fa-spin"></i> Đang đồng bộ...`;
                    } else if (showSubmitSpinner) {
                        submitButton.innerHTML = isSaving
                            ? `<i class="fas fa-spinner fa-spin"></i> Đang lưu...`
                            : `<i class="fas fa-save"></i> Lưu điểm cho trận này`;
                    }
                }

                stepButtons.forEach(button => {
                    button.disabled = controlsBusy;
                });

                if (!triggerButton || !showTriggerSpinner) return;

                if (isSaving) {
                    triggerButton.dataset.originalHtml = triggerButton.innerHTML;
                    triggerButton.innerHTML = `<i class="fas fa-spinner fa-spin"></i>`;
                } else if (triggerButton.dataset.originalHtml) {
                    triggerButton.innerHTML = triggerButton.dataset.originalHtml;
                    delete triggerButton.dataset.originalHtml;
                }
            }

            function setRecoveryControls(isRecovering) {
                const form = $id("inlineScoreForm");
                const overlayContent = $id("overlayContent");

                if (overlayContent) {
                    overlayContent.setAttribute("aria-busy", isRecovering ? "true" : "false");
                }

                if (!form) return;

                form.querySelectorAll("input, select").forEach(control => {
                    control.disabled = isRecovering;
                });

                setInlineScoreSaving(form, SCORE_SAVE_BUSY, null, false, true);

                if (isRecovering) {
                    setScoreSaveStatus("Đang đồng bộ lại dữ liệu trận đấu…", "saving");
                }
            }

            function applyScoreSaveResult(matchId, data) {
                const idx = (CACHE.items || []).findIndex(x => x.matchId === matchId);
                if (idx < 0) return;

                CACHE.items[idx].scoreTeam1 = data.scoreTeam1;
                CACHE.items[idx].scoreTeam2 = data.scoreTeam2;
                CACHE.items[idx].isCompleted = data.isCompleted;
                CACHE.items[idx].winnerRegistrationId = data.winnerRegistrationId;
                CACHE.items[idx].winnerTeam = data.winnerTeam;

                if (!Array.isArray(CACHE.items[idx].scoreHistories)) {
                    CACHE.items[idx].scoreHistories = [];
                }

                CACHE.items[idx].scoreHistories.unshift(data.history);
            }

            function applyRealtimeScoreResult(payload) {
                const matchId = Number(payload?.matchId || payload?.MatchId || 0);
                const idx = (CACHE.items || []).findIndex(x => Number(x.matchId) === matchId);
                if (idx < 0) return false;

                CACHE.items[idx].scoreTeam1 = Number(payload?.scoreTeam1 ?? payload?.ScoreTeam1 ?? 0);
                CACHE.items[idx].scoreTeam2 = Number(payload?.scoreTeam2 ?? payload?.ScoreTeam2 ?? 0);
                CACHE.items[idx].isCompleted = !!(payload?.isCompleted ?? payload?.IsCompleted);
                CACHE.items[idx].winnerRegistrationId = payload?.winnerRegistrationId ?? payload?.WinnerRegistrationId ?? null;
                CACHE.items[idx].winnerTeam = payload?.winnerTeam ?? payload?.WinnerTeam ?? null;
                CACHE.items[idx].updatedAt = payload?.updatedAt ?? payload?.UpdatedAt ?? CACHE.items[idx].updatedAt;
                SCORE_DATA_REVISION++;
                return true;
            }

            function syncInlineScoreView(data) {
                const scoreTeam1 = Number(data.scoreTeam1 || 0);
                const scoreTeam2 = Number(data.scoreTeam2 || 0);
                const score1Input = $id("inlineScore1");
                const score2Input = $id("inlineScore2");
                const liveScore1 = document.querySelector("#overlayContent [data-live-score='team1']");
                const liveScore2 = document.querySelector("#overlayContent [data-live-score='team2']");

                if (score1Input) {
                    score1Input.value = String(scoreTeam1);
                }

                if (score2Input) {
                    score2Input.value = String(scoreTeam2);
                }

                if (liveScore1) {
                    liveScore1.textContent = String(scoreTeam1);
                }

                if (liveScore2) {
                    liveScore2.textContent = String(scoreTeam2);
                }
            }

            function setScoreSaveStatus(message, type = "idle") {
                const status = $id("scoreSaveStatus");
                if (!status) return;

                const icon = type === "error"
                    ? "fa-exclamation-circle"
                    : type === "saving"
                        ? "fa-spinner fa-spin"
                        : type === "dirty"
                            ? "fa-pen"
                            : "fa-check-circle";

                status.className = `score-save-status ${type}`;
                status.innerHTML = `<i class="fas ${icon}" aria-hidden="true"></i><span></span>`;
                status.querySelector("span").textContent = message;
            }

            function showScoreToast(message, type = "success", durationMs = 1400) {
                const toast = $id("scoreToast");
                if (!toast) return;

                window.clearTimeout(SCORE_TOAST_TIMER);
                SCORE_TOAST_TIMER = null;
                toast.className = `score-toast ${type}`;
                const icon = type === "error"
                    ? "fa-exclamation-circle"
                    : type === "info"
                        ? "fa-sync-alt"
                        : "fa-check-circle";
                toast.innerHTML = `<i class="fas ${icon}" aria-hidden="true"></i><span></span>`;
                toast.querySelector("span").textContent = message;

                window.requestAnimationFrame(() => toast.classList.add("show"));

                if (durationMs > 0) {
                    SCORE_TOAST_TIMER = window.setTimeout(() => {
                        toast.classList.remove("show");
                        SCORE_TOAST_TIMER = null;
                    }, durationMs);
                }
            }

            function getResponseContentType(response) {
                return String(response?.headers?.["content-type"] || "").toLowerCase();
            }

            function isLoginHtmlResponse(response) {
                const responseUrl = String(response?.request?.responseURL || "").toLowerCase();
                const textBody = typeof response?.data === "string"
                    ? response.data.trim().toLowerCase()
                    : "";
                return responseUrl.includes("/refereeportal/login")
                    || getResponseContentType(response).includes("text/html")
                    || textBody.startsWith("<!doctype html")
                    || textBody.startsWith("<html");
            }

            function isValidScoreResponse(response, matchId) {
                const data = response?.data;
                return !isLoginHtmlResponse(response)
                    && data != null
                    && typeof data === "object"
                    && Number(data.matchId) === Number(matchId)
                    && Number.isFinite(Number(data.scoreTeam1))
                    && Number.isFinite(Number(data.scoreTeam2))
                    && typeof data.isCompleted === "boolean"
                    && data.history != null
                    && typeof data.history === "object";
            }

            function isValidMatchesResponse(response) {
                return !isLoginHtmlResponse(response)
                    && response?.data != null
                    && typeof response.data === "object"
                    && Array.isArray(response.data.items);
            }

            function createInvalidApiResponseError(response) {
                const error = new Error("Phản hồi từ máy chủ không đúng định dạng.");
                error.code = "INVALID_API_RESPONSE";
                error.response = response;
                return error;
            }

            function getApiFailure(error) {
                const status = Number(error?.response?.status || 0);
                const serverMessage = typeof error?.response?.data?.message === "string"
                    ? error.response.data.message
                    : null;

                if (status === 401 || status === 403 || isLoginHtmlResponse(error?.response)) {
                    return {
                        kind: "auth",
                        message: status === 403
                            ? "Tài khoản không còn quyền chấm điểm."
                            : "Phiên đăng nhập đã hết hạn.",
                        shouldResync: false
                    };
                }

                if (error?.code === "ECONNABORTED" || error?.code === "ETIMEDOUT") {
                    return {
                        kind: "timeout",
                        message: "Lưu điểm quá thời gian chờ. Đang kiểm tra lại tỷ số từ máy chủ.",
                        shouldResync: true
                    };
                }

                if (error?.code === "ERR_CANCELED" || axios.isCancel?.(error)) {
                    return {
                        kind: "cancelled",
                        message: "Yêu cầu cũ đã được hủy để đồng bộ lại dữ liệu.",
                        shouldResync: true
                    };
                }

                if (navigator.onLine === false || !error?.response) {
                    return {
                        kind: navigator.onLine === false ? "offline" : "network",
                        message: navigator.onLine === false
                            ? "Thiết bị đang mất kết nối mạng."
                            : "Không thể kết nối máy chủ. Đang kiểm tra lại tỷ số.",
                        shouldResync: navigator.onLine !== false
                    };
                }

                if (error?.code === "INVALID_API_RESPONSE") {
                    return {
                        kind: "invalid-response",
                        message: "Máy chủ trả về dữ liệu không hợp lệ. Đang đồng bộ lại tỷ số.",
                        shouldResync: true
                    };
                }

                if (status >= 500) {
                    return {
                        kind: "server",
                        message: serverMessage || "Máy chủ chưa thể xác nhận lần lưu điểm này.",
                        shouldResync: true
                    };
                }

                return {
                    kind: "business",
                    message: serverMessage || error?.message || "Chấm điểm thất bại.",
                    shouldResync: false
                };
            }

            function redirectToRefereeLogin(message = "Phiên đăng nhập đã hết hạn.") {
                if (AUTH_REDIRECTING) return;

                AUTH_REDIRECTING = true;
                showScoreToast(message, "error", 0);

                const returnUrl = `${window.location.pathname}${window.location.search}`;
                const loginUrl = `/RefereePortal/Login?returnUrl=${encodeURIComponent(returnUrl)}`;
                window.setTimeout(() => window.location.assign(loginUrl), 250);
            }

            function finishScoreRequest(request) {
                if (ACTIVE_SCORE_REQUEST !== request) return;

                ACTIVE_SCORE_REQUEST = null;
                SCORE_SAVE_BUSY = false;
                setInlineScoreSaving(
                    request.form,
                    false,
                    request.triggerButton,
                    request.triggerSpinner,
                    request.submitSpinner);

                if (PENDING_REALTIME_SYNC) {
                    PENDING_REALTIME_SYNC = false;
                    scheduleRealtimeSync();
                }
            }

            function abortActiveScoreRequestForRecovery() {
                const request = ACTIVE_SCORE_REQUEST;
                if (!request) return false;

                request.cancelledForRecovery = true;

                try {
                    request.controller?.abort();
                } catch {
                    // The recovery flow below still releases the local UI lock.
                }

                finishScoreRequest(request);
                return true;
            }

            function showInlineScoreError(message) {
                const errBox = $id("inlineScoreErr");
                if (!errBox) return;

                errBox.textContent = message || "Chấm điểm thất bại.";
                errBox.classList.remove("d-none");
                [$id("inlineScore1"), $id("inlineScore2")].filter(Boolean).forEach(input => {
                    input.setAttribute("aria-invalid", "true");
                });
                setScoreSaveStatus(message || "Chấm điểm thất bại.", "error");
            }

            async function saveInlineScore(form, options = {}) {
                if (SCORE_SAVE_BUSY || RECOVERY_BUSY || AUTH_REDIRECTING || !ACTIVE_MATCH_ID) {
                    return false;
                }

                if (RECOVERY_REQUIRED) {
                    await recoverPageState("before-save", { force: true });
                    return false;
                }

                if (navigator.onLine === false) {
                    RECOVERY_REQUIRED = true;
                    showInlineScoreError("Thiết bị đang mất kết nối mạng. Vui lòng chờ kết nối được khôi phục.");
                    showScoreToast("Thiết bị đang mất kết nối mạng", "error", 2600);
                    return false;
                }

                const triggerButton = options.triggerButton || null;
                const refreshOverlay = options.refreshOverlay !== false;
                const showToast = !!options.showToast;
                const triggerSpinner = options.triggerSpinner !== false;
                const submitSpinner = options.submitSpinner !== false;
                const matchId = ACTIVE_MATCH_ID;
                const errBox = $id("inlineScoreErr");
                const payload = getInlineScorePayload();
                const controller = typeof AbortController === "function"
                    ? new AbortController()
                    : null;
                const request = {
                    controller,
                    form,
                    triggerButton,
                    triggerSpinner,
                    submitSpinner,
                    cancelledForRecovery: false
                };
                let saved = false;
                let failure = null;

                if (errBox) {
                    errBox.classList.add("d-none");
                    errBox.textContent = "";
                }

                [$id("inlineScore1"), $id("inlineScore2")].filter(Boolean).forEach(input => {
                    input.removeAttribute("aria-invalid");
                });

                ACTIVE_SCORE_REQUEST = request;
                SCORE_SAVE_BUSY = true;
                SCORE_DATA_REVISION++;
                setInlineScoreSaving(form, true, triggerButton, triggerSpinner, submitSpinner);
                setScoreSaveStatus(`Đang lưu tỷ số ${payload.scoreTeam1}–${payload.scoreTeam2}…`, "saving");

                try {
                    const requestConfig = {
                        timeout: SAVE_REQUEST_TIMEOUT_MS,
                        headers: { Accept: "application/json" }
                    };

                    if (controller) {
                        requestConfig.signal = controller.signal;
                    }
                    // The form already provides inline save status and locks concurrent writes.
                    requestConfig.hanakaLoading = "silent";

                    const res = await axios.put(`${API}/${matchId}/score`, payload, requestConfig);
                    if (request.cancelledForRecovery || ACTIVE_SCORE_REQUEST !== request) {
                        return false;
                    }

                    if (!isValidScoreResponse(res, matchId)) {
                        throw createInvalidApiResponseError(res);
                    }

                    applyScoreSaveResult(matchId, res.data);

                    if (refreshOverlay) {
                        render();

                        if (ACTIVE_MATCH_ID === matchId) {
                            openOverlay(matchId, { syncUrl: false, focusTitle: false, incremental: true });
                        }
                    } else {
                        if (ACTIVE_MATCH_ID === matchId) {
                            updateOpenMatchScore(getMatch(matchId));
                        }
                        REFRESH_CARDS_ON_CLOSE = true;

                        if (showToast) {
                            showScoreToast("Đã lưu điểm");
                        }
                    }

                    if (ACTIVE_MATCH_ID === matchId) {
                        INLINE_SCORE_BASELINE = captureInlineScoreState();
                    }
                    setScoreSaveStatus(`Đã lưu tỷ số ${Number(res.data.scoreTeam1 || 0)}–${Number(res.data.scoreTeam2 || 0)}`, "success");

                    saved = true;
                } catch (err) {
                    if (!request.cancelledForRecovery) {
                        failure = getApiFailure(err);

                        if (failure.kind === "auth") {
                            redirectToRefereeLogin(failure.message);
                        } else {
                            showInlineScoreError(failure.message);
                            showScoreToast(failure.message, "error", 3200);
                        }
                    }
                } finally {
                    finishScoreRequest(request);
                }

                if (!saved && failure?.shouldResync && !AUTH_REDIRECTING) {
                    await recoverPageState("save-failed", { force: true });
                }

                return saved;
            }

            function shouldConfirmEndMatch() {
                const match = getMatch(ACTIVE_MATCH_ID);
                const checkbox = $id("inlineIsCompleted");

                return !!checkbox?.checked && !match?.isCompleted;
            }

            function populateEndMatchConfirm() {
                const match = getMatch(ACTIVE_MATCH_ID);
                if (!match) return;

                const scoreTeam1 = readScoreInput($id("inlineScore1"));
                const scoreTeam2 = readScoreInput($id("inlineScore2"));
                $id("endMatchConfirmMatch").textContent = `Trận #${match.matchId}`;
                $id("endMatchConfirmTeams").textContent = `${match.team1Text}  —  ${match.team2Text}`;
                $id("endMatchConfirmScore").textContent = `${scoreTeam1} – ${scoreTeam2}`;
            }

            function setEndMatchConfirmVisible(isVisible) {
                const modal = $id("endMatchConfirm");
                if (!modal) return;

                modal.classList.toggle("show", isVisible);
                modal.setAttribute("aria-hidden", isVisible ? "false" : "true");

                if (isVisible) {
                    END_MATCH_CONFIRM_TRIGGER = document.activeElement instanceof HTMLElement
                        ? document.activeElement
                        : null;
                    populateEndMatchConfirm();
                    window.setTimeout(() => $id("btnEndMatchCancel")?.focus(), 0);
                    return;
                }

                const trigger = END_MATCH_CONFIRM_TRIGGER;
                END_MATCH_CONFIRM_TRIGGER = null;
                if (trigger?.isConnected) {
                    window.setTimeout(() => trigger.focus({ preventScroll: true }), 0);
                }
            }

            function resolveEndMatchConfirm(result) {
                if (!END_MATCH_CONFIRM_RESOLVE) return;

                const resolve = END_MATCH_CONFIRM_RESOLVE;
                END_MATCH_CONFIRM_RESOLVE = null;
                setEndMatchConfirmVisible(false);
                resolve(result);
            }

            function confirmEndMatch() {
                if (END_MATCH_CONFIRM_RESOLVE) {
                    resolveEndMatchConfirm(false);
                }

                setEndMatchConfirmVisible(true);

                return new Promise(resolve => {
                    END_MATCH_CONFIRM_RESOLVE = resolve;
                });
            }

            function bindEndMatchConfirm() {
                const modal = $id("endMatchConfirm");
                const cancelButton = $id("btnEndMatchCancel");
                const confirmButton = $id("btnEndMatchConfirm");
                if (!modal || !cancelButton || !confirmButton) return;

                cancelButton.addEventListener("click", () => resolveEndMatchConfirm(false));
                confirmButton.addEventListener("click", () => resolveEndMatchConfirm(true));

                modal.addEventListener("click", (event) => {
                    if (event.target === modal) {
                        resolveEndMatchConfirm(false);
                    }
                });

                modal.addEventListener("keydown", event => {
                    if (event.key !== "Tab") return;

                    const focusable = Array.from(modal.querySelectorAll(
                        "button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex='-1'])"));
                    if (!focusable.length) return;

                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                });
            }

            function bindScoreInputs(form) {
                const scoreInputs = [$id("inlineScore1"), $id("inlineScore2")].filter(Boolean);

                scoreInputs.forEach(input => {
                    input.addEventListener("input", () => {
                        normalizeScoreInput(input);
                        if (!SCORE_SAVE_BUSY && !RECOVERY_BUSY) {
                            setScoreSaveStatus("Điểm đã thay đổi. Bấm Lưu điểm để cập nhật.", "dirty");
                        }
                    });
                    input.addEventListener("blur", () => normalizeScoreInput(input, true));
                    input.addEventListener("focus", () => {
                        window.setTimeout(() => input.select?.(), 0);
                    });
                });

                form.querySelectorAll("[data-score-target]").forEach(button => {
                    button.addEventListener("click", async (event) => {
                        event.preventDefault();

                        const input = $id(button.dataset.scoreTarget);
                        const step = Number(button.dataset.scoreStep || 1);
                        const currentScore = readScoreInput(input);
                        const nextScore = Math.max(0, currentScore + step);

                        if (nextScore === currentScore && step < 0) return;

                        setScoreInput(input, nextScore);

                        if (shouldConfirmEndMatch()) {
                            const confirmed = await confirmEndMatch();
                            if (!confirmed) {
                                setScoreInput(input, currentScore);
                                setScoreSaveStatus("Chưa kết thúc trận. Kiểm tra tỷ số rồi bấm Lưu điểm để xác nhận.", "dirty");
                                return;
                            }
                        }

                        const saved = await saveInlineScore(form, {
                            triggerButton: button,
                            refreshOverlay: false,
                            showToast: false,
                            triggerSpinner: false,
                            submitSpinner: false
                        });

                        if (!saved) {
                            setScoreInput(input, currentScore);
                            const errorMessage = $id("inlineScoreErr")?.textContent;
                            if (errorMessage) {
                                setScoreSaveStatus(errorMessage, "error");
                            }
                        }
                    });
                });
            }

            function bindInlineScoreForm() {
                const form = $id("inlineScoreForm");
                if (!form || !ACTIVE_MATCH_ID) return;

                bindScoreInputs(form);

                [$id("inlineScoreNote"), $id("inlineIsCompleted")].filter(Boolean).forEach(control => {
                    control.addEventListener("change", () => {
                        if (!SCORE_SAVE_BUSY && !RECOVERY_BUSY) {
                            setScoreSaveStatus("Thay đổi chưa được lưu. Bấm Lưu điểm để cập nhật.", "dirty");
                        }
                    });
                });

                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    if (shouldConfirmEndMatch()) {
                        const confirmed = await confirmEndMatch();
                        if (!confirmed) return;
                    }

                    await saveInlineScore(form);
                });
            }

            async function loadMe() {
                try {
                    const res = await axios.get("/api/referee-auth/me", {
                        timeout: READ_REQUEST_TIMEOUT_MS,
                        headers: { Accept: "application/json" }
                    });

                    if (isLoginHtmlResponse(res) || res?.data == null || typeof res.data !== "object") {
                        throw createInvalidApiResponseError(res);
                    }

                    $id("meBox").textContent = res.data?.fullName || "";
                    return true;
                } catch (err) {
                    const failure = getApiFailure(err);
                    $id("meBox").textContent = "";

                    if (failure.kind === "auth") {
                        redirectToRefereeLogin(failure.message);
                    }

                    return false;
                }
            }

            function restoreActiveMatchAfterLoad(matchId, noteDraft, replaceUrl, incremental = false) {
                if (!matchId) return;

                if (!getMatch(matchId)) {
                    if ($id("matchOverlay").classList.contains("show")) {
                        closeOverlay({ syncUrl: false });
                    }

                    showErr("Không tìm thấy trận đấu này trong danh sách được phân công.");
                    setMatchesListUrl();
                    return;
                }

                openOverlay(matchId, {
                    syncUrl: !ACTIVE_MATCH_ID,
                    replaceUrl,
                    incremental
                });

                const noteSelect = $id("inlineScoreNote");
                if (noteSelect && noteDraft && Array.from(noteSelect.options).some(x => x.value === noteDraft)) {
                    noteSelect.value = noteDraft;
                }
            }

            async function loadMatches(options = {}) {
                const loadSequence = ++MATCH_LIST_LOAD_SEQUENCE;
                const scoreRevision = SCORE_DATA_REVISION;

                if (!options.keepExistingError) {
                    hideErr();
                }

                try {
                    const res = await axios.get(API, {
                        timeout: READ_REQUEST_TIMEOUT_MS,
                        headers: { Accept: "application/json" },
                        hanakaLoading: options.silent ? "silent" : undefined
                    });

                    if (!isValidMatchesResponse(res)) {
                        throw createInvalidApiResponseError(res);
                    }

                    if (loadSequence !== MATCH_LIST_LOAD_SEQUENCE) return false;
                    if (options.realtime && (scoreRevision !== SCORE_DATA_REVISION || realtimeSyncWouldOverwriteInput())) {
                        PENDING_REALTIME_SYNC = true;
                        if (!realtimeSyncWouldOverwriteInput()) {
                            PENDING_REALTIME_SYNC = false;
                            scheduleRealtimeSync();
                        }
                        return false;
                    }

                    const activeMatchId = ACTIVE_MATCH_ID || getMatchIdFromUrl();
                    const noteDraft = ($id("inlineScoreNote")?.value || "").trim();
                    CACHE.items = res.data.items;
                    syncRealtimeTournamentSubscriptions();
                    RECOVERY_REQUIRED = false;
                    render();
                    restoreActiveMatchAfterLoad(activeMatchId, noteDraft, options.replaceUrl === true, options.realtime === true);
                    return true;
                } catch (err) {
                    if (loadSequence !== MATCH_LIST_LOAD_SEQUENCE) return false;
                    const failure = getApiFailure(err);
                    $id("cards")?.setAttribute("aria-busy", "false");

                    if (failure.kind === "auth") {
                        redirectToRefereeLogin(failure.message);
                        return false;
                    }

                    RECOVERY_REQUIRED = true;

                    const message = failure.kind === "timeout"
                        ? "Tải dữ liệu quá thời gian chờ. Vui lòng kiểm tra kết nối và thử lại."
                        : failure.message || "Tải dữ liệu thất bại.";

                    showErr(message);
                    showScoreToast(message, "error", 3200);

                    if (!(CACHE.items || []).length) {
                        $id("cards").innerHTML = `
                            <div class="empty-box">
                                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                                <strong>Chưa tải được danh sách trận</strong>
                                <span>${esc(message)}</span>
                            </div>`;
                    }
                    return false;
                }
            }

            function syncRealtimeTournamentSubscriptions() {
                const realtime = window.HanakaPublicRealtime;
                if (!realtime) return;

                const nextIds = new Set((CACHE.items || [])
                    .map(item => Number(item.tournamentId || 0))
                    .filter(id => Number.isFinite(id) && id > 0));

                REALTIME_TOURNAMENT_IDS.forEach(id => {
                    if (!nextIds.has(id)) {
                        realtime.unsubscribeTournament(id);
                        REALTIME_TOURNAMENT_IDS.delete(id);
                    }
                });

                nextIds.forEach(id => {
                    if (!REALTIME_TOURNAMENT_IDS.has(id)) {
                        REALTIME_TOURNAMENT_IDS.add(id);
                        realtime.subscribeTournament(id);
                    }
                });
            }

            function realtimeSyncWouldOverwriteInput() {
                return SCORE_SAVE_BUSY
                    || RECOVERY_BUSY
                    || isInlineScoreDirty()
                    || $id("endMatchConfirm")?.classList.contains("show");
            }

            function scheduleRealtimeSync() {
                if (AUTH_REDIRECTING) return;
                if (realtimeSyncWouldOverwriteInput()) {
                    PENDING_REALTIME_SYNC = true;
                    return;
                }

                window.clearTimeout(REALTIME_SYNC_TIMER);
                REALTIME_SYNC_TIMER = window.setTimeout(() => {
                    REALTIME_SYNC_TIMER = null;
                    if (realtimeSyncWouldOverwriteInput()) {
                        PENDING_REALTIME_SYNC = true;
                        return;
                    }
                    loadMatches({ keepExistingError: true, replaceUrl: false, silent: true, realtime: true });
                }, 180);
            }

            function initRealtime() {
                const realtime = window.HanakaPublicRealtime;
                if (!realtime) return;

                REMOVE_REALTIME_LISTENER = realtime.on(event => {
                    const type = String(event?.type || "");
                    if (type === "__public_socket_open__" && event?.reconnected) {
                        scheduleRealtimeSync();
                        return;
                    }

                    const payload = event?.payload || {};
                    const tournamentId = Number(payload.tournamentId || payload.TournamentId || 0);
                    if (!REALTIME_TOURNAMENT_IDS.has(tournamentId)) return;

                    if (type === "tournament.match.score.updated") {
                        const matchId = Number(payload.matchId || payload.MatchId || 0);
                        if (ACTIVE_MATCH_ID === matchId && realtimeSyncWouldOverwriteInput()) {
                            PENDING_REALTIME_SYNC = true;
                            if (!SCORE_SAVE_BUSY) {
                                setScoreSaveStatus(
                                    "Tỷ số vừa được cập nhật ở phiên khác. Dữ liệu đang nhập được giữ nguyên; đóng trận để đồng bộ.",
                                    "dirty");
                            }
                            return;
                        }

                        if (applyRealtimeScoreResult(payload)) {
                            render();
                            if (ACTIVE_MATCH_ID === matchId) {
                                openOverlay(matchId, { syncUrl: false, focusTitle: false, incremental: true });
                            }
                        }
                        scheduleRealtimeSync();
                    } else if (type === "tournament.bracket.updated") {
                        scheduleRealtimeSync();
                    }
                });

                window.addEventListener("pagehide", event => {
                    if (event.persisted) return;
                    window.clearTimeout(REALTIME_SYNC_TIMER);
                    REMOVE_REALTIME_LISTENER?.();
                    REMOVE_REALTIME_LISTENER = null;
                    REALTIME_TOURNAMENT_IDS.forEach(id => realtime.unsubscribeTournament(id));
                    REALTIME_TOURNAMENT_IDS.clear();
                }, { once: true });
            }

            async function recoverPageState(reason, options = {}) {
                if (AUTH_REDIRECTING || RECOVERY_BUSY) return false;

                if (navigator.onLine === false) {
                    RECOVERY_REQUIRED = true;
                    showInlineScoreError("Thiết bị đang mất kết nối mạng. Dữ liệu sẽ được đồng bộ khi có mạng trở lại.");
                    showScoreToast("Thiết bị đang mất kết nối mạng", "error", 0);
                    return false;
                }

                RECOVERY_REQUIRED = true;
                RECOVERY_BUSY = true;
                const hadPendingSave = abortActiveScoreRequestForRecovery();
                setRecoveryControls(true);
                showScoreToast("Đang đồng bộ lại dữ liệu trận đấu...", "info", 0);

                let synced = false;
                try {
                    synced = await loadMatches({
                        keepExistingError: false,
                        replaceUrl: false,
                        recoveryReason: reason,
                        force: options.force === true
                    });

                    return synced;
                } finally {
                    RECOVERY_BUSY = false;
                    setRecoveryControls(false);

                    if (synced) {
                        RECOVERY_REQUIRED = false;
                        const syncedMatch = getMatch(ACTIVE_MATCH_ID);
                        if (syncedMatch) {
                            setScoreSaveStatus(
                                `Đã đồng bộ tỷ số ${Number(syncedMatch.scoreTeam1 || 0)}–${Number(syncedMatch.scoreTeam2 || 0)}`,
                                "success");
                        }
                        showScoreToast(
                            hadPendingSave
                                ? "Đã kiểm tra lại tỷ số sau yêu cầu bị gián đoạn"
                                : "Dữ liệu trận đấu đã được đồng bộ",
                            "success",
                            2200);
                    }
                }
            }

            function schedulePageRecovery(reason, force = false) {
                if (AUTH_REDIRECTING) return;

                if (document.hidden) {
                    RECOVERY_REQUIRED = RECOVERY_REQUIRED || force || !!ACTIVE_SCORE_REQUEST;
                    return;
                }

                const mustRecover = force || RECOVERY_REQUIRED || !!ACTIVE_SCORE_REQUEST;
                if (!mustRecover) return;

                window.clearTimeout(RECOVERY_TIMER);
                RECOVERY_TIMER = window.setTimeout(() => {
                    RECOVERY_TIMER = null;
                    recoverPageState(reason, { force: mustRecover });
                }, RESUME_DEBOUNCE_MS);
            }

            function handleBrowserOffline() {
                window.clearTimeout(RECOVERY_TIMER);
                RECOVERY_TIMER = null;
                RECOVERY_REQUIRED = true;
                abortActiveScoreRequestForRecovery();
                showInlineScoreError("Thiết bị đang mất kết nối mạng. Dữ liệu sẽ được đồng bộ khi có mạng trở lại.");
                showScoreToast("Thiết bị đang mất kết nối mạng", "error", 0);
            }

            function bindRecoveryLifecycle() {
                document.addEventListener("visibilitychange", () => {
                    const now = Date.now();

                    if (document.hidden) {
                        PAGE_HIDDEN_AT = now;
                        LAST_PAGE_ACTIVE_AT = now;
                        return;
                    }

                    const idleMs = PAGE_HIDDEN_AT ? now - PAGE_HIDDEN_AT : 0;
                    PAGE_HIDDEN_AT = null;
                    LAST_PAGE_ACTIVE_AT = now;
                    schedulePageRecovery(
                        "visibility",
                        RECOVERY_REQUIRED || idleMs >= RESUME_IDLE_THRESHOLD_MS || !!ACTIVE_SCORE_REQUEST);
                });

                window.addEventListener("blur", () => {
                    LAST_PAGE_ACTIVE_AT = Date.now();
                });

                window.addEventListener("focus", () => {
                    const now = Date.now();
                    const idleMs = now - LAST_PAGE_ACTIVE_AT;
                    LAST_PAGE_ACTIVE_AT = now;
                    schedulePageRecovery("focus", idleMs >= RESUME_IDLE_THRESHOLD_MS || !!ACTIVE_SCORE_REQUEST);
                });

                window.addEventListener("pageshow", event => {
                    const now = Date.now();
                    const idleMs = now - LAST_PAGE_ACTIVE_AT;
                    LAST_PAGE_ACTIVE_AT = now;
                    schedulePageRecovery("pageshow", event.persisted || idleMs >= RESUME_IDLE_THRESHOLD_MS || !!ACTIVE_SCORE_REQUEST);
                });

                window.addEventListener("offline", handleBrowserOffline);
                window.addEventListener("online", () => schedulePageRecovery("online", true));
            }

            function openSearchPopover() {
                const topbar = document.querySelector(".topbar");
                const button = $id("btnSearchToggle");
                const input = $id("matchSearchInput");
                if (!topbar || !button || !input) return;

                topbar.classList.add("search-open");
                button.setAttribute("aria-expanded", "true");

                window.setTimeout(() => {
                    try {
                        input.focus({ preventScroll: true });
                    } catch {
                        input.focus();
                    }
                    input.select?.();
                }, 0);
            }

            function closeSearchPopover() {
                const topbar = document.querySelector(".topbar");
                const button = $id("btnSearchToggle");
                if (!topbar || !button) return;

                topbar.classList.remove("search-open");
                button.setAttribute("aria-expanded", "false");
            }

            function clearSearch() {
                SEARCH_QUERY = "";

                const input = $id("matchSearchInput");
                if (input) {
                    input.value = "";
                }

                render();
            }

            function bindMatchSearch() {
                const topbar = document.querySelector(".topbar");
                const toggle = $id("btnSearchToggle");
                const input = $id("matchSearchInput");
                const clearButton = $id("btnSearchClear");
                if (!topbar || !toggle || !input || !clearButton) return;

                toggle.addEventListener("click", (event) => {
                    event.stopPropagation();

                    if (topbar.classList.contains("search-open")) {
                        closeSearchPopover();
                    } else {
                        openSearchPopover();
                    }
                });

                input.addEventListener("input", () => {
                    SEARCH_QUERY = input.value || "";
                    render();
                });

                input.addEventListener("keydown", (event) => {
                    if (event.key !== "Escape") return;

                    if (SEARCH_QUERY.trim()) {
                        clearSearch();
                    } else {
                        closeSearchPopover();
                    }
                });

                clearButton.addEventListener("click", () => {
                    clearSearch();
                    try {
                        input.focus({ preventScroll: true });
                    } catch {
                        input.focus();
                    }
                });

                document.addEventListener("click", (event) => {
                    if (!topbar.classList.contains("search-open")) return;
                    if (topbar.contains(event.target)) return;

                    closeSearchPopover();
                });
            }

            window.openMatchDetail = (matchId) => {
                openOverlay(matchId);
            };

            $id("btnCloseOverlay").addEventListener("click", closeOverlay);

            $id("matchOverlay").addEventListener("click", (e) => {
                if (e.target.id === "matchOverlay") {
                    closeOverlay();
                }
            });

            document.addEventListener("keydown", (e) => {
                const endModalOpen = $id("endMatchConfirm")?.classList.contains("show");
                const overlayOpen = $id("matchOverlay")?.classList.contains("show");

                if (e.key === "Tab" && overlayOpen && !endModalOpen) {
                    const focusable = Array.from($id("matchOverlay").querySelectorAll(
                        "button:not([disabled]), input:not([disabled]), select:not([disabled]), summary, [tabindex]:not([tabindex='-1'])"))
                        .filter(element => element.offsetParent !== null);

                    if (focusable.length) {
                        const first = focusable[0];
                        const last = focusable[focusable.length - 1];
                        if (e.shiftKey && document.activeElement === first) {
                            e.preventDefault();
                            last.focus();
                        } else if (!e.shiftKey && document.activeElement === last) {
                            e.preventDefault();
                            first.focus();
                        }
                    }
                }

                if (e.key === "Escape" && endModalOpen) {
                    resolveEndMatchConfirm(false);
                    return;
                }

                if (e.key === "Escape" && overlayOpen) {
                    closeOverlay();
                }
            });

            window.addEventListener("popstate", () => {
                const matchId = getMatchIdFromUrl();

                if (matchId && getMatch(matchId)) {
                    openOverlay(matchId, { syncUrl: false });
                    return;
                }

                if ($id("matchOverlay").classList.contains("show")) {
                    closeOverlay({ syncUrl: false });
                }
            });

            $id("btnLogout").addEventListener("click", async () => {
                await axios.post("/api/referee-auth/logout");
                window.location.href = "/RefereePortal/Login";
            });

            document.addEventListener("DOMContentLoaded", async () => {
                bindMatchSearch();
                bindEndMatchConfirm();
                bindRecoveryLifecycle();
                initRealtime();

                await loadMe();
                if (AUTH_REDIRECTING) return;

                await loadMatches({ replaceUrl: true });
            });
        })();
    </script>
</body>
</html> 
