@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phân công điều phối";
}
<main id="coordinator-admin" data-tournament-id="@ViewBag.TournamentId">
    <a href="@Url.Action("Index", "TournamentRounds", new { tournamentId = ViewBag.TournamentId })">← Vòng đấu</a>
    <h1 class="h4 mt-3">Phân công điều phối — @ViewBag.TournamentTitle</h1>
    <p>Người được phân công đăng nhập <a href="/CoordinatorPortal/Login" target="_blank" rel="noopener">trang điều phối riêng</a> để đổi sân và gọi chuẩn bị trước khi trọng tài chấm điểm. Thay đổi được cập nhật trên lịch đấu của app.</p>
    <form id="coordinator-search" class="card card-body mb-3">
        <label for="coordinator-query">User ID hoặc số điện thoại</label>
        <div class="d-flex" style="gap:8px;flex-wrap:wrap">
            <input id="coordinator-query" class="form-control" style="max-width:320px" required autocomplete="off" />
            <button class="btn btn-primary" type="submit">Tìm tài khoản</button>
        </div>
        <div id="coordinator-results" class="mt-3"></div>
    </form>
    <p id="coordinator-error" class="text-danger" role="alert"></p>
    <div class="card card-body">
        <h2 class="h5">Đang được phân công</h2>
        <div id="coordinator-list" aria-live="polite"></div>
    </div>
</main>
@section Scripts {
    <script src="~/js/admin-tournament-coordinators.js" asp-append-version="true"></script>
}
